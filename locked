#!/bin/bash -p
# locked v2 -- three-tier BSD-flag protection for user-space trust surfaces.
#
# /bin/bash, not `env bash`: sudo passes the caller's PATH through (probed
# live 2026-08-06), and env resolves the interpreter from it BEFORE the
# PATH pin below runs -- a user-writable bash would run as root. /bin/bash
# is SIP-sealed and present on every macOS, and this tool is Darwin-only.
#
# -p (privileged mode), for the same reason: before line one runs, a
# plain bash sources the file $BASH_ENV names, takes set options from
# SHELLOPTS, and imports shell functions from the environment -- a
# BASH_FUNC_exec%% variable replaces `exec` itself (verified on /bin/bash
# 3.2, 2026-10-20). -p turns all three off. sudo's env_reset strips those
# variables today, but status and why run without sudo, and the flag must
# not hang on sudo's policy. It holds only when the kernel reads this
# line: `bash locked` runs without it, so the script is always executed
# by its path. -p leaves two more alone, so the next two lines run first:
# POSIXLY_CORRECT in the environment still starts bash in posix mode
# (verified on 3.2) and BASH_COMPAT sets a compatibility level (bash 4.3
# and later), so posix mode goes off and both names go, before any other
# line and before any child inherits them.
set +o posix
unset POSIXLY_CORRECT BASH_COMPAT
#
# Tiers (see DESIGN-v2.md):
#   content    uchg,  owned by _<user>-lock; leaf files, or leaf dirs (recursive)
#   placement  uappnd, owned by _<user>-lock + an add-only ACL entry for
#              the user; group and mode unchanged; chain dirs
#   anchor     sappnd/schg, ownership UNCHANGED; nodes the OS identity-checks
#              against the user's UID (~, ~/.ssh, ...)
#
# You name what to protect (leaves); every chain directory is derived from
# them and released once no protected file needs it.
#
# Invoked via sudo; sudoers pins the binary by sha256 digest (setup writes it).
# Sudo auth (password, pam_tid, sudowhat, ...) is the user's choice.
#
#   sudo locked lock   [--flag F] [--yes] [--dry-run] <path>...
#   sudo locked unprotect [--yes] [--dry-run] <path>...
#   sudo locked unlock [--chain] [--dry-run] <path>...
#   sudo locked revert [--dry-run] <path>...
#   sudo locked rm|trash [--recursive] [--dry-run] <path>...
#   sudo locked mv|rekey [--recursive] <old> <new>
#   sudo locked tombstone [--yes] <path>...
#   locked status [<path>...]        (read-only; no sudo needed)
#   locked why <path>...             (read-only; no sudo needed)
#   sudo locked verify [--quiet]
#   sudo locked setup
#
# rm/trash/mv perform the one syscall a sealed parent blocks, inside a
# bounded root-held window opened by the compiled helper (see LOCKED_HELPER
# below) on an open parent fd. The bash trap here is a backstop only. The
# same helper reads node identity (its `id` verb), so every verb needs it --
# unprivileged `status` included.

# Pin PATH so bare command names (dscl, awk, install, chflags, ...) can't be
# hijacked even if sudoers env_keep ever leaks PATH from the invoker.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

set -euo pipefail
IFS=$'\n\t'
shopt -s nullglob

VERSION=0.16.1

# Override-friendly defaults (test seams; sudo's env_reset strips these on
# real invocations, so they are only reachable when the script is executed
# directly as root -- i.e. by the test harness).
: "${INSTALL_TARGET:=/usr/local/sbin/locked}"
# The compiled window helper. Trust is positional, not by digest: the nix
# module rewrites this default to the store path at eval (keep the exact
# `: "${VAR:=...}"` shape so its anchor assertion still matches), and
# verify_helper re-checks root ownership, mode and the whole ancestry on
# every call. As a test seam it behaves like the others -- settable when
# the script is run directly as root, dead under sudo's env_reset.
: "${LOCKED_HELPER:=/usr/local/sbin/locked-helper}"
# The git that draws every diff (see git_diff). A plain assignment, not a
# seam: root runs it on bytes the invoker wrote, so no environment may
# name another one, the harness included -- it runs a copy with this line
# rewritten. The nix module rewrites it to the store path of pkgs.git
# (keep the exact `readonly LOCKED_GIT=...` shape for its anchor), and
# verify_git checks root ownership, mode and the whole ancestry on each
# diff. The default is the real git binary of Apple's command line tools,
# never /usr/bin/git: that one is a shim which picks the git it runs from
# DEVELOPER_DIR and xcode-select state -- with Xcode installed, a git
# inside /Applications, a folder the admin group can write -- so walking
# the shim's own path would vouch for a program it does not run.
readonly LOCKED_GIT=/Library/Developer/CommandLineTools/usr/bin/git
# Everything locked keeps: one root-owned dir per user under it, holding
# that user's pool and the result of the last verify run (see the root
# convergence block below for the shape). The helper walks every path it
# reads from "/", and follows a symlink only where root alone controls it,
# as root controls /var; the staging copies it reads live under here.
: "${LOCKED_STATE_ROOT:=/var/db/locked}"
# Where 0.14.0 and earlier kept the pools. Read once, by the one-shot
# conversion in the root convergence block; nothing else looks here.
: "${LOCKED_LEGACY_ROOT:=/var/db/locked-snapshots}"
: "${LOCKED_LOCK_ACCOUNT:=}"
: "${LOCKED_USER_HOME:=}"
: "${LOCKED_VERIFY_PLIST:=/Library/LaunchDaemons/locked.verify.plist}"
# The verify timer's period. The nix module rewrites this default to its
# verifyInterval option (keep the exact `: "${VAR:=...}"` shape), so a manual
# `sudo locked verify` records the same interval the timer runs at.
: "${LOCKED_VERIFY_INTERVAL:=900}"

# ---- palette ---------------------------------------------------------------
#
# Semantic color roles (terminal-output framework): bold magenta = the one
# subject the y/N is about (a diff's file headers borrow it: they answer
# what-am-I-looking-at one level down, as in pinned), cyan = identifiers
# and commands, yellow = attention (notes, drift, aborts), green/red =
# verdict glyphs and refusals, dim = meta, bold = the decision sentence
# and structure, reverse red = a hidden character shown escaped (see
# esc_into), and nothing else.
#
# Gated PER STREAM: C_* follows stdout, E_* follows stderr, so a piped
# stdout stays byte-identical for anything parsing it while an alarm on the
# tty keeps its color -- and the other way around. NO_COLOR
# (https://no-color.org) disables both. Disabled color degrades to empty
# strings, never garbage.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OFF=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
  C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YEL=$'\033[33m'
  C_CYN=$'\033[36m' C_MAG=$'\033[35m' C_BLU=$'\033[1;34m' C_RV=$'\033[7;31m'
else
  C_OFF='' C_B='' C_DIM='' C_RED='' C_GRN='' C_YEL='' C_CYN='' C_MAG='' C_BLU='' C_RV=''
fi
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  E_OFF=$'\033[0m' E_B=$'\033[1m' E_DIM=$'\033[2m'
  E_RED=$'\033[31m' E_GRN=$'\033[32m' E_YEL=$'\033[33m'
  E_CYN=$'\033[36m' E_MAG=$'\033[35m' E_BLU=$'\033[1;34m' E_RV=$'\033[7;31m'
else
  E_OFF='' E_B='' E_DIM='' E_RED='' E_YEL='' E_GRN='' E_CYN='' E_MAG='' E_BLU='' E_RV=''
fi

# Palette for a function whose stdout the CALL SITE may redirect
# (status_row inside a block piped to stderr, cmd_rows ... >&2): testing
# fd 1 here, inside the function, sees the real destination, so one
# function serves both streams without knowing which one it is on.
set_pal() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    P_OFF=$'\033[0m' P_B=$'\033[1m' P_DIM=$'\033[2m'
    P_RED=$'\033[31m' P_GRN=$'\033[32m' P_YEL=$'\033[33m'
    P_CYN=$'\033[36m' P_MAG=$'\033[35m' P_BLU=$'\033[1;34m' P_RV=$'\033[7;31m'
  else
    P_OFF='' P_B='' P_DIM='' P_RED='' P_GRN='' P_YEL='' P_CYN='' P_MAG='' P_BLU='' P_RV=''
  fi
}
set_pal   # initialize for set -u; callers on a redirected fd re-run it

# ---- third-party text --------------------------------------------------------
#
# WHAT THE READER SEES IS THE TEXT THAT IS THERE (untrusted-text). A path
# is the user's own file name, and a name in it may hold characters that
# draw nothing, draw as something else, or reorder what follows them; a
# diff is the candidate's bytes, and an escape sequence in a proposed
# config could move the cursor, erase the line above or repaint a removal
# as an addition, so the approval would be given to something other than
# what installs. One program renders both, so a character reads the same
# in a path as in a diff. Every character on the hidden list shows as an
# escape, never raw and never dropped:
#
#   backslash-u{HEX}  a hidden code point, uppercase hex with no leading
#                     zeros, the closing brace ending it
#   backslash-xHH     a byte that is not part of valid UTF-8, one escape
#                     per byte; every valid sequence is decoded first, so
#                     only the bytes that fail are escaped
#
# The hidden list: U+0000-001F, U+007F-009F, U+00A0, U+00AD, U+034F,
# U+061C, U+115F-1160, U+17B4-17B5, U+180B-180E, U+2000-200F,
# U+2028-202F, U+205F-206F, U+3000, U+3164, U+FE00-FE0F, U+FEFF, U+FFA0,
# U+FFF9-FFFB, U+E0000-E007F, U+E0100-E01EF. A plain space is not on it;
# the zero width joiner and non-joiner are (U+2000-200F), so a Persian
# word or an emoji sequence built with them shows the escape. A literal
# backslash followed by u{, or by x and a hex digit, shows as the escape
# of the backslash itself (U+5C), so a backslash-u on screen can only ever
# begin an escape.
#
# Layout. A single-line field (a path, a name) escapes the tab and the
# line feed like any other hidden character: a value sits on one row. A
# document shown as lines (the diff) keeps the line feed as the break and
# the tab as itself. Line endings are judged per file of the diff, over
# the content lines that end in a real line feed: when every one of them
# ends CR LF, that is the file's line-ending convention, stated once on a
# header line of its own (`CRLF line endings`, after the file's +++ line
# and before its first hunk), and each pair draws as one break. Any other
# carriage return is escaped where it is.
#
# Two kinds of escape. A hidden-list character's escape wears reverse
# red, the one style that means hidden, because the raw character could
# make the text read as one thing and act as another. The kept escapes --
# an invalid byte, an escaped backslash -- are shown as exactly what they
# are and cannot pass for anything else, so they take no style of their
# own and read in the value's color, or the diff line's. Under no color
# the escape text alone carries the fact.
#
# Display only: records, logs and the verify status keep the raw bytes
# (verify_escape writes its own form for its machine-read file).
#
# Perl, in bytes from end to end: it reads no locale, which it has to,
# because sudo's env_reset strips LANG before locked ever runs. Every perl
# locked runs, this one and the small ones elsewhere, starts under env -i:
# PERL5OPT adds switches (-M, -C), PERL5LIB and PERL5DB load code and
# PERL_UNICODE changes how bytes are read, all before a script's first
# line, and a root run must not hang that on sudo's env_reset any more
# than the shell's own startup does (-p, at the top). None of them needs
# anything from the environment. The UTF-8
# scan is spelled out instead of calling Encode::decode with a
# malformed-byte callback: Encode consumes the whole bad sequence and
# reports only its first byte, which would take bytes out of the display.
# vis -s was the other candidate and cannot serve either -- it rewrites
# every non-ASCII byte in every locale, so a Swedish or Persian config
# would arrive unreadable.
#
# Two modes:
#
#   field <escape style> <resume style>
#       stdin as one value. A hidden escape is wrapped in <escape style>
#       and followed by <resume style> (esc_into composes both).
#   lines <color 0|1> [<endings 0|1>]
#       stdin as a unified diff, painted when color is on: file headers
#       bold magenta, hunk headers cyan, additions green, removals red.
#       With endings 1, each file's line endings are judged as above, and
#       a CRLF file gets its header line, painted as a file header; with
#       0 (output that may not be a diff at all), every carriage return
#       is escaped.
#
# A file is a section of the diff: each run of file header lines starts
# one. A content line whose line feed diff added (a no-newline marker
# follows it) has no real line feed, so it is not judged, and its own
# carriage return stays escaped. A file with no hunk header gets no
# header line, so its carriage returns stay escaped too: the fact is
# never drawn as layout without being stated.
#
# A file header is recognized by position, never by its prefix: a removed
# line of SQL or Lua that begins -- arrives here as --- foo, and painting
# that magenta instead of red would be the very falsification this is
# here to stop. In unified output the --- / +++ pair can only sit at the
# very start or straight after a diff line, so two of them are expected
# there and nowhere else. Only in and Binary files stay lexical: a content
# line always carries a prefix character, so neither can begin one.
#
# The source is a single-quoted bash string holding no single quote, so
# bash expands nothing in it and perl sees the bytes written here.
# shellcheck disable=SC2016  # the single quotes are the point: no expansion
readonly UNTRUSTED_PL='
use strict;
binmode(STDIN);
binmode(STDOUT);
my $mode = shift(@ARGV);
$mode = "" unless defined $mode;
sub hidden {
  my $p = shift;
  return $p <= 0x1F || ($p >= 0x7F && $p <= 0x9F) || $p == 0xA0 || $p == 0xAD
    || $p == 0x34F || $p == 0x61C || ($p >= 0x115F && $p <= 0x1160)
    || ($p >= 0x17B4 && $p <= 0x17B5) || ($p >= 0x180B && $p <= 0x180E)
    || ($p >= 0x2000 && $p <= 0x200F) || ($p >= 0x2028 && $p <= 0x202F)
    || ($p >= 0x205F && $p <= 0x206F) || $p == 0x3000 || $p == 0x3164
    || ($p >= 0xFE00 && $p <= 0xFE0F) || $p == 0xFEFF || $p == 0xFFA0
    || ($p >= 0xFFF9 && $p <= 0xFFFB) || ($p >= 0xE0000 && $p <= 0xE007F)
    || ($p >= 0xE0100 && $p <= 0xE01EF);
}
# Strict UTF-8 multibyte sequences: no overlongs, no surrogates, nothing
# above U+10FFFF.
my $U8 = qr/[\xC2-\xDF][\x80-\xBF]|\xE0[\xA0-\xBF][\x80-\xBF]|[\xE1-\xEC\xEE\xEF][\x80-\xBF]{2}|\xED[\x80-\x9F][\x80-\xBF]|\xF0[\x90-\xBF][\x80-\xBF]{2}|[\xF1-\xF3][\x80-\xBF]{3}|\xF4[\x80-\x8F][\x80-\xBF]{2}/;
sub cp_of {
  my @b = unpack("C*", $_[0]);
  return (($b[0] & 0x1F) << 6) | ($b[1] & 0x3F) if @b == 2;
  return (($b[0] & 0x0F) << 12) | (($b[1] & 0x3F) << 6) | ($b[2] & 0x3F) if @b == 3;
  return (($b[0] & 0x07) << 18) | (($b[1] & 0x3F) << 12)
       | (($b[2] & 0x3F) << 6) | ($b[3] & 0x3F);
}
sub uesc { return sprintf("\\u{%X}", $_[0]); }
# esc <text> <escape style> <resume style> <tab is layout>
sub esc {
  my ($s, $o, $c, $tab) = @_;
  my $bs = uesc(0x5C);
  $s =~ s/([\x20-\x5B\x5D-\x7E]+)|(\\(?=u\{|x[0-9A-Fa-f]))|(\\)|($U8)|([\x00-\x1F\x7F])|([\x80-\xFF])/
      defined $1 ? $1
    : defined $2 ? $bs
    : defined $3 ? "\\"
    : defined $4 ? (hidden(cp_of($4)) ? $o . uesc(cp_of($4)) . $c : $4)
    : defined $5 ? (($tab && $5 eq "\t") ? "\t" : $o . uesc(ord($5)) . $c)
    : sprintf("\\x%02X", ord($6))/ge;
  return $s;
}
if ($mode eq "field") {
  my ($o, $c) = @ARGV;
  $o = "" unless defined $o;
  $c = "" unless defined $c;
  local $/;
  my $s = <STDIN>;
  $s = "" unless defined $s;
  print STDOUT esc($s, $o, $c, 0) or exit 1;
  close(STDOUT) or exit 1;
  exit 0;
}
exit 2 unless $mode eq "lines";
my $on = ($ARGV[0] || 0) ? 1 : 0;
my $ends = ($ARGV[1] || 0) ? 1 : 0;
my @l = <STDIN>;
my @k;
my $expect = 2;
for my $s (@l) {
  my $t = $s;
  $t =~ s/\n\z//;
  if ($t =~ /^diff /) { $expect = 2; push @k, "file"; next; }
  if ($expect > 0 && $t =~ /^(?:--- |\+\+\+ )/) { $expect--; push @k, "file"; next; }
  $expect = 0;
  push @k, $t =~ /^(?:Only in |Binary files )/ ? "file"
         : $t =~ /^\@\@/ ? "hunk"
         : $t =~ /^\+/ ? "add"
         : $t =~ /^-/ ? "del"
         : $t =~ /^ / ? "ctx"
         : "other";
}
# Per file: a content line counts toward the line endings of its file when
# its line feed belongs to the document; one followed by a no-newline
# marker was added by diff. %first holds the first hunk header of each
# file, where the header line goes.
my (@sec, @own, %lf, %bad, %first, %crlf);
my $n = 0;
for my $i (0 .. $#l) {
  $n++ if $k[$i] eq "file" && ($i == 0 || $k[$i - 1] ne "file");
  $sec[$i] = $n;
  $first{$n} = $i if $k[$i] eq "hunk" && !defined $first{$n};
  my $body = $k[$i] eq "add" || $k[$i] eq "del" || $k[$i] eq "ctx";
  my $next = $i < $#l ? $l[$i + 1] : "";
  $own[$i] = $body && $l[$i] =~ /\n\z/ && $next !~ /^\\ /;
  next unless $own[$i];
  $lf{$n}++;
  $bad{$n}++ unless $l[$i] =~ /\r\n\z/;
}
if ($ends) {
  $crlf{$_} = 1 for grep { !$bad{$_} && defined $first{$_} } keys %lf;
}
my %paint = (file => "\e[1;35m", hunk => "\e[36m", add => "\e[32m", del => "\e[31m");
for my $i (0 .. $#l) {
  if ($crlf{$sec[$i]} && $first{$sec[$i]} == $i) {
    print STDOUT ($on ? $paint{file} . "CRLF line endings\e[0m" : "CRLF line endings"), "\n"
      or exit 1;
  }
  my $s = $l[$i];
  my $nl = ($s =~ s/\n\z//) ? 1 : 0;
  $s =~ s/\r\z// if $crlf{$sec[$i]} && $own[$i];
  my $pre = $on ? ($paint{$k[$i]} || "") : "";
  my $out = $on ? esc($s, "\e[7;31m", "\e[0m" . $pre, 1) : esc($s, "", "", 1);
  $out = $pre . $out . "\e[0m" if $pre ne "";
  print STDOUT $out, ($nl ? "\n" : "") or exit 1;
}
close(STDOUT) or exit 1;
'

# esc_into <var> <text> [<escape style> [<resume style>]]: <text> as the
# reader is shown it, into <var>. <escape style> is the stream's reverse
# red (C_RV, E_RV or P_RV), worn by hidden-list escapes only; after each
# one the style resets and <resume style> -- the color the value is in --
# picks up again. Printable
# ASCII with no backslash is its own escaped form and skips the process
# (the case runs under LC_ALL=C, where [:print:] is that range).
#
# FAIL CLOSED: a text that cannot be rendered is never shown raw. Called
# directly, never inside a command substitution, so the exit ends locked
# and not a subshell.
esc_into() {
  local _ei_out LC_ALL=C
  case "$2" in
    *[![:print:]]*|*\\*) ;;
    *) printf -v "$1" '%s' "$2"; return 0 ;;
  esac
  _ei_out="$(printf '%s' "$2" | env -i /usr/bin/perl -e "$UNTRUSTED_PL" -- field \
    "${3:-}" "${3:+$'\033[0m'${4:-}}" && printf x)" || {
    echo "locked: cannot render a path for display; its raw bytes are never shown" >&2
    exit 1
  }
  printf -v "$1" '%s' "${_ei_out%x}"
}

# value_rows <indent> [<label> <role> <value>]...: the labeled rows a
# question or gate stands on (terminal-output). A path, a name, anything
# whose length locked does not choose, ends its line, and a question holds
# no such value: each one gets a row here, directly above the question,
# which names it with a noun ("this path"). The rows repeat what scrolled
# away. One gutter for the block, the longest label plus two spaces; the
# label bold, the padding outside it. <role> styles the value: subject
# (bold magenta, the one thing the y/N is about -- the diff renderer
# paints file headers the same, see UNTRUSTED_PL), id (cyan: a path or an
# identity),
# plain. Prints on stdout with set_pal, so a caller sends it to stderr
# with >&2 beside the prompt and keeps its colour.
value_rows() {
  local indent="$1" w=0 i lab role val st
  set_pal
  shift
  i=1
  while [ "$i" -le "$#" ]; do
    lab="${!i}"
    if [ $(( ${#lab} + 1 )) -gt "$w" ]; then w=$(( ${#lab} + 1 )); fi
    i=$((i + 3))
  done
  while [ "$#" -ge 3 ]; do
    lab="$1" role="$2" val="$3"
    shift 3
    case "$role" in
      subject) st="$P_B$P_MAG" ;;
      id)      st="$P_CYN" ;;
      *)       st="" ;;
    esac
    esc_into val "$val" "$P_RV" "$st"
    printf '%s%s%s:%s%*s%s%s%s\n' "$indent" "$P_B" "$lab" "$P_OFF" \
      $(( w - ${#lab} - 1 + 2 )) '' "$st" "$val" "$P_OFF"
  done
}

# ok_row <words> <value> [note]: a verdict on stdout, `✓ <words>: <value>`.
# The value -- a path, whose length locked does not choose -- ends the
# line, so a bounded field (a tier, a flag word) goes in <words>, before
# the colon, and a sentence about it goes on a dim line under the row,
# starting in the value's column (terminal-output Rows).
ok_row() {
  local v n=""
  esc_into v "$2" "$C_RV"
  [ -z "${3:-}" ] || esc_into n "$3" "$C_RV" "$C_DIM"
  printf '%s✓%s %s: %s\n' "$C_GRN" "$C_OFF" "$1" "$v"
  if [ -n "$n" ]; then
    printf '%*s%s%s%s\n' $(( ${#1} + 4 )) '' "$C_DIM" "$n" "$C_OFF"
  fi
}

# ok_move <words> <old> <new>: the verdict for a path that changed. The
# new path takes the line under the old one, `→` hanging in the gutter so
# the two start in the same column (`→` counted as one, as Ghostty draws
# it).
ok_move() {
  local a b
  esc_into a "$2" "$C_RV"
  esc_into b "$3" "$C_RV"
  printf '%s✓%s %s: %s\n' "$C_GRN" "$C_OFF" "$1" "$a"
  printf '%*s→ %s\n' $(( ${#1} + 2 )) '' "$b"
}

# say_out <text> <value>: one line on stdout, `<text>: <value>`. The value
# -- a path, whose length locked does not choose -- is shown as the
# characters that are there (esc_into) and ends the line, where nothing
# can follow it (terminal-output Rows: errors, refusals and log lines put
# the value last). <text> is locked's own words, styled by the caller.
# say_err is the same on stderr; err_val puts the red `✗ error:` label first.
say_out() {
  local v
  esc_into v "$2" "$C_RV"
  printf '%s: %s\n' "$1" "$v"
}
say_err() {
  local v
  esc_into v "$2" "$E_RV"
  printf '%s: %s\n' "$1" "$v" >&2
}
err_val() { say_err "${E_RED}${E_B}✗ error:${E_OFF} $1" "$2"; }

# shq <path>: <path> as one shell word that bash, zsh and fish all read
# back as the same bytes, on stdout, for a command line the reader may
# paste: bare when every character is one no shell treats specially and
# the first is not `=` (zsh expands =name to a command's path), else in
# single quotes. A quote inside is written '\'' and a backslash '\\',
# both outside the quotes: fish reads \' and \\ as escapes even inside
# single quotes, and all three read an unquoted \\ as one backslash. The
# same rule as pinned's shq. A quoted word ends in a quote, so a command
# substitution taking it keeps a trailing newline of the path. A
# suggested command embeds it, and the display escapes the whole line
# after (cmd_disp, esc_into): a name with a hidden character shows the
# escape, so a command that would not paste as shown never pretends to.
shq() {
  local LC_ALL=C out="" c i
  case "$1" in
    =*|''|*[!A-Za-z0-9._/+@:,=-]*) ;;
    *) printf '%s' "$1"; return 0 ;;
  esac
  for ((i = 0; i < ${#1}; i++)); do
    c="${1:i:1}"
    case "$c" in
      "'") out+="'\\''" ;;
      \\) out+="'\\\\'" ;;
      *)   out+="$c" ;;
    esac
  done
  printf "'%s'" "$out"
}

# path_lines <indent> <path>...: one path per line on stdout, each escaped
# and alone on its line. Prints with set_pal, so a caller sends it to
# stderr with >&2 and keeps its color.
path_lines() {
  local ind="$1" p v
  set_pal
  shift
  for p in "$@"; do
    esc_into v "$p" "$P_RV"
    printf '%s%s\n' "$ind" "$v"
  done
}

# move_lines <words> <old> <new>: `<words>: <old>` on stdout, the new
# path on the line under it, `→` hanging in the gutter so the two start in
# the same column (`→` counted as one, as Ghostty draws it). With set_pal,
# like path_lines.
move_lines() {
  local a b
  set_pal
  esc_into a "$2" "$P_RV"
  esc_into b "$3" "$P_RV"
  printf '%s: %s\n%*s→ %s\n' "$1" "$a" $(( ${#1} )) '' "$b"
}

usage() {
  cat <<EOF
usage: sudo locked <action> [options] [args]

  lock [--flag F] [--yes] [--dry-run] <path>...
      Protect a file, directory or symlink. You name what to protect;
      locked derives the rest: the directories above it that must stay
      put (placement; the path's own parent is never needed), the anchor
      at \$HOME, and any sealed directory no protected file needs any more,
      which it releases. ~ and anything under ~/.ssh take the anchor tier
      (ownership unchanged), everything else the content tier. Nothing is
      touched until the whole ceremony is derived: the snapshot->current
      diff, then the plan -- one line per node, root-most first -- then
      ONE question for the lot. --yes answers it (required when stdin is
      not a tty); --dry-run prints the plan and stops. A symlink argument
      seals the LINK, not its target, and takes the content tier, under
      ~/.ssh too; the plan says when the target is yours and not
      protected.
      --flag sappnd|schg                 anchor flag (default sappnd)
  unprotect [--yes] [--dry-run] <path>...
      Stop protecting a path you locked: its flag comes off, its owner,
      group and mode go back to what they were before the first lock, and
      the record is retired. Directories no other protected file needs are
      released in the same plan and under the same one question.
  unlock [--chain] [--dry-run] <path>...
      Release the named node only (snapshot taken first for content
      files/dirs). --chain also drops flags on chain ancestors, for
      edits that need a rename into a frozen parent (atomic-save
      editors). Next lock re-seals the chain.
  edit [--editor CMD | --from COPY] [--yes] <file>...
      sudoedit-style: copy the locked file to a user-owned temp copy,
      run your editor on it as you, then diff and confirm before the
      staged result is installed and resealed. The file is never left
      unlocked and no chain release is needed. Editor: --editor, else
      SUDO_EDITOR/VISUAL/EDITOR, else vi (single command, gets the
      copy's path as its argument).
      --from COPY takes the whole proposed content from COPY instead of
      running an editor -- one copy, one file. COPY is frozen into
      lock-account staging before the diff is drawn, and the diff and the
      install both read that frozen copy: whatever happens to COPY after
      you are shown the diff cannot change what installs.
      A file inside a folder locked as a whole follows the folder's
      record, and a file that does not exist yet there is created and
      sealed (the diff shows its whole content). Revert does not apply
      to those: they have no snapshot of their own.
      A symlink is followed to the file it points at, as an editor
      follows it; the diff and the question name both.
  revert [--dry-run] <path>...
      Files only: save current to .attic, restore snapshot, re-seal if
      the file was locked.
  rm [--recursive] [--yes] [--dry-run] <path>...
      Remove a path a sealed parent will not let go of. The helper
      releases the parent's flag on an open fd, unlinks, and restores
      it; nothing else in the parent may change meanwhile. Pool records
      at or under the path are retired, with locked named as the actor.
      --recursive is required for a non-empty directory and for any
      subtree that holds records of its own.
  trash [--recursive] [--dry-run] <path>...
      As rm, but the node goes to the system trash service as you, so
      Put Back keeps working. Records are suspended rather than retired
      and carry the bin location until the bin entry is gone.
  mv [--recursive] [--dry-run] <old> <new>
      Rename through the same window and re-key the records. Never
      clobbers an existing <new>; never crosses filesystems (a copy
      would drop flags and xattrs).
  rekey [--recursive] <old> <new>
      Record-only repair, for a node something else already moved.
      Refuses unless <new> is the very node the record describes.
  tombstone [--yes] <path>...
      Assert that a recorded path is gone: state retired, provenance
      "assertion". Refused while the path still exists.
  why <path>...
      Report what, if anything, stops this path from being changed,
      renamed or removed: flags on it and on every ancestor, who owns
      them, and whether locked is the one that set them.
      Read-only: works without sudo.
  status [<path>...]
      Verify and print the full chain for each path (no changes made).
      With no path, list every node in your pool instead.
      Read-only: works without sudo for your own pool.
  verify [--quiet]
      Re-check every locked node against its meta. Exit 0 clean, 5 on
      drift. Records the result per user in $LOCKED_STATE_ROOT/<user>/verify,
      which status shows and other tools may read.
  setup
      Provision lock user/group, digest-pinned sudoers, verify timer;
      self-install to \$INSTALL_TARGET. Refused on nix-managed installs
      (the nix module declares all of this; rebuild instead).

  --recursive  rm/trash/mv/rekey: act on a whole subtree, applying the
               record side-effect to every node beneath the named one
  --help       this text
  --version    print version

Exit codes:  0 ok  1 input/validation error  2 user abort
             3 partial failure  5 verify found drift
EOF
}

case "${1:-}" in
  --help|-h|help) usage; exit 0 ;;
  --version) echo "locked $VERSION"; exit 0 ;;
esac

[ $# -ge 1 ] || { usage >&2; exit 1; }
action="$1"
shift

# ---- option parsing --------------------------------------------------------

OPT_FLAG=sappnd
OPT_FLAG_SET=0
OPT_EDITOR=""
OPT_FROM=""
OPT_YES=0
OPT_DRY=0
OPT_CHAIN=0
OPT_QUIET=0
OPT_RECURSIVE=0
PATHS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --flag)    OPT_FLAG="${2:?--flag needs a value}"; OPT_FLAG_SET=1; shift 2 ;;
    --flag=*)  OPT_FLAG="${1#--flag=}"; OPT_FLAG_SET=1; shift ;;
    --editor)   OPT_EDITOR="${2:?--editor needs a value}"; shift 2 ;;
    --editor=*) OPT_EDITOR="${1#--editor=}"; shift ;;
    --from)     OPT_FROM="${2:?--from needs a value}"; shift 2 ;;
    --from=*)   OPT_FROM="${1#--from=}"; shift ;;
    --yes)     OPT_YES=1; shift ;;
    --dry-run) OPT_DRY=1; shift ;;
    --chain)   OPT_CHAIN=1; shift ;;
    --quiet)   OPT_QUIET=1; shift ;;
    --recursive) OPT_RECURSIVE=1; shift ;;
    --)        shift; while [ $# -gt 0 ]; do PATHS+=("$1"); shift; done ;;
    -*)        echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)         PATHS+=("$1"); shift ;;
  esac
done

case "$OPT_FLAG" in sappnd|schg) ;; *)
  echo "invalid --flag: $OPT_FLAG (sappnd|schg)" >&2; exit 1 ;;
esac

# --recursive widens the blast radius of exactly four verbs. Accepting it
# silently anywhere else would let a typo read as approval on the run where
# it finally lands on one of them.
if [ "$OPT_RECURSIVE" -eq 1 ]; then
  case "$action" in
    rm|trash|mv|rekey) ;;
    *) echo "--recursive applies to rm, trash, mv and rekey only" >&2; exit 1 ;;
  esac
fi

# --from names ONE proposed content for ONE file. It replaces the editor
# rather than accompanying it, and it means nothing to any other verb --
# each of those is refused here rather than quietly ignored, so a
# misplaced flag can never read as approval of something it never touched.
if [ -n "$OPT_FROM" ]; then
  if [ "$action" != "edit" ]; then
    echo "--from applies to edit only" >&2
    exit 1
  fi
  if [ -n "$OPT_EDITOR" ]; then
    echo "--from and --editor are alternatives; give one of them" >&2
    exit 1
  fi
  if [ "${#PATHS[@]}" -gt 1 ]; then
    echo "--from is one proposed copy for one file; got ${#PATHS[@]} files" >&2
    exit 1
  fi
  if [ ! -f "$OPT_FROM" ]; then
    say_err "--from: not a regular file" "$OPT_FROM"
    exit 1
  fi
fi

# status and why are reporting only -- they change nothing on disk -- so
# they are the actions a plain user may run: the pool's permissions (see the
# ensure step below) decide what they get to see. Everything else moves
# flags, ownership or content and still needs root.
if [ "$EUID" -ne 0 ] && [ "$action" != "status" ] && [ "$action" != "why" ]; then
  echo "locked must run as root (sudo locked ...)" >&2
  exit 1
fi

# Root derives the invoking user from sudo; verify can run from launchd with
# no SUDO_USER at all. Unprivileged status has no sudo hop, so the invoker is
# whoever we are running as -- SUDO_USER is ignored there on purpose, or
# `sudo -u other locked status` would name a pool the caller's own
# credentials do not entitle them to.
if [ "$EUID" -eq 0 ]; then
  inv="${SUDO_USER:-}"
  if [ "$action" != "verify" ]; then
    [ -n "$inv" ] || { echo "must be invoked via sudo" >&2; exit 1; }
  fi
else
  inv="$(id -un)"
fi

lock_account_for() { echo "_${1}-lock"; }
lock_user=""
[ -n "$inv" ] && lock_user="${LOCKED_LOCK_ACCOUNT:-$(lock_account_for "$inv")}"

home_for() {
  # NFSHomeDirectory from Directory Services, not ~ expansion.
  dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $2; exit}'
}
user_home=""
if [ -n "$inv" ]; then
  # An assignment carries its substitution's exit status, and set -e would
  # end the script on it silently (dscl exits 70 when Directory Services is
  # unreachable, e.g. under a sandbox). Swallow it so the check below is the
  # one that reports.
  user_home="${LOCKED_USER_HOME:-$(home_for "$inv" || true)}"
  [ -n "$user_home" ] || { echo "cannot determine home directory of $inv" >&2; exit 1; }
fi

log_action() {
  # ASCII only; visible via:
  #   log show --predicate 'eventMessage CONTAINS "locked: user="' --last 1h
  logger -t locked "user=${inv:-launchd} action=$1 file=${2:-} result=${3:-ok}"
}

run() {
  if [ "$OPT_DRY" -eq 1 ]; then
    dry_line "$@"
  else
    "$@"
  fi
}

# dry_line <argv>...: what a dry run would have run, on one line. Each
# word is shell-quoted as %q does, then escaped (esc_into): %q passes
# through raw any character the locale calls printable -- a zero-width
# space, under a UTF-8 locale -- so the quoting alone does not show what
# is there.
dry_line() {
  local a q out="dry run:"
  for a in "$@"; do
    printf -v q '%q' "$a"
    esc_into q "$q" "$C_RV"
    out="$out $q"
  done
  printf '%s\n' "$out"
}

# ONE implementation of the gate contract, shared by every y/N prompt and
# every gate here, which had agreed on Enter and on little else.
# `y`/`yes` continue, `n`/`no` decline, Enter takes the site's default, and
# ANYTHING ELSE IS NOT ACTED ON: a yellow `not an answer` says so on its
# own line -- a correction, not a refusal -- the gate line is printed
# again, and the next answer is read at the end of it. A case whose last
# arm is the
# continue turns a typo, a stray paste or a leaned-on key into consent at
# exactly the moment a human is being asked to take responsibility. End of
# input declines: a closed stdin is not consent, and these gates fail closed.
#
# The caller owns the decline line and its logging -- only it knows what
# stays unchanged -- and hands the gate line in already rendered, so
# per-site colour and wording stay where they are composed.
#
# The palette follows the fd, exactly as C_*/E_* do: fd 2 is this process's
# stderr and fd 1 its stdout. A caller whose own stdout is redirected away
# from the tty never reaches a gate -- both sites test the tty first -- so
# the fd is a sound stand-in for the stream here.
gate_answer() { # <fd> <rendered gate line> <Enter continues: 0|1>
  local fd="$1" line="$2" enter_yes="$3" reply yel off
  if [ "$fd" -eq 1 ]; then
    yel="$C_YEL" off="$C_OFF"
  else
    yel="$E_YEL" off="$E_OFF"
  fi
  printf '%s' "$line" >&"$fd"
  while :; do
    if ! IFS= read -r reply; then
      printf '\n' >&"$fd"   # no echoed Enter closed the gate line
      return 1
    fi
    case "$reply" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO)   return 1 ;;
      '')
        if [ "$enter_yes" -eq 1 ]; then
          return 0
        fi
        return 1
        ;;
    esac
    # Yellow is the attention role: this is the one line the human has to
    # notice, because they just answered wrong. What was typed is NEVER
    # echoed: the terminal already showed it as it was typed, and a pasted
    # control sequence printed raw could rewrite the very line the human is
    # about to answer. It lists no keys: the gate line follows again, so
    # the answer is always typed beside them.
    printf '%snot an answer%s\n%s' "$yel" "$off" "$line" >&"$fd"
  done
}

# asking: true when the next confirm goes ahead -- a human at a tty, or
# --yes answering in advance. The rows a question stands on print only
# then: a refusal prints none (terminal-output), and under --yes they are
# the record of what was done.
asking() { [ "$OPT_YES" -eq 1 ] || [ -t 0 ]; }

confirm() { # <question> [consequence]
  # Returns 0 on yes. Fail closed: non-tty without --yes aborts.
  [ "$OPT_YES" -eq 1 ] && return 0
  if [ ! -t 0 ]; then
    echo "stdin is not a tty and --yes not given; aborting" >&2
    return 1
  fi
  # A question is one verb and its noun; what a yes also does is a
  # sentence on the line of its own above it (terminal-output). Printed
  # only when the question is: under --yes nobody is asked.
  [ -z "${2:-}" ] || echo "$2" >&2
  local line
  # Bold carries the decision (terminal-output): the whole sentence,
  # `[y/N]` included, is the authoritative register of this screen. The two
  # KEYS inside the brackets are bold blue -- the role for what the human
  # may hand the program -- so the eye finds the answer without reading the
  # sentence; the brackets and the slash stay plain bold structure. Each key
  # re-opens bold after its own reset, because the reset clears it.
  printf -v line '%s%s [%sy%s%s/%sN%s%s]%s ' \
    "$E_B" "$1" "$E_BLU" "$E_OFF" "$E_B" "$E_BLU" "$E_OFF" "$E_B" "$E_OFF"
  gate_answer 2 "$line" 0
}

confirm_hard() { # <prompt>
  # High-signal prompts (node identity changed): --yes does NOT satisfy
  # this; a human at a tty must answer.
  if [ ! -t 0 ]; then
    echo "refusing: this decision needs a human at a tty (--yes does not apply)" >&2
    return 1
  fi
  local line
  # Same shape as confirm: bold sentence, bold-blue keys.
  printf -v line '%s%s [%sy%s%s/%sN%s%s]%s ' \
    "$E_B" "$1" "$E_BLU" "$E_OFF" "$E_B" "$E_BLU" "$E_OFF" "$E_B" "$E_OFF"
  gate_answer 2 "$line" 0
}

# During an unlock window a released ancestor can be swapped by anything
# with write on ITS parent (rename checks parent write only). Re-sealing
# must not silently bless a replaced node.
check_reseal_identity() { # <path> <metafile>
  local n="$1" meta="$2" prev_id cur_id sn=0
  prev_id="$(meta_field "$meta" id)"
  cur_id="$(node_id "$n")" || return 1
  same_node "$prev_id" "$cur_id" || sn=$?
  if [ "$sn" -eq 0 ]; then
    return 0
  fi
  if [ "$sn" -eq 2 ]; then
    # Same inode, pre-0.6.0 spelling: the seal's own write_meta records the
    # volume form a line later, so the note is all this owes.
    echo "  note: identity record upgraded (dev.ino → volume uuid)"
    return 0
  fi
  # An alarm can fire anywhere, so the block owns one leading blank line.
  # Inside it, the question block's order (terminal-output): the advice,
  # locked's own words; the rows; the alarm, flush; then the question.
  # The node is a path and ends its row; the two identities are fields of
  # a known form, so they share one row as a transition.
  echo >&2
  echo "If you did not swap this node yourself, stop and investigate" >&2
  echo "(compare against the snapshot; check: ${E_CYN}log show --predicate" >&2
  echo "'eventMessage CONTAINS \"locked:\"' --last 1h${E_OFF})." >&2
  if [ ! -t 0 ]; then
    # Nobody can answer, so no rows (a refusal prints none); the refusal
    # names the node, last.
    echo "${E_RED}${E_B}!!! a node was REPLACED while unlocked !!!${E_OFF}" >&2
    local en
    esc_into en "$n" "$E_RV"
    echo "refusing to re-seal it without a human at a tty (--yes does not apply): $en" >&2
    return 1
  fi
  value_rows "" node subject "$n" id id "$prev_id → $cur_id" >&2
  echo "${E_RED}${E_B}!!! a node was REPLACED while unlocked !!!${E_OFF}" >&2
  confirm_hard "re-seal the replaced node anyway?"
}

# ---- shared helpers --------------------------------------------------------

# Verify a path is root-owned with no group/other write. Used both to refuse
# installing into a user-writable ancestry and to validate the chain stop
# node. The group NAME is deliberately not pinned: the strict modes below
# leave no group-write bit to abuse, so the group is moot and root:admin 755
# is exactly as unwritable to a non-root process as root:wheel 755. Two real
# shapes need that: /Users, which macOS ships root:admin 755, and store
# object dirs, whose group is wheel or nixbld depending on whether the object
# was substituted or built locally. Owner and mode stay enforced; the group
# is still read so the error message can show it for diagnosis.
verify_root_owned_path() {
  local path="$1" owner mode
  owner="$(stat -f '%Su:%Sg' "$path")"
  mode="$(stat -f '%OLp' "$path")"
  if [ "${owner%%:*}" != "root" ]; then
    err_val "owned $owner, expected root owner" "$path"
    return 1
  fi
  case "$mode" in
    755|750|700|555|550|500) ;;
    *)
      err_val "mode $mode, expected 755 or stricter" "$path"
      return 1
      ;;
  esac
}

# The file-mode counterpart of verify_root_owned_path: a program root runs
# must be root-owned and unwritable by group or other. Directory modes have
# a small closed set worth accepting; an executable's does not (555, 700,
# 750, 755 are all legitimate), so the rule is stated as the bits that must
# be OFF. %OLp drops leading zeros (0044 prints as "44") and a setuid/
# setgid/sticky bit ADDS a fourth digit (4755) -- pad, then keep only the
# last three, so the permission digits sit at fixed positions either way.
verify_root_owned_file() {
  local path="$1" owner mode
  owner="$(stat -f '%Su' "$path")"
  if [ "$owner" != "root" ]; then
    err_val "owned by $owner, expected root owner" "$path"
    return 1
  fi
  mode="$(printf '%03d' "$(stat -f '%OLp' "$path")")"
  mode="${mode#"${mode%???}"}"
  case "${mode:1:1}${mode:2:1}" in
    *[2367]*)
      err_val "mode $mode; group/other write must be off" "$path"
      return 1
      ;;
  esac
}

now_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

# URL-encode % and / so a path becomes an unambiguous flat filename.
# Order matters: % first, then /, otherwise %2F gets re-encoded.
encode() {
  printf '%s' "$1" | sed -e 's|%|%25|g' -e 's|/|%2F|g'
}
decode() {
  printf '%s' "$1" | sed -e 's|%2F|/|g' -e 's|%25|%|g'
}

flags_of() {
  # Symbolic flag word, normalized: "" when none (stat prints "-"), spaces
  # stripped. stat's keyword order is fixed on a given OS (probed:
  # "uappnd,uchg,hidden"), so string equality is a sound comparison.
  local s
  s="$(stat -f '%Sf' "$1")"
  s="${s// /}"
  [ "$s" = "-" ] && s=""
  printf '%s' "$s"
}
# Node identity: the volume's UUID plus the inode. st_dev is NOT a volume
# key -- APFS assigns it at mount, in mount order, so a reboot can hand the
# same number to another volume (live 2026-09-09: a record written with dev
# 16777234 came back naming /System/Volumes/Update, and every re-seal read
# as a swap). The volume UUID belongs to the volume itself and survives.
#
# The helper is what reads it, so the record and the helper's own compare
# can never spell one node differently; a filesystem that reports no UUID
# (devfs) falls back to st_dev exactly as stat(1) printed it. The record
# separates the two halves with ".", the helper's wire grammar with ":".
node_id() { # <path>
  verify_helper || return 1
  local out
  out="$("$LOCKED_HELPER" id "$1")" || return 1
  printf '%s' "${out/:/.}"
}

# id_form <id> -> vol|dev. Only the volume form has the UUID's shape.
id_form() {
  case "${1%%.*}" in
    ????????-????-????-????-????????????) printf 'vol' ;;
    *)                                    printf 'dev' ;;
  esac
}

# same_node <recorded> <live>: 0 the same node, 2 the same node named by a
# pre-0.6.0 record (dev.ino recorded, volume form live, inode equal), 1 a
# different node.
#
# The inode carries the whole signal. Inside an unlock window a swap always
# changes it: directories cannot be hard-linked, and a node renamed in from
# elsewhere is a different inode, on this volume or any other. dev only ever
# named the volume, which the UUID now names across boots too -- so a
# recorded dev that no longer matches is a remount, not a replacement.
same_node() { # <recorded> <live>
  local rec="$1" live="$2"
  if [ -z "$rec" ] || [ -z "$live" ]; then
    return 1
  fi
  if [ "$rec" = "$live" ]; then
    return 0
  fi
  if [ "$(id_form "$rec")" = "dev" ] && [ "$(id_form "$live")" = "vol" ] &&
     [ "${rec#*.}" = "${live#*.}" ]; then
    return 2
  fi
  return 1
}

# chflags gotcha (probed 2026-08-05): "--" must come BEFORE the flag word;
# after it, BSD getopt treats "--" as a filename and poisons the exit code.
#
# Always -h: a symlink argument is sealed as the node it is (see
# leaf_path), so the flag has to land on the LINK and never on whatever it
# points at -- the target is somebody else's node. On anything that is not
# a link -h changes nothing, which is why it is unconditional here rather
# than a branch. There is no recursive form: a tree is sealed node by node
# through the helper (node_op), which gates each node by its owner. A link
# inside a sealed tree takes the flag on itself there too (probed
# 2026-09-14 for chflags -R, which is also why verify's find(1) stray scan
# does not trip over one).
fset() {   # fset <flagword> <path>
  run chflags -h -- "$1" "$2"
}
fclear() { # fclear <flagword> <path>
  fset "no$1" "$2"
}

# node_op <log verb> <path> <seal|unseal> <helper options>...: change a
# node you protect -- its owner, mode and flag, a placement directory's
# ACL entry, and with --recursive every node under it -- through the
# window helper, on each node's own descriptor. This is how root acts on
# anything in the invoker's space that a same-UID process could have
# swapped or linked into place after the plan was made, chain directories
# included: they are sealed leaf first, so the folders above one are still
# yours while it is sealed. The helper takes only a directory, a file or a
# symlink, owned by the account its --owner names, and the node its --id
# names, and it rolls back what it had already changed when it refuses.
# Root never does more to an inode than the invoker could do themselves; a
# hard link to a root-owned file is still root's, so it is refused,
# whatever folder it was linked into. fset and fclear above stay for nodes
# no other process can reach: files inside a sealed folder.
#
# The helper names the node it refused and why, on its own line; the line
# here says what that means for the run. Returns 0 only when the change was
# made (or a dry run printed it).
node_op() {
  local lv="$1" p="$2" first
  shift 2
  helper_call "$@"
  [ "$OPT_DRY" -eq 1 ] && return 0
  case "$HELPER_RC" in
    0) return 0 ;;
    2)
      say_err "${E_RED}${E_B}✗ refused:${E_OFF} not the node the plan or the record names; nothing was changed" "$p"
      log_action "$lv" "$p" refuse-identity
      ;;
    7)
      say_err "${E_RED}${E_B}✗ refused:${E_OFF} the helper would not act, for the reason above; nothing was changed" "$p"
      log_action "$lv" "$p" refuse-gate
      ;;
    3)
      say_err "${E_RED}${E_B}✗ failed:${E_OFF} nothing was changed" "$p"
      log_action "$lv" "$p" fail
      ;;
    5)
      # The roll back itself failed: the nodes on the helper's window-open
      # lines (escaped by the helper) are not as they were found. Printed
      # as they came, for the reason helper_outcome gives.
      echo >&2
      echo "${E_RED}${E_B}!!! a refused change could not be rolled back whole !!!${E_OFF}" >&2
      say_err "    target" "$p"
      printf '%s\n' "$HELPER_OUT" \
        | awk -F'\t' '$1=="window-open"{printf "    not restored: %s\n", $2}' >&2
      echo "    The record is not updated. See what differs: sudo locked verify" >&2
      log_action "$lv" "$p" alarm-rollback
      ;;
    *)
      first="the window helper exited $HELPER_RC, which locked does not know how to read"
      say_err "${E_RED}${E_B}✗ error:${E_OFF} $first; treating the target as unchanged" "$p"
      log_action "$lv" "$p" fail-unknown
      ;;
  esac
  return 1
}

# ---- placement ACL entry ---------------------------------------------------
#
# A placement directory belongs to the lock account, because uappnd is a
# user flag its owner could clear. The invoker gets back in through ONE ACL
# entry naming them, never through a group: BSD gives a new entry its
# parent directory's group, so a group that grants the way in is inherited
# by everything created inside -- which is how the lock group spread
# through ~/.config and ~/Library before 0.14.0. Group and mode stay what
# they were.
#
# The entry grants what the directory's owner bits gave its owner, minus
# every right that removes or renames an entry (delete, delete_child) and
# every right over the directory's own metadata (writeattr, writeextattr,
# writesecurity, chown): the invoker cannot strip or widen it, because
# only the owner or root may change an ACL. No inherit flags, so nothing
# created inside picks it up. Probed 2026-09-15, 41/0.

# acl_entries <path>: the node's ACL, one entry per line, index stripped.
# -q turns a control character in the name line into '?', so a hostile
# name cannot pose as an entry line; sed drops the name line either way.
acl_entries() {
  /bin/ls -ledq -- "$1" | sed -e 1d -e 's/^ *[0-9][0-9]*: //'
}

# acl_has <path> <entry>: the node carries exactly this entry. Captured
# before the match, so grep -q exiting early cannot SIGPIPE ls into a
# pipefail false negative.
acl_has() {
  local e
  e="$(acl_entries "$1")" || return 1
  printf '%s\n' "$e" | grep -qxF -- "$2"
}

# acl_names_user <path> <user>: some entry, allow or deny, names <user>.
acl_names_user() {
  local e
  e="$(acl_entries "$1")" || return 1
  printf '%s\n' "$e" | grep -q "^user:$2 "
}

# placement_entry <user> <mode>: the entry a placement seal adds, spelled
# the way ls -le prints it back: the rights in the kernel's own order. chmod
# +a and -a accept the same spelling, so the one recorded line is both the
# verify needle and the release argument. Empty when the owner digit grants
# nothing, which plan_node refuses.
placement_entry() {
  local m d r=""
  m="$(printf '%03d' "$2")"
  m="${m#"${m%???}"}"
  d="${m:0:1}"
  if [ $((d & 4)) -ne 0 ]; then r="$r,list"; fi
  if [ $((d & 2)) -ne 0 ]; then r="$r,add_file"; fi
  if [ $((d & 1)) -ne 0 ]; then r="$r,search"; fi
  if [ $((d & 2)) -ne 0 ]; then r="$r,add_subdirectory"; fi
  if [ $((d & 4)) -ne 0 ]; then r="$r,readattr,readextattr,readsecurity"; fi
  if [ -n "$r" ]; then
    printf 'user:%s allow %s' "$1" "${r#,}"
  fi
}

meta_field() {
  awk -F= -v f="$2" '$1==f{print substr($0, length(f)+2); exit}' "$1"
}

# write_meta <metafile> key=value...
#
# Known keys: owner, group, mode, lockmode, tier, flag, flagsym, id,
# recursive, role, state, plus the provenance fields the retired/suspended
# states add -- via, by, at, bin -- and acl, the entry a placement seal
# added (see placement_entry; no other tier has one), and mismatch, which
# may repeat: an edit that did not install as approved (see mismatch_kv),
# carried by every rewrite and dropped only by a fresh seal, a revert, or
# a clean edit of the same file. role is leaf (a node
# you named with lock: the intent) or chain (a directory sealed because
# some leaf needs it; see plan_releases). Nothing here validates the set;
# the caller emits the full record, because this replaces the file rather
# than patching it. An empty argument is skipped, so a rewrite can carry an
# optional pair as "$(acl_kv "$meta")" without a blank line appearing.
# No key stores the node's own PATH: the path lives only in the encoded
# filename, which is what makes rekey_record a rename and nothing more.
#
# Staging is keyed to the destination's OWN pool dir, not to the invoker's:
# verify walks every user's pool, so USER_POOL and $lock_user are the
# wrong answer there. The pool dir is installed owner and group = that
# user's lock account, so reading it back is exactly the identity the
# metas already carry.
#
# NOTE on error handling below: every per-file entry point runs in a || or
# if context, which suspends errexit for the whole call tree -- so every
# mutating step in this file carries an explicit || return 1. Do not rely
# on set -e inside these functions.
write_meta() {
  local meta="$1"
  shift
  local dir owngrp tmp
  dir="$(dirname "$meta")"
  owngrp="$(stat -f '%Su:%Sg' "$dir")" || return 1
  tmp="$(mktemp "${dir}/.meta.XXXXXX")" || return 1
  local kv
  for kv in "$@"; do
    if [ -n "$kv" ]; then
      printf '%s\n' "$kv"
    fi
  done >"$tmp" || return 1
  chown "$owngrp" "$tmp" || return 1
  # 640, not 600: a meta records identity and lock state, never file
  # content, and the lock group is exactly the invoking user -- that group
  # read is what lets `locked status` run without sudo. Snapshots and attic
  # copies, which DO hold content, stay 600.
  chmod 640 "$tmp" || return 1
  mv -f -- "$tmp" "$meta" || return 1
}

# acl_kv <metafile>: the record's acl pair, for a rewrite to carry through,
# or nothing for a record that has none.
acl_kv() {
  local v
  v="$(meta_field "$1" acl)"
  if [ -n "$v" ]; then
    printf 'acl=%s' "$v"
  fi
}

# mismatch_kv <metafile> [<path>]: the record's mismatch lines, one per
# file whose edit did not install as approved (see check_install), joined
# for a rewrite to carry through, less any line that names <path>:
#   mismatch=<at> <what differed> <path, written as verify_escape writes it>
# The path goes last because an escaped path may still hold a space. The
# name to drop travels through the environment, not awk -v, which would
# read the escapes in it as awk's own.
mismatch_kv() {
  local drop=""
  if [ -n "${2:-}" ]; then
    drop="$(verify_escape "$2")"
  fi
  DROP="$drop" awk '
    index($0, "mismatch=") != 1 { next }
    {
      rest = substr($0, 10)
      rest = substr(rest, index(rest, " ") + 1)
      p = substr(rest, index(rest, " ") + 1)
      if (ENVIRON["DROP"] != "" && p == ENVIRON["DROP"]) next
      out = out sep $0
      sep = "\n"
    }
    END { printf "%s", out }
  ' "$1"
}

# rewrite_meta_id <metafile> <id>
# The identity record's own migration: same node, newer spelling. Mirrors
# rewrite_meta_state with the halves swapped -- the state is what is kept
# and the id is what changes -- and no provenance pairs, because nothing
# about the node itself moved.
rewrite_meta_id() {
  local meta="$1" id="$2"
  write_meta "$meta" \
    "owner=$(meta_field "$meta" owner)" \
    "group=$(meta_field "$meta" group)" \
    "mode=$(meta_field "$meta" mode)" \
    "lockmode=$(meta_field "$meta" lockmode)" \
    "tier=$(meta_field "$meta" tier)" \
    "flag=$(meta_field "$meta" flag)" \
    "flagsym=$(meta_field "$meta" flagsym)" \
    "id=$id" \
    "recursive=$(meta_field "$meta" recursive)" \
    "role=$(meta_field "$meta" role)" \
    "$(acl_kv "$meta")" \
    "$(mismatch_kv "$meta")" \
    "state=$(meta_field "$meta" state)" || return 1
}

# rewrite_meta_state <metafile> <state> [key=value]...
# State transitions that keep the node's identity (locked -> retired,
# suspended -> retired) still have to re-emit every field, since write_meta
# replaces the file. The trailing pairs carry the provenance of the
# transition: via/by/at, and bin for a suspension.
rewrite_meta_state() {
  local meta="$1" state="$2"
  shift 2
  write_meta "$meta" \
    "owner=$(meta_field "$meta" owner)" \
    "group=$(meta_field "$meta" group)" \
    "mode=$(meta_field "$meta" mode)" \
    "lockmode=$(meta_field "$meta" lockmode)" \
    "tier=$(meta_field "$meta" tier)" \
    "flag=$(meta_field "$meta" flag)" \
    "flagsym=$(meta_field "$meta" flagsym)" \
    "id=$(meta_field "$meta" id)" \
    "recursive=$(meta_field "$meta" recursive)" \
    "role=$(meta_field "$meta" role)" \
    "$(acl_kv "$meta")" \
    "$(mismatch_kv "$meta")" \
    "state=$state" \
    "$@" || return 1
}

# rewrite_meta_role <metafile> <role>: a sealed anchor becoming yours by
# name (chain -> leaf). Everything else about the record stays; only a live
# record without provenance fields ever takes this path.
rewrite_meta_role() {
  local meta="$1" role="$2"
  write_meta "$meta" \
    "owner=$(meta_field "$meta" owner)" \
    "group=$(meta_field "$meta" group)" \
    "mode=$(meta_field "$meta" mode)" \
    "lockmode=$(meta_field "$meta" lockmode)" \
    "tier=$(meta_field "$meta" tier)" \
    "flag=$(meta_field "$meta" flag)" \
    "flagsym=$(meta_field "$meta" flagsym)" \
    "id=$(meta_field "$meta" id)" \
    "recursive=$(meta_field "$meta" recursive)" \
    "role=$role" \
    "$(acl_kv "$meta")" \
    "$(mismatch_kv "$meta")" \
    "state=$(meta_field "$meta" state)" || return 1
}

# ---- setup -----------------------------------------------------------------

# The nix build rewrites INSTALL_TARGET's default to the system profile;
# a copy executing from the store is nix-managed however it was invoked.
nix_managed() {
  case "$INSTALL_TARGET" in /run/current-system/*) return 0 ;; esac
  case "$(readlink -f "$0")" in /nix/store/*) return 0 ;; esac
  return 1
}

install_verify_timer() {
  local tmp
  tmp="$(mktemp)"
  cat >"$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>locked.verify</string>
  <key>ProgramArguments</key>
  <array>
    <string>${INSTALL_TARGET}</string>
    <string>verify</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key><integer>${LOCKED_VERIFY_INTERVAL}</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/var/log/locked-verify.log</string>
</dict>
</plist>
EOF
  install -m 644 -o root -g wheel "$tmp" "$LOCKED_VERIFY_PLIST"
  rm -f -- "$tmp"
  # Idempotent (re)load.
  launchctl bootout system "$LOCKED_VERIFY_PLIST" 2>/dev/null || true
  launchctl bootstrap system "$LOCKED_VERIFY_PLIST"
  say_out "verify timer installed (every ${LOCKED_VERIFY_INTERVAL}s)" "$LOCKED_VERIFY_PLIST"
}

do_setup() {
  # Under the nix deployment every step below is declared by the nix
  # module (security.locked): binary in the system profile, lock account
  # and group, digest-pinned sudoers, verify daemon. Refuse rather than
  # fight the declarative config; a rebuild is the whole setup there.
  if nix_managed; then
    echo "${E_RED}${E_B}✗ error:${E_OFF} this locked is nix-managed; setup here is declarative." >&2
    echo "         Change the nix module config (security.locked) and rebuild" >&2
    echo "         instead. Standalone setup remains available by running" >&2
    echo "         ./locked setup from a repo checkout." >&2
    exit 1
  fi

  # 1. Self-install. Verify every ancestor dir of INSTALL_TARGET is root-owned
  #    BEFORE writing the binary, so we never install into a user-writable path.
  local self target target_dir
  self="$(readlink -f "$0")"
  target="$INSTALL_TARGET"
  target_dir="$(dirname "$target")"

  install -d -m 755 -o root -g wheel "$target_dir"

  local p="$target_dir"
  while [ "$p" != "/" ]; do
    verify_root_owned_path "$p" || {
      echo "         refusing to install: a non-root owner of an ancestor dir can replace the binary" >&2
      exit 1
    }
    p="$(dirname "$p")"
  done

  if [ "$self" != "$target" ]; then
    install -m 755 -o root -g wheel "$self" "$target"
    say_out installed "$target"
  else
    say_out "binary already installed" "$target"
  fi

  # 2. Lock group
  local gid used_gids id
  if dscl . -read "/Groups/${lock_user}" >/dev/null 2>&1; then
    gid="$(dscl . -read "/Groups/${lock_user}" PrimaryGroupID 2>/dev/null | awk '{print $2}')"
    echo "group exists: ${lock_user} (GID $gid)"
  else
    used_gids="$(dscl . -list /Groups PrimaryGroupID | awk '{print $2}')"
    gid=
    # Prefer 401 deterministically (the reserved lock slot). Fall back to
    # the first free in the 400-499 service lane if 401 is taken.
    for id in 401 $(seq 400 499); do
      if ! printf '%s\n' "$used_gids" | grep -qx "$id"; then
        gid="$id"; break
      fi
    done
    [ -n "$gid" ] || { echo "no free GID in [400, 499]" >&2; exit 1; }
    dscl . -create "/Groups/${lock_user}"
    dscl . -create "/Groups/${lock_user}" RealName "Lock group for ${inv}"
    dscl . -create "/Groups/${lock_user}" PrimaryGroupID "$gid"
    echo "created group: ${lock_user} (GID $gid)"
  fi

  # 3. Lock user
  local uid used_uids
  if dscl . -read "/Users/${lock_user}" >/dev/null 2>&1; then
    uid="$(dscl . -read "/Users/${lock_user}" UniqueID 2>/dev/null | awk '{print $2}')"
    echo "user exists: ${lock_user} (UID $uid)"
  else
    used_uids="$(dscl . -list /Users UniqueID | awk '{print $2}')"
    uid=
    for id in 401 $(seq 400 499); do
      if ! printf '%s\n' "$used_uids" | grep -qx "$id"; then
        uid="$id"; break
      fi
    done
    [ -n "$uid" ] || { echo "no free UID in [400, 499]" >&2; exit 1; }
    dscl . -create "/Users/${lock_user}"
    dscl . -create "/Users/${lock_user}" UniqueID "$uid"
    dscl . -create "/Users/${lock_user}" PrimaryGroupID "$gid"
    dscl . -create "/Users/${lock_user}" UserShell /usr/bin/false
    dscl . -create "/Users/${lock_user}" NFSHomeDirectory /var/empty
    dscl . -create "/Users/${lock_user}" RealName "Lock user for ${inv}"
    dscl . -create "/Users/${lock_user}" IsHidden 1
    echo "created user: ${lock_user} (UID $uid)"
  fi

  # 4. Add invoker to lock group (reads their pool: unprivileged status).
  if dseditgroup -o checkmember -m "$inv" "$lock_user" >/dev/null 2>&1; then
    echo "$inv already member of ${lock_user}"
  else
    dseditgroup -o edit -a "$inv" -t user "$lock_user"
    echo "added $inv to ${lock_user}"
  fi

  # 5. Sudoers entry with binary-digest pin (validated before installing).
  #    Digest_Spec makes sudo compute the binary's sha256 at invocation and
  #    refuse on mismatch -- binary integrity enforced before our code runs.
  local sudoers_target sudoers_line digest tmp
  sudoers_target=/etc/sudoers.d/locked
  digest="$(shasum -a 256 "$INSTALL_TARGET" | awk '{print $1}')"
  sudoers_line="$inv ALL=(root) sha256:$digest ${INSTALL_TARGET}"
  if [ -f "$sudoers_target" ] && grep -qF "$sudoers_line" "$sudoers_target"; then
    say_out "sudoers digest current" "$sudoers_target"
  else
    tmp="$(mktemp)"
    printf '%s\n' "$sudoers_line" >"$tmp"
    if visudo -c -f "$tmp" >/dev/null 2>&1; then
      install -m 440 -o root -g wheel "$tmp" "$sudoers_target"
      say_out "wrote sudoers entry with digest" "$sudoers_target"
      echo "  digest: sha256:$digest"
    else
      echo "sudoers validation failed; not installing" >&2
      rm -f -- "$tmp"
      exit 1
    fi
    rm -f -- "$tmp"
  fi

  # 6. Verify timer.
  install_verify_timer

  # 7. Flush directory service cache so new accounts are visible immediately.
  dscacheutil -flushcache

  log_action setup "" ok
  echo
  echo "setup complete."
  # A suggestion block (commands the human may type later) keeps its own
  # label, a sentence -- never `next:`, the label gates used to wear.
  echo
  echo "To check the pool, then adopt a first target, run:"
  echo
  echo "  sudo locked status /nonexistent    # should print 'not in pool'"
  echo "  sudo locked lock PATH"
}

if [ "$action" = "setup" ]; then
  do_setup
  exit 0
fi

# ---- invocation-time integrity ---------------------------------------------

# Re-verify INSTALL_TARGET ancestry on every invocation, not just at setup.
# Catches /usr/local being chowned user-writable after setup (e.g. a legacy
# "sudo chown -R \$USER /usr/local" Homebrew recipe).
#
# Two relaxations for the nix deployment, each deliberately narrow:
#
#   - Symlink ancestors (the system profile: /run, /run/current-system,
#     ...) are judged on OWNER only. A symlink's mode and group gate
#     nothing on macOS -- the only way to change where it points is to
#     replace it, which its PARENT directory governs, and every parent is
#     itself on the walk. stat(1) defaults to lstat, so "$p" names the
#     link, not its target.
#
#   - /nix/store is the one legitimate group-writable ancestor: root-owned
#     1775 (sticky, group nixbld, mutations mediated by the nix-daemon;
#     store objects are immutable by construction). The acceptance is
#     keyed to the LITERAL path, so it can never relax the rule for
#     /usr/local or any other prefix.
verify_ancestor() {
  local p="$1"
  if [ -L "$p" ]; then
    local owner
    owner="$(stat -f '%Su' "$p")"
    [ "$owner" = "root" ] && return 0
    err_val "a symlink owned by $owner, expected root" "$p"
    return 1
  fi
  if [ "$p" = "/nix/store" ]; then
    local owner mode
    owner="$(stat -f '%Su' "$p")"
    mode="$(stat -f '%OMp%OLp' "$p")"
    [ "$owner" = "root" ] && [ "$mode" = "1775" ] && return 0
    err_val "owned $owner mode $mode, expected root-owned 1775" /nix/store
    return 1
  fi
  verify_root_owned_path "$p"
}

verify_ancestors() { # <path>: check every ancestor dir of <path>
  local p
  p="$(dirname "$1")"
  while [ "$p" != "/" ]; do
    verify_ancestor "$p" || return 1
    p="$(dirname "$p")"
  done
}

# Both chains of a program path must hold. A symlinked install path (the
# nix profile) textually walks mostly symlinks; the bytes live elsewhere,
# so the REAL location is walked too. Shared by the self-check below and
# by verify_helper -- the helper runs as root off an absolute path exactly
# the way this script does, and gets exactly the same walk.
verify_program_ancestry() { # <program path>
  local target="$1" real
  verify_ancestors "$target" || return 1
  real="$(readlink -f "$target")" || return 1
  if [ "$real" != "$target" ]; then
    verify_ancestors "$real" || return 1
  fi
}

verify_install_ancestry() {
  [ -f "$INSTALL_TARGET" ] || return 0   # pre-install; let other checks handle.
  verify_program_ancestry "$INSTALL_TARGET"
}
verify_install_ancestry || exit 1

# The helper is trusted positionally: root-owned, unwritable by anyone
# else, reached through an ancestry no non-root process can redirect. It
# carries no digest pin -- sudoers pins THIS script, the nix module bakes
# the store path into it, and a digest here would only move the question to
# who may edit the digest.
#
# Checked once per process and then memoised. It used to run per exec, on
# the reasoning that the window it opens is root-held; since node_id() the
# helper answers one question per record and `verify` walks every record,
# so a walk per call would be N full ancestry walks for an answer that
# cannot honestly differ between them. What memoising gives up is a change
# made to the helper's own ancestry mid-invocation -- a window measured in
# the lifetime of one `locked` run, which an already-open root-held window
# would not survive either.
HELPER_VERDICT=""   # "" not asked yet, 0 verified, 1 refused
verify_helper() {
  if [ -n "$HELPER_VERDICT" ]; then
    return "$HELPER_VERDICT"
  fi
  if verify_helper_now; then HELPER_VERDICT=0; else HELPER_VERDICT=1; fi
  return "$HELPER_VERDICT"
}

verify_helper_now() {
  if [ ! -f "$LOCKED_HELPER" ]; then
    err_val "window helper not found" "$LOCKED_HELPER"
    echo "         every verb needs it -- it opens the mediated window and it" >&2
    echo "         reads node identity (nix: rebuild; standalone: build" >&2
    echo "         helper/locked-helper.m and install it root-owned 755)" >&2
    return 1
  fi
  [ -x "$LOCKED_HELPER" ] || { err_val "window helper is not executable" "$LOCKED_HELPER"; return 1; }
  verify_root_owned_file "$LOCKED_HELPER" || return 1
  verify_program_ancestry "$LOCKED_HELPER" || return 1
  local real
  real="$(readlink -f "$LOCKED_HELPER")" || return 1
  if [ "$real" != "$LOCKED_HELPER" ]; then
    verify_root_owned_file "$real" || return 1
  fi
}

if [ -n "$lock_user" ]; then
  id -u "$lock_user" >/dev/null 2>&1 || {
    echo "lock account $lock_user does not exist -- run: sudo locked setup" >&2
    exit 1
  }
fi

# The per-user state dir, the pool inside it, and the verify status beside
# the pool. Layout (root converges it below):
#
#   $LOCKED_STATE_ROOT/      root:wheel 711
#     run.lock               root:wheel 600 (one root run at a time; see run_lock_take)
#     <user>/                root:_<user>-lock 750
#       pool/                _<user>-lock:_<user>-lock 750 (records, snapshots)
#       verify               root:_<user>-lock 640 (the last verify run)
USER_DIR=""
USER_POOL=""
if [ -n "$inv" ]; then
  USER_DIR="$LOCKED_STATE_ROOT/$inv"
  USER_POOL="$USER_DIR/pool"
fi

# One-shot conversion from the 0.14.0 layout, where each pool was
# $LOCKED_LEGACY_ROOT/<user> and there was no per-user dir around it. Each
# pool moves by rename into <user>/pool, then the emptied legacy root goes.
# It runs from the root convergence block, so the first root invocation
# after a deploy converts every user's pool -- the verify timer's own
# RunAtLoad run included -- and no verify ever walks an empty new layout
# while the records still sit at the old path. Nothing here merges: a pool
# at both paths refuses, and so does a move that would cross filesystems
# (mv would copy, dropping the atomic rename).
# TODO(0.16.0): remove, together with LOCKED_LEGACY_ROOT, once no 0.14.0
# layout remains.
convert_legacy_layout() {
  [ -e "$LOCKED_LEGACY_ROOT" ] || return 0
  local old name acct dest
  for old in "$LOCKED_LEGACY_ROOT"/*/; do
    old="${old%/}"
    name="$(basename "$old")"
    acct="${LOCKED_LOCK_ACCOUNT:-$(lock_account_for "$name")}"
    dest="$LOCKED_STATE_ROOT/$name"
    if [ -e "$dest/pool" ]; then
      echo "${E_RED}${E_B}✗ error:${E_OFF} a pool exists at both paths; move one by hand" >&2
      value_rows "  " legacy id "$old" pool id "$dest/pool" >&2
      return 1
    fi
    if [ "$(stat -f '%d' "$old")" != "$(stat -f '%d' "$LOCKED_STATE_ROOT")" ]; then
      echo "${E_RED}${E_B}✗ error:${E_OFF} the pool and the state root are on different filesystems; refusing a copying move" >&2
      value_rows "  " pool id "$old" "state root" id "$LOCKED_STATE_ROOT" >&2
      return 1
    fi
    install -d -m 750 -o root -g "$acct" "$dest" || return 1
    mv -- "$old" "$dest/pool" || return 1
    move_lines "moved a pool" "$old" "$dest/pool" >&2
    log_action convert "$old" "moved-to-$dest/pool"
  done
  rmdir -- "$LOCKED_LEGACY_ROOT" || {
    err_val "still holds entries after the move; look before removing it" "$LOCKED_LEGACY_ROOT"
    return 1
  }
  log_action convert "$LOCKED_LEGACY_ROOT" removed
}

# One root run at a time. Every root invocation -- a ceremony, the timer's
# verify, a verify by hand -- holds this lock from the convergence below
# until it exits. Without it, verify could read a record or a node halfway
# through a ceremony and report drift that is not there; two ceremonies
# could plan against one pool at once, so one releases a chain node the
# other's new leaf needs; and an older verify that finished last would
# overwrite a newer run's status. A run that finds the lock held says whose
# it is and waits.
#
# flock(2), not a lock dir: the kernel drops the lock when its last
# descriptor closes, so a killed run never leaves one behind. bash cannot
# flock, so perl takes the lock on fd 9, which this shell keeps open: the
# lock belongs to the open file, not to the perl process, and outlives it.
# The file is created 600 under umask 077 in a dir only root writes to, so
# no process running as the user can ever open it -- flock needs only a
# read descriptor, and one opened early could stall every root run for
# good. A child that runs as the user closes fd 9 (the editor), since a
# child that outlived us would keep the lock held.
LOCKED_RUN_LOCK="$LOCKED_STATE_ROOT/run.lock"

flock_fd9() { # <try|wait>: 0 locked, 1 held by another run (try only), 2 error
  env -i /usr/bin/perl -MFcntl=:flock -e '
    open(my $fh, ">&=", 9) or exit 2;
    my $op = LOCK_EX;
    $op |= LOCK_NB if $ARGV[0] eq "try";
    exit 0 if flock($fh, $op);
    exit($!{EWOULDBLOCK} ? 1 : 2);' -- "$1"
}

run_lock_take() {
  local mask rc=0 holder=""
  mask="$(umask)"
  umask 077
  exec 9>>"$LOCKED_RUN_LOCK" || { umask "$mask"; return 1; }
  umask "$mask"
  # Exactly root 600: a group or other READ bit is already enough to hold
  # the lock. Only root writes this dir, so anything else is root's doing;
  # stop rather than converge, since a descriptor opened while the mode was
  # wider would survive a chmod.
  if [ -L "$LOCKED_RUN_LOCK" ] || [ ! -f "$LOCKED_RUN_LOCK" ] ||
     [ "$(stat -f '%Su %OLp' "$LOCKED_RUN_LOCK")" != "root 600" ]; then
    err_val "not a root-owned 600 file; look at it, remove it, and run again" "$LOCKED_RUN_LOCK"
    return 1
  fi
  flock_fd9 try || rc=$?
  if [ "$rc" -eq 1 ]; then
    holder="$(head -c 200 "$LOCKED_RUN_LOCK" | LC_ALL=C tr -cd '[:print:]')" || holder=""
    echo "waiting for another locked run to finish${holder:+ ($holder)}" >&2
    rc=0
    flock_fd9 wait || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    err_val "could not take the run lock" "$LOCKED_RUN_LOCK"
    return 1
  fi
  printf 'pid %s: locked %s' "$$" "$action" >"$LOCKED_RUN_LOCK"
}

if [ "$EUID" -eq 0 ]; then
  # Root converges the layout on every invocation, so a deployment made by
  # an older version migrates itself with no separate command.
  # 711 on the state root is execute-only traversal: a user can reach the
  # one dir whose name they already know and cannot enumerate who else has
  # one. 750 on the per-user dir hands read to the owning lock group --
  # which the invoking user is a member of -- and to nobody else, so
  # another user's pool and status are refused by the kernel, not by our
  # checks. The per-user dir is root's: only root adds, renames or removes
  # its entries, so the verify status in it is exactly as trustworthy as
  # the root job that writes it.
  install -d -m 711 -o root -g wheel "$LOCKED_STATE_ROOT"
  run_lock_take || exit 1
  convert_legacy_layout || exit 1
  if [ -n "$USER_DIR" ]; then
    install -d -m 750 -o root -g "$lock_user" "$USER_DIR"
    install -d -m 750 -o "$lock_user" -g "$lock_user" "$USER_POOL"
    # Metas are the one class that goes group-readable (see write_meta);
    # sweep the ones an older version wrote at 600. nullglob makes the
    # array empty rather than literal when the pool has none yet.
    pool_metas=("$USER_POOL"/*.meta)
    if [ "${#pool_metas[@]}" -gt 0 ]; then
      chmod 640 "${pool_metas[@]}" || exit 1
    fi
  fi
elif [ -e "$LOCKED_STATE_ROOT" ] && [ ! -x "$LOCKED_STATE_ROOT" ]; then
  # A state root the caller cannot traverse would make every pool look
  # empty. Say what is actually wrong; one sudo run converges the mode.
  say_err "cannot read the state root (run 'sudo locked status' once to converge its mode)" "$LOCKED_STATE_ROOT"
  exit 1
elif [ -d "$USER_DIR" ] && { [ ! -r "$USER_DIR" ] || [ ! -x "$USER_DIR" ]; }; then
  # Unprivileged status skips the provisioning above deliberately rather
  # than letting a non-root `install -d -o` fail: nothing on this path may
  # create or modify anything. An unreadable per-user dir is the privacy
  # wall working as designed (the caller is not in that lock group, or is
  # probing someone else's pool) -- fail closed on one line instead of
  # letting every later glob and stat fail separately.
  echo "cannot read pool for $inv (not a member of $lock_user?)" >&2
  exit 1
fi

# ---- snapshot / replace machinery ------------------------------------------

# Atomic destination replace. Staging happens in the 700 lock-account-owned
# .staging dir, so the temp file is never visible to user-UID processes.
# Rename is atomic only on the same filesystem; refuse rather than fall back
# to a non-atomic copy. If the destination's parent carries uappnd/sappnd,
# lift the flag around the rename and restore it even on failure.
#
# The staging copy goes through the window helper's `copy` verb: it opens
# the source O_NOFOLLOW, verifies the identity handed to it here, and reads
# from the verified fd -- closing the old TODO(toctou) source-swap residual
# -- while COPYFILE_XATTR|COPYFILE_ACL carries what cp left behind, closing
# TODO(xattrs) for files. File FLAGS deliberately do not travel (the cp -p
# hazard that bit live in 66b5055: a copy of a sealed source arrived
# immutable and even root's chown got EPERM); the dest is created fresh,
# and meta owns flag state -- sealing re-applies it. TODO(parent-swap) on
# the dst side was already closed by same-fs staging + atomic rename under
# a chain-sealed parent.
#
# <src owner> is whose the source may be, and the helper asks it of the
# descriptor it reads from: root reads only a file the invoker owns, one
# sealed for them (the lock account's), or locked's own staging (root's)
# -- never a second name the invoker planted for somebody else's file. A
# hard link keeps its owner wherever it is linked, so the gate is the
# owner, not the link count. <src id> pins the source further, a record's
# identity or the one a plan saw; without it the live node's is taken.
#
# AR_ID is set to the identity of the staged file, which the rename makes
# the destination's: a caller flagging the installed file afterwards names
# that inode, so a name swapped in after the rename is refused rather than
# flagged.
AR_ID=""
atomic_replace() { # <src> <dst> <owner:group> <mode> <src owner> [<src id>]
  local src="$1" dst="$2" owner="$3" mode="$4" src_owner="$5" src_id="${6:-}"
  local stage_dir="$USER_POOL/.staging"
  install -d -m 700 -o "$lock_user" -g "$lock_user" "$stage_dir" || return 1
  local tmp
  AR_ID=""
  if [ -z "$src_id" ]; then
    src_id="$(node_id "$src")" || return 1
  fi
  verify_helper || return 1
  # The helper insists on creating the dest itself (O_EXCL), so hand it a
  # fresh name: mktemp reserves one, the unlink frees it, and nothing else
  # can take it in between -- the staging dir is root-provisioned mode 700.
  tmp="$(mktemp "${stage_dir}/replace.XXXXXX")" || return 1
  rm -f -- "$tmp" || return 1
  "$LOCKED_HELPER" copy --src "$src" --src-id "${src_id/./:}" \
    --owner "$src_owner" --as "$(reader_for "$src")" --dest "$tmp" \
    || { rm -f -- "$tmp" 2>/dev/null; return 1; }
  chown "$owner" "$tmp" || { rm -f -- "$tmp"; return 1; }
  chmod "$mode" "$tmp" || { rm -f -- "$tmp"; return 1; }
  AR_ID="$(node_id "$tmp")" || { rm -f -- "$tmp"; return 1; }
  local stage_dev dst_dev dst_parent
  dst_parent="$(dirname "$dst")"
  stage_dev="$(stat -f '%d' "$tmp")"
  dst_dev="$(stat -f '%d' "$dst_parent")"
  if [ "$stage_dev" != "$dst_dev" ]; then
    rm -f -- "$tmp"
    echo "${E_RED}${E_B}✗ error:${E_OFF} the destination is on a different filesystem from staging; refusing a non-atomic mv" >&2
    value_rows "  " destination id "$dst" staging id "$stage_dir" >&2
    return 1
  fi
  local pflags lifted=""
  pflags="$(flags_of "$dst_parent")"
  case ",$pflags," in
    *,uappnd,*) lifted=uappnd ;;
    *,sappnd,*) lifted=sappnd ;;
    *,uchg,*)
      # Inside a folder sealed as content, every directory is frozen with
      # uchg, and a rename into it needs the flag off for a moment. That
      # moment must give the invoker nothing: the lock account owns the
      # directory, no group or other write bit is set, and no ACL entry
      # exists that could grant one. Anything else is refused, not lifted.
      # An ACL that cannot be read counts as one that grants.
      local pacl=unreadable
      pacl="$(acl_entries "$dst_parent")" || pacl=unreadable
      if [ "$(stat -f '%Su' "$dst_parent")" != "$lock_user" ] ||
         [ $(( 0$(stat -f '%OLp' "$dst_parent") & 022 )) -ne 0 ] ||
         [ -n "$pacl" ]; then
        rm -f -- "$tmp"
        err_val "frozen (uchg) and not closed to you while open; refusing to lift it" "$dst_parent"
        return 1
      fi
      lifted=uchg
      ;;
  esac
  if [ -n "$lifted" ]; then
    chflags -- "no$lifted" "$dst_parent" || { rm -f -- "$tmp"; return 1; }
  fi
  local rc=0
  mv -f -- "$tmp" "$dst" || rc=1
  if [ -n "$lifted" ]; then
    chflags -- "$lifted" "$dst_parent" || {
      err_val "failed to restore $lifted; restore it by hand" "$dst_parent"
      rc=1
    }
  fi
  [ "$rc" -eq 0 ] || { rm -f -- "$tmp" 2>/dev/null || true; return 1; }
}

# stage_copy <src> <src owner> <src id>: a copy of one file in lock-account
# staging, read through the same owner gate as atomic_replace; prints its
# path. What root shows the invoker (a diff witness) or compares for them
# is read from such a copy, never from a path in the invoker's own space.
stage_copy() {
  local stage_dir="$USER_POOL/.staging" tmp
  install -d -m 700 -o "$lock_user" -g "$lock_user" "$stage_dir" || return 1
  verify_helper || return 1
  tmp="$(mktemp "${stage_dir}/copy.XXXXXX")" || return 1
  rm -f -- "$tmp" || return 1
  "$LOCKED_HELPER" copy --src "$1" --src-id "${3/./:}" --owner "$2" \
    --as "$(reader_for "$1")" --dest "$tmp" || { rm -f -- "$tmp" 2>/dev/null; return 1; }
  printf '%s\n' "$tmp"
}

# stage_tree <src> <src owner> <src id>: the folder counterpart, a copy in
# a fresh staging dir (the path printed is the copy; its parent is the
# caller's to remove). The helper's copy-tree verb walks the folder by
# descriptor and gates every node as a seal does: a directory, a file or a
# symlink, owned by <src owner>. Nothing it refuses is ever read, whatever
# was linked or renamed into the folder; cp -Rp read whatever was there.
# Data, extended attributes and ACLs travel; flags never do, and permission
# bits travel without set-user-id, set-group-id and sticky.
stage_tree() {
  local stage_dir="$USER_POOL/.staging" tmp
  install -d -m 700 -o "$lock_user" -g "$lock_user" "$stage_dir" || return 1
  verify_helper || return 1
  tmp="$(mktemp -d "${stage_dir}/tree.XXXXXX")" || return 1
  "$LOCKED_HELPER" copy-tree --src "$1" --src-id "${3/./:}" --owner "$2" \
    --as "$(reader_for "$1")" --dest "$tmp/tree" --chown "$lock_user:$lock_user" \
    || { rm -rf -- "$tmp"; return 1; }
  printf '%s\n' "$tmp/tree"
}

# reader_for <path>: the account the helper reads <path> as (its --as).
# A path in locked's own state is root's to read: nothing of yours is on
# the way. Anything else is read as you wherever you own the path, so the
# kernel checks your reach to it (the helper's open_parent).
reader_for() {
  case "$1" in
    "$LOCKED_STATE_ROOT"/*) printf 'root\n' ;;
    *) printf '%s\n' "$inv" ;;
  esac
}

# node_count <dir>: the nodes of the tree at <dir>, itself included, as a
# seal or an unseal of it with --recursive must reach them (the helper's
# --count). Counted by find, not by the helper's own walk, so a walk that
# strays reaches a number this did not, and the helper refuses before it
# changes the node that would have been one too many.
node_count() {
  local n
  n="$(find "$1" -print0 | LC_ALL=C tr -cd '\0' | wc -c)" || {
    err_val "cannot count the nodes in the tree" "$1"
    return 1
  }
  n="${n//[[:space:]]/}"
  [ "$n" -gt 0 ] || { err_val "counted no nodes in the tree" "$1"; return 1; }
  printf '%s\n' "$n"
}

# Directory snapshots: whole-tree copy under .snapdir, staged then swapped.
snapshot_tree() { # <src> <snapdir> <src owner> <src id>
  local snapdir="$2" copy tmp
  local stage_dir="$USER_POOL/.staging"
  copy="$(stage_tree "$1" "$3" "$4")" || return 1
  tmp="$(dirname "$copy")"
  if [ -d "$snapdir" ]; then
    local old
    old="$(mktemp -d "${stage_dir}/old.XXXXXX")" || return 1
    mv -f -- "$snapdir" "$old/prev" || return 1
    rm -rf -- "$old"
  fi
  mv -f -- "$tmp/tree" "$snapdir" || return 1
  rmdir -- "$tmp"
}

# ---- meta + node verification ----------------------------------------------

# Per-path snapshot locations.
snap_paths() { # sets ENC SNAP SNAPDIR ATTIC META for path $1
  ENC="$(encode "$1")"
  SNAP="$USER_POOL/${ENC}.snap"
  SNAPDIR="$USER_POOL/${ENC}.snapdir"
  ATTIC="$USER_POOL/${ENC}.attic"
  META="$USER_POOL/${ENC}.meta"
}

# ---- verify findings ----------------------------------------------------------
#
# verify_node reports what it finds as lines of
# `<word><TAB><weight><TAB><detail>`, one finding per line, and
# verify_rows draws them: the word first, in a field of known width, the
# path last, each detail on a line under it in the path's column
# (terminal-output Rows):
#
#   drift  /Users/me/.zshrc
#          owner jooize, expected _jooize-lock
#          mode 644, expected 444
#   open   /Users/me/.config/zsh
#          intentionally unlocked; relock with: sudo locked lock
#
# The words: drift, open (deliberately unlocked), info (a record locked
# repaired on its way to clean), note (a repair that needs root). The
# weight says what the detail is to the reader: a drift fact (what is
# wrong, what is missing) is what the reader decides from, so it prints
# plain, never dim (terminal-output, color roles). Context -- where a
# node was, a command to run next -- and every detail of the other words
# print dim, safe to skim.
#
# A finding carries RAW text: a path as its bytes (shq-quoted where it is
# part of a command), a record field as the record holds it. Nothing in
# it is escaped or styled when it is composed, because nothing there
# knows which stream will show it (a status row on stdout, a refusal on
# stderr). verify_rows escapes the whole detail as it draws it
# (untrusted-text), so a hidden character in a path or in a record field
# -- an owner, a flag word, an ACL entry, an id -- shows as its escape,
# in the palette of the fd it writes to (set_pal).

# vfind <word> <weight> <detail>: one finding on stdout. A backslash, a
# tab and a line feed in the detail are written \x5C, \x09 and \x0A, so the
# record stays one line of three tab-separated fields whatever the detail
# holds; verify_rows reads them back to the raw bytes before it escapes
# them. The replacements sit in variables: bash 3.2 keeps quotes in a
# quoted replacement literally.
vfind() {
  local bs='\' xbs='\x5C' xt='\x09' xn='\x0A' d="$3"
  d="${d//"$bs"/$xbs}"
  d="${d//$'\t'/$xt}"
  d="${d//$'\n'/$xn}"
  printf '%s\t%s\t%s\n' "$1" "$2" "$d"
}

# vline <word> <detail>: one finding, a fact. vctx <word> <detail>: a line
# of context under it.
vline() { vfind "$1" fact "$2"; }
vctx() { vfind "$1" context "$2"; }

# verify_unescape <text>: the bytes verify_escape wrote as \xHH, back as
# bytes (either case), so a path from a record can be escaped for display
# like any other.
verify_unescape() {
  env -i /usr/bin/perl -e '$_ = $ARGV[0]; s/\\x([0-9A-Fa-f]{2})/chr(hex($1))/ge; print' -- "$1"
}

# verify_rows <indent> [<path>]: draw the findings on stdin. With a path,
# each run of one word is a row, `<indent><word>  <path>`, its details
# under it. Without one -- the path already ends the row above, a status
# row or an error -- the details alone, at <indent>, a word other than
# drift leading its own detail (`info: ...`). A drift fact is plain, the
# rest dim. Each detail is read back to its raw bytes (%b undoes vfind,
# whose \x escapes are the only backslashes in the record) and escaped
# whole, its hidden escapes in reverse red resuming the line's style.
# Prints with set_pal, so a caller sends it to stderr with >&2 and it
# takes the colors of stderr.
verify_rows() {
  local ind="$1" p="" word wt det last="" ep col st
  set_pal
  if [ -n "${2:-}" ]; then
    esc_into ep "$2" "$P_RV"
    p=1
  fi
  col=$(( ${#ind} + 5 + 2 ))
  while IFS=$'\t' read -r word wt det; do
    [ -n "$word" ] || continue
    st="$P_DIM"
    if [ "$word" = "drift" ] && [ "$wt" = "fact" ]; then
      st=""
    fi
    printf -v det '%b' "$det"
    esc_into det "$det" "$P_RV" "$st"
    if [ -n "$p" ]; then
      if [ "$word" != "$last" ]; then
        printf '%s%-5s  %s\n' "$ind" "$word" "$ep"
        last="$word"
      fi
      printf '%*s%s%s%s\n' "$col" '' "$st" "$det" "${st:+$P_OFF}"
    elif [ "$word" = "drift" ]; then
      printf '%s%s%s%s\n' "$ind" "$st" "$det" "${st:+$P_OFF}"
    else
      printf '%s%s%s: %s%s\n' "$ind" "$st" "$word" "$det" "${st:+$P_OFF}"
    fi
  done
}

# A pre-0.6.0 record names its node by st_dev, a number the kernel may have
# handed to another volume at the last mount. The inode proves it is the
# same node, so the record is corrected rather than reported -- the drift a
# reboot invents is not drift. Root only: unprivileged status must never
# write a pool it can merely read (same rule as the trash finalization).
upgrade_identity_record() { # <path> <metafile> <live id>
  local f="$1" meta="$2" cur="$3"
  if [ "$EUID" -ne 0 ]; then
    vline note "identity in legacy dev.ino form; sudo locked status rewrites it"
    return 0
  fi
  if rewrite_meta_id "$meta" "$cur"; then
    vline info "identity record upgraded (dev.ino → volume uuid)"
    return 0
  fi
  vline drift "identity record could not be upgraded: $meta"
  return 1
}

# verify_node <path> <metafile> <lock_user>
# Prints its findings (see verify_rows); returns 0 clean/open, 1 drift.
verify_node() {
  local f="$1" meta="$2" lu="$3"
  local tier state flag flagsym mode lockmode owner group id recursive bin
  tier="$(meta_field "$meta" tier)"
  state="$(meta_field "$meta" state)"
  flag="$(meta_field "$meta" flag)"
  flagsym="$(meta_field "$meta" flagsym)"
  lockmode="$(meta_field "$meta" lockmode)"
  owner="$(meta_field "$meta" owner)"
  group="$(meta_field "$meta" group)"
  id="$(meta_field "$meta" id)"
  recursive="$(meta_field "$meta" recursive)"

  # A live record names what it is there for: a leaf you protected, or a
  # chain directory some leaf needs. Without that, no release can be planned
  # safely (plan_releases stops), so it is drift until the record says.
  if [ "$state" != "retired" ]; then
    case "$(meta_field "$meta" role)" in
      leaf|chain) ;;
      *)
        vline drift "record has no role (written before locked 0.13.0)"
        return 1
        ;;
    esac
    # The same for a placement record without its ACL entry: the directory
    # still has the pre-0.14.0 shape (lock group, group write), and a
    # release would have no entry to take off.
    if [ "$tier" = "placement" ] && [ -z "$(meta_field "$meta" acl)" ]; then
      vline drift "placement record has no ACL entry (written before locked 0.14.0)"
      return 1
    fi
  fi

  # Retired and suspended are checked before the existence test: for both,
  # the path being absent is the recorded expectation, not drift.
  if [ "$state" = "retired" ]; then
    # locked removed it, or a human asserted it was gone. The record stays
    # as the audit trail; the path is deliberately not stat'ed.
    return 0
  fi
  if [ "$state" = "suspended" ]; then
    bin="$(meta_field "$meta" bin)"
    if [ -e "$f" ] || [ -L "$f" ]; then
      vline drift "back from the trash and unsealed"
      if [ -n "$bin" ]; then
        vctx drift "it was in the bin at: $bin"
      fi
      vctx drift "relock it with: sudo locked lock $(shq "$f")"
      return 1
    fi
    if [ -n "$bin" ] && [ ! -e "$bin" ] && [ ! -L "$bin" ]; then
      # The bin entry is gone, so Put Back can no longer resurrect an
      # unsealed copy: the suspension has become a retirement. Root only --
      # unprivileged status must never try to write a pool it can read.
      if [ "$EUID" -ne 0 ]; then
        return 0
      fi
      if rewrite_meta_state "$meta" retired \
           "via=trash-finalized" \
           "by=$(meta_field "$meta" by)" \
           "at=$(now_utc)" \
           "bin=$bin"; then
        vline info "trashed item no longer in the bin; record retired"
        return 0
      fi
      vline drift "suspended, and its record could not be finalized: $meta"
      return 1
    fi
    return 0
  fi

  # -L as well as -e: a sealed symlink whose TARGET was removed is still
  # there as a node, and every check below is an lstat, so it is verifiable
  # exactly as before. Only -e would call it missing and report drift on a
  # node nothing touched.
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    vline drift "missing"
    return 1
  fi
  # An edit whose install check failed left a line on the record, and it
  # stays drift -- unlocked or not -- until an edit of that file installs
  # cleanly, or the record is sealed afresh (a relock or a revert). The
  # record holds the file's path as verify_escape wrote it; it is shown
  # as the characters it names.
  local mbad=0 mall mline mrest mat mwhat
  mall="$(mismatch_kv "$meta")"
  while [ -n "$mall" ]; do
    mline="${mall%%$'\n'*}"
    if [ "$mline" = "$mall" ]; then mall=""; else mall="${mall#*$'\n'}"; fi
    mrest="${mline#mismatch=}"
    mat="${mrest%% *}"
    mrest="${mrest#* }"
    mwhat="${mrest%% *}"
    vline drift "an edit at $mat did not install as approved ($mwhat): $(verify_unescape "${mrest#* }")"
    mbad=1
  done
  if [ "$state" = "unlocked" ]; then
    vline open "intentionally unlocked; relock with: sudo locked lock"
    return "$mbad"
  fi

  local bad="$mbad" want_owner cur
  case "$tier" in
    content|placement) want_owner="$lu" ;;
    anchor)            want_owner="$owner" ;;
    *) vline drift "meta has unknown tier '$tier'"; return 1 ;;
  esac
  cur="$(stat -f '%Su' "$f")"
  [ "$cur" = "$want_owner" ] || { vline drift "owner $cur, expected $want_owner"; bad=1; }
  cur="$(stat -f '%OLp' "$f")"
  [ "$cur" = "$lockmode" ] || { vline drift "mode $cur, expected $lockmode"; bad=1; }
  cur="$(flags_of "$f")"
  [ "$cur" = "$flagsym" ] || { vline drift "flags '$cur', expected '$flagsym'"; bad=1; }
  # Placement keeps the directory's own group, and lets the invoker in
  # through exactly the recorded entry (placement_entry). Either one
  # changing takes root, so either one changing is drift.
  if [ "$tier" = "placement" ]; then
    cur="$(stat -f '%Sg' "$f")"
    [ "$cur" = "$group" ] || { vline drift "group $cur, expected $group"; bad=1; }
    cur="$(meta_field "$meta" acl)"
    acl_has "$f" "$cur" || { vline drift "ACL entry missing or changed, expected '$cur'"; bad=1; }
  fi
  local sn=0
  if cur="$(node_id "$f")"; then
    same_node "$id" "$cur" || sn=$?
  else
    sn=3
  fi
  case "$sn" in
    0) ;;
    2) upgrade_identity_record "$f" "$meta" "$cur" || bad=1 ;;
    3) vline drift "identity could not be read (the window helper is unavailable)"; bad=1 ;;
    *) vline drift "identity $cur, expected $id (node replaced)"; bad=1 ;;
  esac

  # The first three stray nodes, read NUL-separated, so a name holding a
  # newline stays one path.
  if [ "$recursive" = "1" ] && [ -d "$f" ]; then
    local -a stray=()
    local sp
    while IFS= read -r -d '' sp; do
      stray+=("$sp")
      [ "${#stray[@]}" -lt 3 ] || break
    done < <(find "$f" \( ! -user "$lu" -o ! -flags +uchg \) -print0 2>/dev/null)
    if [ "${#stray[@]}" -gt 0 ]; then
      vline drift "tree nodes without lock ownership or uchg:"
      for sp in "${stray[@]}"; do
        vline drift "  $sp"
      done
      bad=1
    fi
  fi
  return "$bad"
}

# ---- chain derivation ------------------------------------------------------

# ~ and ~/.ssh are identity-checked by the OS against the user's UID (sshd
# StrictModes, ssh client config-ownership checks), so they must never leave
# the user's ownership: anchor tier, not placement.
tier_for_ancestor() {
  if [ "$1" = "$user_home" ] || [ "$1" = "$user_home/.ssh" ]; then
    echo anchor
  else
    echo placement
  fi
}

# chain_skips_parent <leaf>: true when the leaf's own parent is left out of
# the chain. Every walk asks this one question, so the derivation, the
# unlock --chain release and the status print cannot drift apart.
#
# A node is held in place by one of exactly two things: its own flag -- XNU
# refuses unlink and rename of a vnode carrying IMMUTABLE or APPEND -- or an
# append-only parent, since entries of such a directory cannot be removed or
# renamed. The leaf holds itself (uchg, or the anchor's system flag); the
# leaf's parent is held by the grandparent's uappnd; every ancestor above
# that needs its own flag for its own entry, and that same flag pins the
# entry below it. So a placement seal on the leaf's parent added nothing at
# all to the leaf's protection -- and it broke the software that owns that
# directory. Claude Code takes its OAuth refresh lock with
# `mkdir ~/.claude/.oauth_refresh.lock` and releases it with `rmdir`, which
# uappnd refuses: the stale lock could never be cleared, token refresh
# failed, and the user was logged out at every expiry (observed 2026-09-15,
# the lock dir dated minutes after the seal). Every temp+rename save in that
# directory stranded its temp for the same reason.
#
# The ANCHOR is the exception, and stays in the chain wherever it sits. It
# never changes ownership and is never released, so it costs its owner
# nothing; and under this very rule its sappnd is what holds the leaf
# parents one level down -- ~/.claude, ~/.config -- in place. Skipping it
# because a leaf happens to sit directly in ~ (every shell startup file
# does) would take the load-bearing node out of every chain below it.
#
# Known cost, accepted: a non-root mount needs a user-owned mountpoint, so
# a user-owned leaf parent can be shadowed by a mount. $HOME -- anchor
# tier, never re-owned -- already can, so that whole class is closed by a
# mount-table check and not by this tier.
chain_skips_parent() { # <leaf>
  [ "$(tier_for_ancestor "$(dirname "$1")")" != "anchor" ]
}

# chain_for <leaf>: prints user-owned/lock-owned ancestors nearest-first,
# the leaf's own parent omitted per chain_skips_parent, then validates the
# stop node (first foreign-owned ancestor) is root-owned. Fails closed if it
# is not.
#
# The walk still STARTS at the parent even when that node is not printed:
# the stop-node check has to see the first foreign-owned ancestor wherever
# it sits, and on a leaf directly under /Users that is the parent itself.
chain_for() {
  local p owner skip=0
  p="$(dirname "$1")"
  if chain_skips_parent "$1"; then skip=1; fi
  while :; do
    owner="$(stat -f '%Su' "$p")"
    if [ "$owner" = "$inv" ] || [ "$owner" = "$lock_user" ]; then
      if [ "$skip" -eq 1 ]; then
        skip=0
      else
        printf '%s\n' "$p"
      fi
      [ "$p" = "/" ] && break
      p="$(dirname "$p")"
    else
      verify_root_owned_path "$p" || {
        err_val "the chain stop node is not a trustworthy anchor; refusing" "$p"
        return 1
      }
      break
    fi
  done
}

# record_live <metafile>: true when the record still answers for a node --
# locked, unlocked, or suspended in the trash. A retired record is history:
# the audit trail of a node locked no longer holds, so sealing that path
# again is a first seal, not a relock (identity from the live node, a fresh
# snapshot), and every "is it in the pool" question reads it as absent.
record_live() { # <metafile>
  [ -f "$1" ] || return 1
  case "$(meta_field "$1" state)" in
    locked|unlocked|suspended) return 0 ;;
  esac
  return 1
}

# ---- the needed set --------------------------------------------------------
#
# The pool is what you asked to protect. A leaf record (role=leaf) is a
# node you named with lock; a chain record (role=chain) is a directory
# sealed only because some leaf needs it. So the chain nodes a pool needs
# are exactly the union of chain_for over its live leaves, and a chain
# record outside that union protects nothing: every gated verb plans its
# release, and the plan shows it before the one question.
#
# Suspended leaves still count: Put Back can return them to the path their
# chain pins. Seals are NOT computed here -- they stay with the verb's own
# leaves, because re-sealing another leaf's chain would close the window an
# `unlock --chain` deliberately left open.
#
# Fails closed. A release is never planned on incomplete knowledge: a live
# record with no role (written before roles existed) or a leaf whose chain
# cannot be derived empties the plan and says why.

RELEASE_PATHS=()
RELEASE_HOLDERS=()

# in_lines <line> <list>: true when <line> is one of the newline-separated
# lines of <list>, matched literally (the pattern is quoted, so a path with
# glob characters is just a path).
in_lines() {
  case $'\n'"$2"$'\n' in
    *$'\n'"$1"$'\n'*) return 0 ;;
  esac
  return 1
}

# plan_releases <exclude> <add>: fill RELEASE_PATHS (deepest first) with the
# live chain records nothing needs once the leaves in <exclude> are gone and
# those in <add> are protected; both are newline-separated path lists.
# RELEASE_HOLDERS holds the matching reason for each: empty when no
# protected file needs the directory, or the parent that keeps it in place.
plan_releases() {
  local exclude="$1" add="$2" meta q st role leaves="" needed="" c cands l held
  RELEASE_PATHS=()
  RELEASE_HOLDERS=()
  for meta in "$USER_POOL"/*.meta; do
    [ -f "$meta" ] || continue
    record_live "$meta" || continue
    q="$(decode "$(basename "$meta" .meta)")"
    role="$(meta_field "$meta" role)"
    case "$role" in
      leaf) ;;
      chain) continue ;;
      *)
        say_err "${E_YEL}note:${E_OFF} no directory is released this run; this record has no role" "$q"
        echo "      (written before locked 0.13.0; convert the pool first)" >&2
        return 0
        ;;
    esac
    if in_lines "$q" "$exclude"; then
      continue
    fi
    leaves="$leaves$q"$'\n'
  done
  leaves="$leaves$add"

  # fd 3, not stdin, for the reason given in do_lock_one.
  while IFS= read -r q <&3; do
    [ -n "$q" ] || continue
    if ! c="$(chain_for "$q" 2>/dev/null)"; then
      say_err "${E_YEL}note:${E_OFF} no directory is released this run; this leaf's chain cannot be derived" "$q"
      return 0
    fi
    needed="$needed$c"$'\n'
  done 3<<EOF
$leaves
EOF

  # The live chain records, deepest first. An if below, not a case, and no
  # comment inside the substitution: /bin/bash 3.2 ends a $( ... ) at the
  # first unbalanced paren it scans, a case pattern's included.
  cands="$(
    for meta in "$USER_POOL"/*.meta; do
      [ -f "$meta" ] || continue
      [ "$(meta_field "$meta" role)" = "chain" ] || continue
      st="$(meta_field "$meta" state)"
      if [ "$st" != "locked" ] && [ "$st" != "unlocked" ]; then
        continue
      fi
      printf '%s\n' "$(decode "$(basename "$meta" .meta)")"
    done | sort -r
  )"
  while IFS= read -r q <&3; do
    [ -n "$q" ] || continue
    # A node this very run names as a leaf is claimed, not released.
    if in_lines "$q" "$needed" || in_lines "$q" "$add"; then
      continue
    fi
    # The reason a reader needs: a directory that still holds a protected
    # file reads as if that file needed it, so say what holds it instead.
    held=0
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      if [ "$(dirname "$l")" = "$q" ]; then
        held=1
        break
      fi
    done <<EOF
$leaves
EOF
    RELEASE_PATHS+=("$q")
    if [ "$held" -eq 1 ]; then
      RELEASE_HOLDERS+=("$(dirname "$q")")
    else
      RELEASE_HOLDERS+=("")
    fi
  done 3<<EOF
$cands
EOF
  return 0
}

# ---- plan rows --------------------------------------------------------------
#
# One plan row per node (terminal-output Rows): the action, then -- when the
# plan has one -- a qualifier column of fixed words, blank on a row without
# one, then the path, which ends its line. A qualifier that is a sentence,
# or names a path of its own, goes on a dim line under the row, starting in
# the path's column. The release reasons are the qualifier words:
#   release  unused  /Users/me/.config/old
#   release  kept    /Users/me/.config
#                    its parent keeps it in place: /Users/me

# dispw <text>: the columns <text> takes, counting `→` as one, as Ghostty
# draws it. Every other cell text here is ASCII, so the rest is bytes.
dispw() {
  local LC_ALL=C t
  t="${1//→/}"
  printf '%s' $(( ${#t} + (${#1} - ${#t}) / 3 ))
}

# cell <width> <text>: <text> padded out to <width> columns.
cell() {
  local n
  n="$(dispw "$2")"
  printf '%s%*s' "$2" $(( $1 > n ? $1 - n : 0 )) ''
}

# plan_row <indent> <action width> <action> <qualifier width> <qualifier>
# <path> [dim]: one plan row on stderr. A qualifier width of 0 means the
# plan has no qualifier column.
plan_row() {
  local on="" off="" p
  if [ -n "${7:-}" ]; then on="$E_DIM" off="$E_OFF"; fi
  esc_into p "$6" "$E_RV" "$on"
  {
    printf '%s%s%s  ' "$on" "$1" "$(cell "$2" "$3")"
    [ "$4" -eq 0 ] || printf '%-*s  ' "$4" "$5"
    printf '%s%s\n' "$p" "$off"
  } >&2
}

# plan_col <indent> <action width> <qualifier width>: the column the plan's
# paths start in, where a note under a row starts too.
plan_col() {
  local c=$(( ${#1} + $2 + 2 ))
  [ "$3" -eq 0 ] || c=$(( c + $3 + 2 ))
  printf '%s' "$c"
}

# note_row <column> <text>: a row's qualifier sentence, dim, on a line of
# its own under the row, starting in the path's column. The path ends its
# line, so what qualifies it cannot follow it there.
note_row() {
  local t
  esc_into t "$2" "$E_RV" "$E_DIM"
  printf '%*s%s%s%s\n' "$1" '' "$E_DIM" "$t" "$E_OFF" >&2
}

# release_qual <i>: the qualifier word for RELEASE_PATHS[i].
release_qual() {
  if [ -n "${RELEASE_HOLDERS[$1]}" ]; then printf 'kept'; else printf 'unused'; fi
}

# release_qwidth: the width of the qualifier column the planned releases
# need, 0 with none planned.
release_qwidth() {
  local i=0 w=0 q
  while [ "$i" -lt "${#RELEASE_PATHS[@]}" ]; do
    q="$(release_qual "$i")"
    [ "${#q}" -le "$w" ] || w="${#q}"
    i=$((i + 1))
  done
  printf '%s' "$w"
}

# release_rows <indent> <action width> <qualifier width>: the plan rows for
# RELEASE_PATHS, root-most first like every other plan row.
release_rows() {
  local ind="$1" w="$2" qw="$3" i
  i=$((${#RELEASE_PATHS[@]} - 1))
  while [ "$i" -ge 0 ]; do
    plan_row "$ind" "$w" release "$qw" "$(release_qual "$i")" "${RELEASE_PATHS[$i]}"
    if [ -n "${RELEASE_HOLDERS[$i]}" ]; then
      note_row "$(plan_col "$ind" "$w" "$qw")" \
        "its parent keeps it in place: ${RELEASE_HOLDERS[$i]}"
    fi
    i=$((i - 1))
  done
}

# apply_releases: run the planned releases, deepest first.
apply_releases() {
  local i=0
  while [ "$i" -lt "${#RELEASE_PATHS[@]}" ]; do
    release_chain_node "${RELEASE_PATHS[$i]}" || return 1
    i=$((i + 1))
  done
}

# ---- diff witness ----------------------------------------------------------

# The diff witness renders candidate bytes, so it must not let those bytes
# talk to the terminal. Every diff is git_diff's, which asks git for no
# color, and the capture goes through UNTRUSTED_PL in its lines mode (see
# third-party text at the top), which is the only thing in the block that
# emits an escape -- so any escape on screen is locked's own.
#
# The engine is git, not diff(1). /usr/bin/diff is FreeBSD's and splits a
# line at a lone carriage return: `a<CR>b` changed to `a<CR>X` reads as an
# unchanged `a` above `-b` and `+X`, a diff whose structure is wrong
# before anything renders it. git splits at line feeds only. Its -r also
# follows symbolic links, so a link in a folder being relocked showed, to
# root, the content of whatever it pointed at; git shows the link text.

# verify_git: the git LOCKED_GIT names is root-owned, unwritable by anyone
# else and reached through an ancestry no non-root process can redirect --
# the walk verify_helper makes of the window helper, here on every diff.
# A hand install with no git at that path refuses, naming the path last.
verify_git() {
  if [ ! -f "$LOCKED_GIT" ] || [ ! -x "$LOCKED_GIT" ]; then
    err_val "git not found (a hand install needs the command line tools)" "$LOCKED_GIT"
    return 1
  fi
  verify_root_owned_file "$LOCKED_GIT" || return 1
  verify_program_ancestry "$LOCKED_GIT" || return 1
  local real
  real="$(readlink -f "$LOCKED_GIT")" || return 1
  if [ "$real" != "$LOCKED_GIT" ]; then
    verify_root_owned_file "$real" || return 1
  fi
}

# What git_diff hands its output to: git's patch in, locked's diff out, in
# the shape diff -u --label wrote and the lines mode of UNTRUSTED_PL reads.
# Perl rather than awk, because awk ends a line at a NUL and git prints
# one raw in a text diff when it sits past the first 8000 bytes; perl
# reads bytes and keeps all of them.
#
# Each file section's header block (`diff --git`, mode and `index` lines,
# `---`/`+++` naming paths) becomes `--- <label>` and `+++ <label>`: the
# caller's label for the operand itself, the label plus the path below
# it for a file inside an operand that is a folder, `/dev/null` for the
# side of a file that exists on one side only (an operand that IS
# /dev/null takes the caller's label), and ` (symlink)` after a side that
# is a symbolic link. In a folder diff each section opens on `diff
# <path below the folder>`, which is what tells the lines mode a new file
# begins; a file diff has one section and no such line, as before. A
# `Binary files` line names the labels. A hunk header ends at its closing
# `@@`, without the function context git appends. A section that only
# changes a mode is not content and is left out, as diff -r left it out;
# an empty file that exists on one side only is a header pair with no
# hunk.
#
# Names arrive as git writes them: a name holding a control character,
# `"`, `\` or a byte past ASCII comes in double quotes with C escapes,
# which this decodes exactly; any other comes bare, and a bare name with
# a space carries a tab after it on the ---/+++ lines. A bare name cannot
# be split from its neighbor by looking alone (`Binary files A and B
# differ` with an ` and ` in a name), so each one is matched against the
# operand it has to start with. A name that does not, a name with a line
# feed (it would break the header it stands on into two lines), or any
# line this does not know is trouble.
#
# FAIL CLOSED: nothing is printed until all of the input has parsed. The
# exit status answers in git's terms from what was read -- 0 for no
# input, 1 for a diff printed, 3 for sections that were all mode changes
# -- and 2 for anything else, with nothing printed and one line on stderr
# saying why, in locked's own words. Read from GD_OLD,
# GD_NEW (the operands as passed to git) and GD_OLD_LABEL, GD_NEW_LABEL.
# A single-quoted bash string, like UNTRUSTED_PL, so it holds no single
# quote.
# shellcheck disable=SC2016  # the single quotes are the point: no expansion
readonly GIT_DIFF_PL='
use strict;
binmode(STDIN);
binmode(STDOUT);
my ($old, $new, $lo, $ln) = map { defined $ENV{$_} ? $ENV{$_} : exit 2 }
  qw(GD_OLD GD_NEW GD_OLD_LABEL GD_NEW_LABEL);
my $ea = "a/" . substr($old, 1);
my $eb = "b/" . substr($new, 1);
my %ce = (a => "\a", b => "\b", t => "\t", n => "\n", v => "\013", f => "\f",
  r => "\r", "\"" => "\"", "\\" => "\\");
# bad [<reason>]: stop, saying why on stderr; nothing has been printed.
sub bad {
  print STDERR (@_ ? $_[0] : "git printed something that is not a diff locked can read"), "\n";
  exit 2;
}
# cq <text>: the C-quoted name at the start of <text>, decoded, and what
# follows its closing quote; () when it is not one.
sub cq {
  my $s = shift;
  my $o = "";
  return () unless $s =~ s/\A"//;
  while (1) {
    if ($s =~ s/\A([^"\\]+)//) { $o .= $1; }
    elsif ($s =~ s/\A"//) { return ($o, $s); }
    elsif ($s =~ s/\A\\([0-3][0-7][0-7])//) { $o .= chr(oct($1)); }
    elsif ($s =~ s/\A\\([abtnvfr"\\])//) { $o .= $ce{$1}; }
    else { return (); }
  }
}
# whole <text>: <text> as one name, quoted or bare; undef when it is not.
# git quotes every name holding anything outside printable ASCII, a
# double quote or a backslash, so a bare one holds none of them.
sub whole {
  my $s = shift;
  if ($s =~ /\A"/) {
    my ($n, $r) = cq($s);
    return (defined $n && $r eq "") ? $n : undef;
  }
  return $s =~ /\A[\x20\x21\x23-\x5B\x5D-\x7E]+\z/ ? $s : undef;
}
# name1 <text>: the name on a ---/+++ line, a tab after it allowed.
sub name1 {
  my $s = shift;
  if ($s =~ /\A"/) {
    my ($n, $r) = cq($s);
    return (defined $n && ($r eq "" || $r eq "\t")) ? $n : undef;
  }
  $s =~ s/\t\z//;
  return whole($s);
}
# side <name> <a|b> <mode>: the label for one side and the path below
# its operand ("" for the operand itself, undef for an absent side); ()
# when the name is not one this diff can hold.
sub side {
  my ($p, $w, $m) = @_;
  my ($op, $e, $l) = $w eq "a" ? ($old, $ea, $lo) : ($new, $eb, $ln);
  return () unless defined $p;
  return ($op eq "/dev/null" ? $l : "/dev/null", undef) if $p eq "/dev/null";
  my $rel;
  if ($p eq $e) { $rel = ""; }
  elsif (substr($p, 0, length($e) + 1) eq "$e/") { $rel = substr($p, length($e)); }
  else { return (); }
  bad("a name in it holds a line feed, which a diff header cannot show") if $rel =~ /\n/;
  return ($l . $rel . ((defined $m && $m eq "120000") ? " (symlink)" : ""), $rel);
}
my @out;
my $st = "";
my ($git, $ma, $mb, $nf, $df, $al, $ar);
my ($seen, $shown, $files) = (0, 0, 0);
# rel2 <rel a> <rel b>: the path a section is about; both sides agree.
sub rel2 {
  my ($x, $y) = @_;
  bad() unless defined $x || defined $y;
  return $y unless defined $x;
  return $x unless defined $y;
  bad() unless $x eq $y;
  return $x;
}
# head <rel>: a section opens. One about an operand itself stands alone;
# one about a file below a folder opens on its diff line.
sub head {
  my $rel = shift;
  my $two = "git compared two files where locked handed it one";
  if ($rel eq "") { bad($two) if $shown; $files++; }
  else { bad($two) if $files; push @out, "diff " . substr($rel, 1) . "\n"; }
  $shown++;
}
# pair <text>: the two names of a Binary files line, between its words.
sub pair {
  my $s = shift;
  my ($x, $r);
  if ($nf) {
    return () unless $s =~ s/\A\/dev\/null and //;
    return ("/dev/null", whole($s));
  }
  if ($df) {
    return () unless $s =~ s/ and \/dev\/null\z//;
    return (whole($s), "/dev/null");
  }
  if ($s =~ /\A"/) {
    ($x, $r) = cq($s);
    return () unless defined $x && $r =~ s/\A and //;
    return ($x, whole($r));
  }
  my $i = index($s, qq{ and "});
  return (whole(substr($s, 0, $i)), whole(substr($s, $i + 5))) if $i >= 0;
  my $n = length($s) - length($ea) - length($eb) - 5;
  return () if $n < 0 || $n % 2;
  my $rel = substr($s, length($ea), $n / 2);
  return () unless $s eq "$ea$rel and $eb$rel";
  return ("$ea$rel", "$eb$rel");
}
# A header with no ---/+++ pair and no Binary line: an empty file on one
# side only, named by its diff --git line (one name twice), or a mode
# change, which is left out.
sub close_hdr {
  return unless $st eq "hdr";
  return unless $nf || $df;
  my ($x, $y, $r);
  if ($git =~ /\A"/) {
    ($x, $r) = cq($git);
    bad() unless defined $x && $r =~ s/\A //;
    $y = whole($r);
  } else {
    my $n = length($git) - 5;
    bad() if $n < 2 || $n % 2;
    my $p = substr($git, 2, $n / 2);
    bad() unless $git eq "a/$p b/$p" && defined whole($p);
    ($x, $y) = ("a/$p", "b/$p");
  }
  my ($l1, $r1) = $nf ? side("/dev/null", "a") : side($x, "a", $ma);
  my ($l2, $r2) = $nf ? side($y, "b", $mb) : side("/dev/null", "b");
  bad() unless defined $l1 && defined $l2;
  head(rel2($r1, $r2));
  push @out, "--- $l1\n", "+++ $l2\n";
}
local $/;
my $in = <STDIN>;
exit 0 if !defined $in || $in eq "";
bad() unless $in =~ /\n\z/;
for my $line ($in =~ /[^\n]*\n/g) {
  my $t = substr($line, 0, -1);
  if ($t =~ /\Adiff --git (.+)\z/s) {
    bad() if $st eq "minus" || $st eq "plus";
    close_hdr();
    ($git, $ma, $mb, $nf, $df, $al, $ar) = ($1, undef, undef, 0, 0, undef, undef);
    $st = "hdr";
    $seen++;
    next;
  }
  bad() if $st eq "";
  if ($st eq "hdr") {
    if ($t =~ /\Aold mode ([0-7]+)\z/) { $ma = $1; }
    elsif ($t =~ /\Anew mode ([0-7]+)\z/) { $mb = $1; }
    elsif ($t =~ /\Adeleted file mode ([0-7]+)\z/) { $ma = $1; $df = 1; }
    elsif ($t =~ /\Anew file mode ([0-7]+)\z/) { $mb = $1; $nf = 1; }
    elsif ($t =~ /\Aindex [0-9a-f]+\.\.[0-9a-f]+(?: ([0-7]+))?\z/) {
      ($ma, $mb) = ($1, $1) if defined $1;
    }
    elsif ($t =~ /\A--- (.*)\z/s) {
      ($al, $ar) = side(name1($1), "a", $ma);
      bad() unless defined $al;
      $st = "minus";
    }
    elsif ($t =~ /\ABinary files (.*) differ\z/s) {
      my ($x, $y) = pair($1);
      my ($l1, $r1) = side($x, "a", $ma);
      my ($l2, $r2) = side($y, "b", $mb);
      bad() unless defined $l1 && defined $l2;
      head(rel2($r1, $r2));
      push @out, "Binary files $l1 and $l2 differ\n";
      $st = "bin";
    }
    else { bad(); }
    next;
  }
  if ($st eq "minus") {
    bad() unless $t =~ /\A\+\+\+ (.*)\z/s;
    my ($l2, $r2) = side(name1($1), "b", $mb);
    bad() unless defined $l2;
    head(rel2($ar, $r2));
    push @out, "--- $al\n", "+++ $l2\n";
    $st = "plus";
    next;
  }
  if ($t =~ /\A(\@\@ -[0-9]+(?:,[0-9]+)? \+[0-9]+(?:,[0-9]+)? \@\@)(?: |\z)/) {
    bad() unless $st eq "plus" || $st eq "body";
    push @out, "$1\n";
    $st = "body";
    next;
  }
  bad() unless $st eq "body" && $t =~ /\A[ +\\-]/;
  push @out, $line;
}
bad() if $st eq "minus" || $st eq "plus";
close_hdr();
exit($seen ? 3 : 2) unless @out;
print STDOUT @out or exit 2;
close(STDOUT) or exit 2;
exit 1;
'

# git_diff <old> <new> <old-label> <new-label>: the unified diff of two
# files or two folders, labeled, on stdout. 0 for no difference, 1 for a
# diff, 2 for trouble, so it reads as diff's own answer.
#
# git is started the way nothing it reads can choose what it does: an
# empty environment but for PATH and HOME=/var/empty, no global or system
# config, attributes from the empty tree, no fsmonitor, --no-ext-diff and
# --no-textconv, no color, no pager, no rename pairing (an added and a
# removed file stay what they are), the a/ b/ prefixes spelled out, and
# run from /, which is root's and has nothing above it, so no repository
# config or .gitattributes is found from wherever locked was started.
# --no-index needs no repository; both operands are absolute paths. git
# compares a symbolic link as its link text, at the top as well as inside
# a folder. Perl, the rewriter, gets an empty environment too.
#
# FAIL CLOSED: git answers 1 both for "different" and for an error (an
# operand it cannot open), and it can die halfway through a folder with
# half a diff already printed. So the answer is accepted only when git's
# status, the rewriter's verdict (see GIT_DIFF_PL) and git's silence on
# stderr agree: 0 and 0, 1 and 1, or 1 and 3 (modes only, no difference
# in content), and nothing on stderr. Anything else returns 2: what git
# wrote to stderr is shown escaped, its own words being bytes off the
# candidate's names, and stdout holds nothing, since the rewriter prints
# only a diff it parsed whole. Statuses come from PIPESTATUS, so callers
# run it as the left side of a || list, as show_diff does.
git_diff() { # <old> <new> <old-label> <new-label>
  local errf st dcolor
  case "$1:$2" in
    /*:/*) ;;
    *) err_val "internal error: git_diff takes absolute paths" "$1"; return 2 ;;
  esac
  verify_git || return 2
  errf="$(mktemp "${TMPDIR:-/tmp}/locked-diff.XXXXXX")" || return 2
  env -i PATH="$PATH" HOME=/var/empty \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    "$LOCKED_GIT" -C / --no-pager \
    -c attr.tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -c core.fsmonitor=false \
    diff --no-index --no-color --no-ext-diff --no-textconv --no-renames \
    --src-prefix=a/ --dst-prefix=b/ -U3 -- "$1" "$2" 2>"$errf" \
    | env -i GD_OLD="$1" GD_NEW="$2" GD_OLD_LABEL="$3" GD_NEW_LABEL="$4" \
      /usr/bin/perl -e "$GIT_DIFF_PL"
  st="${PIPESTATUS[0]}:${PIPESTATUS[1]}"
  [ -s "$errf" ] && st="stderr"
  case "$st" in
    0:0|1:3) rm -f -- "$errf"; return 0 ;;
    1:1)     rm -f -- "$errf"; return 1 ;;
  esac
  if [ "$st" = stderr ]; then
    dcolor=0; [ -n "$E_OFF" ] && dcolor=1
    diff_filter "$dcolor" 0 <"$errf" >&2 || true
  elif [ "${st#*:}" != 2 ]; then
    # Silent on stderr, and still an answer that does not fit what it
    # printed. The rewriter has already said why when it is the one
    # that refused (2).
    echo "git's exit status and its output disagree (git:reader $st)" >&2
  fi
  rm -f -- "$errf"
  return 2
}
#
# diff_filter <1|0> [<1|0>]: stdin to stdout, every hidden character
# escaped, the diff painted when the first argument says color is on. With
# the second at 1, a file whose line endings are CRLF gets a `CRLF line
# endings` header line and draws its pairs as plain breaks; at 0, every
# carriage return shows escaped.
diff_filter() { env -i /usr/bin/perl -e "$UNTRUSTED_PL" -- lines "$1" "${2:-0}"; }

# Diff-witness display, shared by the three diff sites (content relock,
# anchor relock, edit), each handing it the two sides and their labels
# for git_diff. Capture FIRST: a diff that fails must abort before its
# content is presented as reviewable -- exit 1 is "differs", anything
# above is trouble, and trouble shows none of the output: only the
# subject path, then what git_diff said about why (escaped already, and
# the missing or untrusted git path last when that is the cause). Into a
# temp file, not a variable: a tree diff can be large and hold NULs. The
# capture is then encoded into a second file and only the encoded one is
# ever shown; a filter that cannot run refuses the display rather than
# falling back to raw bytes. Line count comes off the encoded file, which
# is what the gate is about to page. Short output
# prints inline; long output on a tty is announced by a gate and
# paged (less -RF; an early pager quit is not an error), plain cat off-tty.
# The header starts FLUSH -- the caller owns any blank line before this
# block. A diff that was shown ends with a closing rule: the diff is the
# candidate's bytes, and a soft-wrapped line of it restarts at column 0,
# where it could pose as one of the rows or the question below
# (terminal-output, third-party text has no position).
show_diff() { # <rule> <row label> <path> <old> <new> <old-label> <new-label> [<via label> <via path>]
  local label="$1" rowlabel="$2" path="$3" raw enc why rc=0 lines dcolor shown=0
  local vialabel="${8:-}" viapath="${9:-}"
  shift 3
  raw="$(mktemp "${TMPDIR:-/tmp}/locked-diff.XXXXXX")" || return 1
  enc="$(mktemp "${TMPDIR:-/tmp}/locked-diff.XXXXXX")" || { rm -f -- "$raw"; return 1; }
  why="$(mktemp "${TMPDIR:-/tmp}/locked-diff.XXXXXX")" || { rm -f -- "$raw" "$enc"; return 1; }
  git_diff "$1" "$2" "$3" "$4" >"$raw" 2>"$why" || rc=$?
  if [ "$rc" -gt 1 ]; then
    err_val "diff failed" "$path"
    cat -- "$why" >&2
    rm -f -- "$raw" "$enc" "$why"
    return 1
  fi
  rm -f -- "$why"
  diff_header "$label" "$rowlabel" "$path" "$vialabel" "$viapath"
  if [ "$rc" -eq 0 ]; then
    echo "(no changes)"
    rm -f -- "$raw" "$enc"
    return 0
  fi
  # P_OFF is empty exactly when set_pal found no tty on this fd or NO_COLOR
  # set, so the filter paints on the same condition the rest of the block
  # colors on, including when the caller redirected fd 1. A CRLF file's
  # line endings are stated per file, on a header line of its own inside
  # the diff (untrusted-text), so the line count below includes it.
  dcolor=0; [ -n "$P_OFF" ] && dcolor=1
  if ! diff_filter "$dcolor" 1 <"$raw" >"$enc"; then
    err_val "cannot render the diff; not showing it unescaped" "$path"
    rm -f -- "$raw" "$enc"
    return 1
  fi
  rm -f -- "$raw"
  lines="$(wc -l <"$enc" | tr -d ' ')"
  if [ -t 0 ] && [ -t 1 ] && [ "$lines" -gt 24 ]; then
    # Three weights, one per job (terminal-output): bold runs to the `;`
    # because that clause IS the decision, the mechanics after it are plain so the bold has something to stand against, and the
    # tail is dim because it is the alternative, not the offer. Both keys the
    # human may type are bold blue. Dim is re-opened after the key's reset,
    # which clears it. Declining here only skips the pager -- the confirm
    # that follows still asks.
    local gate
    printf -v gate '%sshow the diff (%s lines);%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
      "$P_B" "$lines" "$P_OFF" "$P_BLU" "$P_OFF" \
      "$P_DIM" "$P_OFF" "$P_BLU" "$P_OFF" "$P_DIM" "$P_OFF"
    if gate_answer 1 "$gate" 1; then
      # A clean environment and secure mode: no lesskey file (which can
      # bind a key to a shell command), LESS or LESSOPEN from the caller
      # reaches this root less, and its shell, pipe and edit commands are off.
      env -i PATH="$PATH" HOME=/var/empty TERM="${TERM:-dumb}" \
        LESSSECURE=1 LESSCHARSET=utf-8 /usr/bin/less -RF -- "$enc" || true
      shown=1
    fi
  else
    cat -- "$enc"
    shown=1
  fi
  rm -f -- "$enc"
  if [ "$shown" -eq 1 ]; then
    printf -- '%s--- end of diff ---%s\n' "$P_B" "$P_OFF"
  fi
  return 0
}

# diff_header <rule> [<row label> <path> [<via label> <via path>]]: the
# section rule over a diff witness, holding locked's own words only, then
# the path it is about on a row of its own -- a path ends its line, so it
# never sits inside the rule -- directly above the diff or the gate that
# offers it, and under it the link the path was reached through, if any.
# Without a row label the rule stands alone: the caller's question rows,
# right below it, name the path, and a row already on screen is not
# printed again.
diff_header() {
  set_pal
  printf -- '%s--- %s ---%s\n' "$P_B" "$1" "$P_OFF"
  [ -n "${2:-}" ] || return 0
  if [ -n "${5:-}" ]; then
    value_rows "" "$2" subject "$3" "$4" id "$5"
  else
    value_rows "" "$2" subject "$3"
  fi
}

# ---- planning --------------------------------------------------------------
#
# A lock ceremony derives everything it would do BEFORE it touches anything,
# and asks once. What made that necessary: every seal used to ask for
# itself, so declining an ancestor left the leaf ALREADY SEALED under a
# parent nobody had protected -- the one state the chain exists to prevent,
# reached by answering a question honestly.
#
# So every refusal that used to sit between a seal's first line and its own
# confirm is raised in the planning pass instead -- drifted-but-locked, a
# foreign owner, a mixed tree -- alongside the ones do_lock_one already made
# up front (a bad stop node, a tier change). The seal_* functions below
# apply an already-decided action and ask nothing. The one question they may
# raise is check_reseal_identity's, which reports an anomaly -- a node
# swapped during an unlock window -- that no plan could have shown as
# routine.

# content_targets <path>: sets T_OWNER/T_GROUP/T_MODE, the identity a
# content-tier node is restored to on unlock. A record is authoritative
# once one exists; a first adoption takes the node's current identity.
# Shared by the planning pass and by the seal, so the two can never derive
# it differently. Every stat is an lstat, so a symlink answers for itself.
T_OWNER="" T_GROUP="" T_MODE=""
content_targets() { # <path>
  local p="$1"
  snap_paths "$p"
  if record_live "$META"; then
    T_OWNER="$(meta_field "$META" owner)"
    T_GROUP="$(meta_field "$META" group)"
    T_MODE="$(meta_field "$META" mode)"
  else
    T_OWNER="$(stat -f '%Su' "$p")" || return 1
    T_GROUP="$(stat -f '%Sg' "$p")" || return 1
    T_MODE="$(stat -f '%OLp' "$p")" || return 1
  fi
}

# plan_tree_refusals <dir>: everything inside a folder about to be sealed
# that the helper's gate would refuse, raised before the question with each
# node named on a row of its own (at most three of each kind): a node owned
# by anyone but you, with its owner; a group other than the folder's (the
# unlock restores one group to the whole tree); a node that is not a file,
# directory or symlink; a set-user-id or set-group-id file. Uses T_GROUP,
# so content_targets runs first.
plan_tree_refusals() {
  local p="$1" sp bad=0
  local -a own=() grp=() odd=() setid=()
  # NUL-separated, so a name holding a newline stays one path.
  while IFS= read -r -d '' sp; do
    own+=("$sp")
    [ "${#own[@]}" -lt 3 ] || break
  done < <(find "$p" ! -user "$inv" -print0 2>/dev/null)
  while IFS= read -r -d '' sp; do
    grp+=("$sp")
    [ "${#grp[@]}" -lt 3 ] || break
  done < <(find "$p" ! -group "$T_GROUP" ! -group "$lock_user" -print0 2>/dev/null)
  while IFS= read -r -d '' sp; do
    odd+=("$sp")
    [ "${#odd[@]}" -lt 3 ] || break
  done < <(find "$p" ! -type d ! -type f ! -type l -print0 2>/dev/null)
  while IFS= read -r -d '' sp; do
    setid+=("$sp")
    [ "${#setid[@]}" -lt 3 ] || break
  done < <(find "$p" -type f -perm +6000 -print0 2>/dev/null)
  if [ "${#own[@]}" -gt 0 ]; then
    # Owned by someone else: often a hard link to another account's file,
    # which keeps that account as its owner wherever it is linked.
    err_val "holds nodes you do not own; a seal acts only on your own" "$p"
    for sp in "${own[@]}"; do
      say_err "    owned by $(stat -f '%Su' "$sp")" "$sp"
    done
    bad=1
  fi
  if [ "${#grp[@]}" -gt 0 ]; then
    err_val "mixed groups in the tree; the content tier needs a uniform tree" "$p"
    path_lines "    " "${grp[@]}" >&2
    bad=1
  fi
  if [ "${#odd[@]}" -gt 0 ]; then
    err_val "holds nodes that are not files, directories or symlinks" "$p"
    for sp in "${odd[@]}"; do
      say_err "    $(stat -f '%HT' "$sp" | tr '[:upper:]' '[:lower:]')" "$sp"
    done
    bad=1
  fi
  if [ "${#setid[@]}" -gt 0 ]; then
    err_val "holds set-user-id or set-group-id files; sealed, they would run as the lock account" "$p"
    path_lines "    " "${setid[@]}" >&2
    bad=1
  fi
  [ "$bad" -eq 0 ]
}

# plan_notes <path> <first seal: 0|1> <tier>: what the person sealing this
# path probably did not intend, or should know, said before the question. A
# note, not a refusal: none of these lets root do more than the invoker
# could. On stderr with the plan; each list of paths stacked, one a line.
#
#   - A file with other names (hard links) outside what is being sealed.
#     The flag and the owner are the file's, not the name's, so every name
#     is frozen and handed to the lock account with it, wherever it sits.
#     Names that all sit inside a sealed folder say nothing new, so only a
#     file with fewer names in the folder than links is listed. An anchor
#     file keeps its owner, so its other names are only frozen; an anchor
#     folder seals no node below it, so it has no notes.
#   - A symlink inside a folder, on its first seal: the link is sealed as a
#     link, and what it points at is not sealed at all. Said once, when the
#     folder is adopted, rather than on every relock.
#   - A symlink named on its own: see link_note.
plan_notes() {
  local p="$1" first="$2" tier="$3" sp n i j c
  local -a hp=() hi=() hn=() outside=() links=()
  if [ -L "$p" ]; then
    link_note "$p"
    return 0
  fi
  if [ ! -d "$p" ]; then
    n="$(stat -f '%l' "$p")" || return 0
    if [ "$n" -gt 1 ] && [ "$tier" = anchor ]; then
      echo "${E_YEL}note:${E_OFF} this file has $n names (hard links); the flag is on the file," >&2
      echo "      so its other names are frozen with it" >&2
    elif [ "$n" -gt 1 ]; then
      echo "${E_YEL}note:${E_OFF} this file has $n names (hard links); the seal is on the file," >&2
      echo "      so its other names are frozen and handed to the lock account with it" >&2
    fi
    return 0
  fi
  [ "$tier" = anchor ] && return 0
  while IFS= read -r -d '' sp; do
    hp+=("$sp")
    hi+=("$(stat -f '%i' "$sp")")
    hn+=("$(stat -f '%l' "$sp")")
  done < <(find "$p" -type f -links +1 -print0 2>/dev/null)
  i=0
  while [ "$i" -lt "${#hp[@]}" ]; do
    c=0 j=0
    while [ "$j" -lt "${#hp[@]}" ]; do
      [ "${hi[$j]}" = "${hi[$i]}" ] && c=$((c + 1))
      j=$((j + 1))
    done
    [ "$c" -lt "${hn[$i]}" ] && outside+=("${hp[$i]}")
    i=$((i + 1))
  done
  if [ "${#outside[@]}" -gt 0 ]; then
    echo "${E_YEL}note:${E_OFF} $(plural "${#outside[@]}" "a file in it has" "${#outside[@]} files in it have") other names (hard links) outside it;" >&2
    echo "      the seal is on the file, so those names are frozen and handed to the" >&2
    echo "      lock account too:" >&2
    path_lines "      " "${outside[@]:0:5}" >&2
    [ "${#outside[@]}" -le 5 ] || echo "      and $(( ${#outside[@]} - 5 )) more" >&2
  fi
  [ "$first" -eq 1 ] || return 0
  while IFS= read -r -d '' sp; do
    links+=("$sp")
  done < <(find "$p" -mindepth 1 -type l -print0 2>/dev/null)
  if [ "${#links[@]}" -gt 0 ]; then
    echo "${E_YEL}note:${E_OFF} $(plural "${#links[@]}" "a symlink in it is" "${#links[@]} symlinks in it are") sealed as $(plural "${#links[@]}" "a link" links); what $(plural "${#links[@]}" "it points" "they point") at" >&2
    echo "      is not sealed:" >&2
    path_lines "      " "${links[@]:0:5}" >&2
    [ "${#links[@]}" -le 5 ] || echo "      and $(( ${#links[@]} - 5 )) more" >&2
  fi
}

# link_note <link>: the seal is on the link, so what it points at stays as
# open as it was. Said with the command that protects it, and only where
# that command can work: the target exists, it is yours (the owner gate
# refuses anything else, and a node the lock account owns is already
# sealed, as a file in a sealed folder is), it has no live record, and no
# later argument of this run names it. A missing target is the witness's
# to say. Clobbers the snap_paths globals, then points them back at <link>.
link_note() { # <link>
  local l="$1" t a
  t="$(readlink -f "$l" 2>/dev/null)" || return 0
  [ -e "$t" ] || return 0
  [ "$(stat -f '%Su' "$t")" = "$inv" ] || return 0
  snap_paths "$t"
  if record_live "$META"; then
    snap_paths "$l"
    return 0
  fi
  snap_paths "$l"
  for a in "${PATHS[@]}"; do
    [ -L "$a" ] && continue
    [ "$(readlink -f "$a" 2>/dev/null)" = "$t" ] && return 0
  done
  echo "${E_YEL}note:${E_OFF} the seal is on the link; what it points at is not protected:" >&2
  path_lines "      " "$t" >&2
  cmd_rows "      " \
    "sudo locked lock $(shq "$t")" "protects it too, after this" \
    "sudo locked lock $(shq "$l") $(shq "$t")" "seals both in one run" >&2
}

# plan_node <path> <tier> [<anchor flagword>]: what sealing this node would
# do, decided without touching it. Prints the action word; on a node that
# cannot be sealed at all it prints the refusal on stderr and returns 1, so
# the whole ceremony stops before its first change.
#
# The actions: "seal <tier>" for a first seal, "relock <tier>" for a record
# that was unlocked, "reflag anchor (<old> -> <new>)" for a tier-internal
# escalation, and "already locked" for a record that still verifies --
# which the plan SHOWS rather than hides, because a chain is easier to
# judge whole than in parts. The anchor tier carries its flag word in
# both seal and relock, because the flag is what an anchor seal IS.
#
# Called from a command substitution, so snap_paths' globals are the
# subshell's; nothing here writes anything the caller needs back.
plan_node() {
  local p="$1" t="$2" fl="${3:-}"
  snap_paths "$p"
  local state="" prev_flag="" live=0
  if record_live "$META"; then
    live=1
    state="$(meta_field "$META" state)"
    prev_flag="$(meta_field "$META" flag)"
  fi

  # One locked-and-verifying answer for all three tiers. Anchor adds the
  # flag word to the question: a record locked under sappnd says nothing
  # about a schg request, which is an escalation, not a no-op.
  local settled=0
  if [ "$state" = "locked" ]; then
    settled=1
    if [ "$t" = "anchor" ] && [ "$prev_flag" != "$fl" ]; then
      settled=0
    fi
  fi
  if [ "$settled" -eq 1 ]; then
    if verify_node "$p" "$META" "$lock_user" >/dev/null 2>&1; then
      printf 'already locked'
      return 0
    fi
    err_val "marked locked but drifted; investigate before relocking" "$p"
    verify_node "$p" "$META" "$lock_user" | verify_rows "    " >&2 || true
    return 1
  fi

  case "$t" in
    content)
      # A symlink is never a tree: it has no children of its own, and -d
      # would answer for whatever it points at.
      local is_dir=0 is_link=0
      [ -L "$p" ] && is_link=1
      if [ "$is_link" -eq 0 ] && [ -d "$p" ]; then
        is_dir=1
      fi
      content_targets "$p" || return 1
      # A seal hands the node to the lock account, so it has to be yours to
      # hand over -- on a first seal and on every relock alike: a relock
      # finds whatever sits at the path after an unlock window, and a hard
      # link planted there to a root-owned file is still root's. The helper
      # asks again at apply time, on the descriptor it changes.
      local owner_now
      owner_now="$(stat -f '%Su' "$p")" || return 1
      if [ "$owner_now" != "$inv" ]; then
        say_err "skipped, not owned by you (owner $owner_now)" "$p"
        log_action lock "$p" skip-not-owned
        return 1
      fi
      if [ "$is_dir" -eq 0 ] && [ "$is_link" -eq 0 ] &&
         [ $(( 0$(stat -f '%OLp' "$p") & 06000 )) -ne 0 ]; then
        err_val "set-user-id or set-group-id; sealed, it would run as the lock account, which owns every sealed node" "$p"
        log_action lock "$p" refuse-setid
        return 1
      fi
      # Recursive adoption sanity: single owner + single group across the
      # tree, so unlock's restore is lossless. The owner is the gate the
      # helper enforces per node; this pass raises it before the question,
      # naming whose each stray is.
      if [ "$is_dir" -eq 1 ]; then
        plan_tree_refusals "$p" || return 1
      fi
      ;;
    placement)
      [ -d "$p" ] || {
        err_val "placement tier needs a directory" "$p"
        return 1
      }
      if [ "$live" -eq 0 ]; then
        local owner_now
        owner_now="$(stat -f '%Su' "$p")"
        if [ "$owner_now" != "$inv" ]; then
          err_val "owned by $owner_now; placement adoption needs your ownership" "$p"
          return 1
        fi
        if [ -z "$(placement_entry "$inv" "$(stat -f '%OLp' "$p")")" ]; then
          err_val "gives its owner no access (mode $(stat -f '%OLp' "$p")); there is nothing for a placement seal to carry over" "$p"
          return 1
        fi
        # chmod +a folds a new allow entry into an existing one for the same
        # user, and -a takes rights out of whichever entry holds them. With
        # an entry of yours already there, the seal's own entry could not be
        # told apart from it, and a release would take away rights that were
        # never locked's to take.
        if acl_names_user "$p" "$inv"; then
          err_val "already carries an ACL entry for $inv; placement adds its own, and the two would merge" "$p"
          acl_entries "$p" | sed 's/^/    /' >&2
          return 1
        fi
      else
        # A reseal puts the flag back and nothing else, so the rest of the
        # placement shape has to be there already.
        local want
        want="$(meta_field "$META" acl)"
        if [ -z "$want" ]; then
          err_val "a placement record without its ACL entry (written before locked 0.14.0); convert the pool first" "$p"
          return 1
        fi
        if ! acl_has "$p" "$want"; then
          err_val "no longer carries its ACL entry; investigate before relocking" "$p"
          echo "    expected: $want" >&2
          return 1
        fi
      fi
      ;;
    anchor)
      # An anchor never changes owner, and the OS checks it against yours:
      # a node that is not yours is not one to anchor, however it got here.
      local anchor_owner
      anchor_owner="$(stat -f '%Su' "$p")" || return 1
      if [ "$anchor_owner" != "$inv" ]; then
        say_err "skipped, not owned by you (owner $anchor_owner)" "$p"
        log_action lock "$p" skip-not-owned
        return 1
      fi
      if [ "$state" = "locked" ]; then
        # Tier-internal escalation (sappnd <-> schg): a normal relock that
        # clears the previous system flag before applying the new one.
        printf 'reflag anchor (%s → %s)' "$prev_flag" "$fl"
        return 0
      fi
      ;;
  esac

  # A relock names its tier the way a first seal does: the header carries
  # the LEAF's tier and nothing else, so without it an ancestor's line
  # would not say whether it is coming back as placement or as an anchor.
  if [ "$live" -eq 1 ]; then
    case "$t" in
      content)   printf 'relock content' ;;
      placement) printf 'relock placement' ;;
      anchor)    printf 'relock anchor (%s)' "$fl" ;;
    esac
    return 0
  fi
  case "$t" in
    content)   printf 'seal content' ;;
    placement) printf 'seal placement' ;;
    anchor)    printf 'seal anchor (%s)' "$fl" ;;
  esac
}

# The witness the gate is answered on: what the snapshot says the leaf held
# when it was released, against what it holds now. Only content and anchor
# FILES have one -- a content directory diffs against its .snapdir, a
# placement parent has no content of its own, and a symlink's content IS
# its target, which is one line rather than a diff. The block owns its
# trailing blank line, which separates it from the plan below it.
#
# Root draws this diff, so it reads the current side from a staged copy
# made through the helper's owner gate (stage_copy, stage_tree), never from
# the path: the leaf sits in your own space until it is sealed, and a hard
# link planted there to a root-only file would otherwise be shown to you.
# The copy is of <id>, the node do_lock_one pinned.
lock_witness() { # <path> <tier> <id>
  local f="$1" t="$2" id="$3" shown=0 live=0 ef cur rc=0
  esc_into ef "$f" "$C_RV"
  [ "$t" = "placement" ] && return 0
  snap_paths "$f"
  # A retired record's snapshot is the content of a protection that ended;
  # a new one starts from what the node holds now.
  record_live "$META" && live=1
  if [ -L "$f" ]; then
    # -e follows the link, so it asks after the TARGET. A missing one is
    # not a refusal -- the target may still arrive -- but it is the one
    # thing about this seal a reader cannot see from the link text, so the
    # witness says it and the gate below answers for it.
    # The link text is a value of its own, so it ends a row of its own.
    if [ ! -e "$f" ]; then
      echo "symlink, target missing (the link node is sealed, not its target)"
    else
      echo "symlink (the link node is sealed, not its target)"
    fi
    value_rows "" target id "$(readlink "$f")"
    shown=1
  elif [ -d "$f" ]; then
    if [ "$t" = "content" ]; then
      if [ "$live" -eq 1 ] && [ -d "$SNAPDIR" ]; then
        # A file added while unlocked shows its whole content against
        # /dev/null, not only its name, so what the seal is about to
        # freeze is on screen.
        cur="$(stage_tree "$f" "$inv" "$id")" || return 1
        show_diff 'diff snapshot → current' path "$f" \
          "$SNAPDIR" "$cur" "snapshot: $f" "current: $f" || rc=1
        rm -rf -- "$(dirname "$cur")"
        [ "$rc" -eq 0 ] || return 1
      else
        echo "adopting into pool (no prior snapshot): $ef"
      fi
      shown=1
    fi
  elif [ "$live" -eq 1 ] && [ -f "$SNAP" ]; then
    cur="$(stage_copy "$f" "$inv" "$id")" || return 1
    if cmp -s "$SNAP" "$cur"; then
      echo "no changes since unlock: $ef"
    else
      # Named by role and subject path: the snapshot sits in the pool under
      # a name that tells the reader nothing. The folder case above takes
      # the same two labels, and each file in it is named by its path
      # below them.
      show_diff 'diff snapshot → current' path "$f" \
        "$SNAP" "$cur" "snapshot: $f" "current: $f" || rc=1
    fi
    rm -f -- "$cur"
    [ "$rc" -eq 0 ] || return 1
    shown=1
  else
    echo "adopting into pool (no prior snapshot): $ef"
    shown=1
  fi
  if [ "$shown" -eq 1 ]; then
    echo
  fi
  return 0
}

# ---- seal / release primitives ---------------------------------------------

# seal_content <path> <id>: apply a decided content-tier seal. The node is
# a file, a directory (sealed recursively) or a symlink (sealed as the link
# node itself). Whether it may be sealed at all was settled by plan_node,
# against the node <id> names; the helper holds the seal to that node and
# asks the owner again of every node it changes (node_op).
seal_content() {
  local f="$1" id="${2:--}"
  snap_paths "$f"
  local is_dir=0 is_link=0
  [ -L "$f" ] && is_link=1
  if [ "$is_link" -eq 0 ] && [ -d "$f" ]; then
    is_dir=1
  fi

  content_targets "$f" || return 1
  local target_owner="$T_OWNER" target_group="$T_GROUP" target_mode="$T_MODE"

  local live=0
  record_live "$META" && live=1
  if [ "$live" -eq 1 ] && [ "$is_link" -eq 0 ]; then
    local mode_now
    mode_now="$(stat -f '%OLp' "$f")"
    if [ "$mode_now" != "$target_mode" ]; then
      echo "  note: mode drifted from $target_mode to $mode_now during edit; restoring $target_mode on lock" >&2
    fi
  fi

  # Baseline snapshot on first adoption so revert always has one. A
  # symlink gets none: its content is the path it names, which the identity
  # record pins already, and the helper's copy verb opens its source
  # O_NOFOLLOW -- a link is precisely what it refuses to read through.
  # A retired record's snapshot is replaced for the same reason.
  if [ "$is_link" -eq 0 ]; then
    if [ "$is_dir" -eq 0 ] && { [ "$live" -eq 0 ] || [ ! -f "$SNAP" ]; }; then
      run atomic_replace "$f" "$SNAP" "${lock_user}:${lock_user}" 600 "$inv" "$id" || return 1
    elif [ "$is_dir" -eq 1 ] && { [ "$live" -eq 0 ] || [ ! -d "$SNAPDIR" ]; }; then
      run snapshot_tree "$f" "$SNAPDIR" "$inv" "$id" || return 1
    fi
  fi

  # Seal: ownership, mode, then flag LAST (flags block chmod/chown), each
  # node on its own descriptor. A folder is handed over top-down, each
  # directory frozen before its entries are read, so nothing planted in it
  # meanwhile escapes the owner gate (see the helper's seal_walk). No mode
  # on a link: a link's own mode gates nothing on macOS, and what may
  # replace it is governed by its parent directory, which the chain seals.
  local -a how=(--path "$f" --id "${id/./:}" --owner "$inv"
    --chown "${lock_user}:${lock_user}" --flag uchg)
  if [ "$is_dir" -eq 1 ]; then
    local count
    count="$(node_count "$f")" || return 1
    node_op lock "$f" seal "${how[@]}" --mode "$target_mode" \
      --count "$count" --recursive || return 1
  elif [ "$is_link" -eq 1 ]; then
    node_op lock "$f" seal "${how[@]}" --count 1 || return 1
  else
    node_op lock "$f" seal "${how[@]}" --mode "$target_mode" --count 1 || return 1
  fi

  if [ "$OPT_DRY" -eq 0 ]; then
    write_meta "$META" \
      "owner=$target_owner" \
      "group=$target_group" \
      "mode=$target_mode" \
      "lockmode=$target_mode" \
      "tier=content" \
      "flag=uchg" \
      "flagsym=$(flags_of "$f")" \
      "id=$(node_id "$f")" \
      "recursive=$is_dir" \
      "role=leaf" \
      "state=locked" || return 1
  fi
  ok_row "locked (content)" "$f"
  log_action lock "$f" ok
}

# seal_placement <dir> <id>: apply a decided placement-tier seal to a
# parent dir. <id> pins the node the plan saw; the helper holds the seal to
# it and asks its owner again on the descriptor it changes (node_op): you
# before the first seal, the lock account for a reseal.
seal_placement() {
  local d="$1" id="${2:--}"
  snap_paths "$d"

  local owner_now group_now mode_now
  owner_now="$(stat -f '%Su' "$d")"
  group_now="$(stat -f '%Sg' "$d")"
  mode_now="$(stat -f '%OLp' "$d")"

  if record_live "$META"; then
    # Re-seal after an unlock ceremony: reapply flag only -- but never
    # silently bless a node that was swapped during the window. This is the
    # one live question left in an applying seal, because it reports an
    # anomaly the plan could not have shown as routine.
    check_reseal_identity "$d" "$META" || {
      echo "${E_YEL}aborted; node not re-sealed${E_OFF}" >&2; return 2
    }
    node_op lock "$d" seal --path "$d" --id "${id/./:}" --owner "$lock_user" \
      --count 1 --flag uappnd || return 1
    if [ "$OPT_DRY" -eq 0 ]; then
      write_meta "$META" \
        "owner=$(meta_field "$META" owner)" \
        "group=$(meta_field "$META" group)" \
        "mode=$(meta_field "$META" mode)" \
        "lockmode=$(meta_field "$META" lockmode)" \
        "tier=placement" \
        "flag=uappnd" \
        "flagsym=$(flags_of "$d")" \
        "id=$(node_id "$d")" \
        "recursive=0" \
        "role=chain" \
        "$(acl_kv "$META")" \
        "state=locked" || return 1
    fi
    ok_row "relocked (placement)" "$d"
    log_action lock "$d" ok
    return 0
  fi

  # The invoker's way back in as one ACL entry (see placement_entry), then
  # ownership to the lock account, group and mode as they were, in one
  # helper call on the directory's own descriptor. The entry goes on first,
  # so the invoker never loses access to a 700 directory like ~/Library,
  # even for an instant. Any ACL entries already there stay: ~/Library
  # carries Apple's own. Flag last.
  local entry rights
  entry="$(placement_entry "$inv" "$mode_now")"
  rights="${entry##* }"
  node_op lock "$d" seal --path "$d" --id "${id/./:}" --owner "$inv" \
    --chown "${lock_user}:${group_now}" --count 1 --flag uappnd \
    --acl-add "${inv}:${rights}" || return 1
  # The recorded line is what verify looks for, so it has to be what the
  # kernel now holds, spelled as ls prints it. A mismatch here is a
  # spelling bug in placement_entry: fail on it now, not as drift later,
  # and hand the directory back as it was found.
  if [ "$OPT_DRY" -eq 0 ] && ! acl_has "$d" "$entry"; then
    err_val "does not read back the ACL entry just added" "$d"
    echo "    entry: $entry" >&2
    node_op lock "$d" unseal --path "$d" --id "${id/./:}" --owner "$lock_user" \
      --chown "${owner_now}:${group_now}" --count 1 --flag uappnd \
      --acl-remove "${inv}:${rights}" || true
    return 1
  fi
  if [ "$OPT_DRY" -eq 0 ]; then
    write_meta "$META" \
      "owner=$owner_now" \
      "group=$group_now" \
      "mode=$mode_now" \
      "lockmode=$(stat -f '%OLp' "$d")" \
      "tier=placement" \
      "flag=uappnd" \
      "flagsym=$(flags_of "$d")" \
      "id=$(node_id "$d")" \
      "recursive=0" \
      "role=chain" \
      "acl=$entry" \
      "state=locked" || return 1
  fi
  ok_row "locked (placement)" "$d"
  log_action lock "$d" ok
}

# seal_anchor <path> <flagword> <role>: apply a decided anchor seal --
# system flag, ownership and mode untouched. Anchor FILES still get the
# snapshot (ssh config class: ownership never changes but the content is
# what's being sealed); dirs (~, ~/.ssh) have no content snapshot. <role> is
# leaf for a node you named, chain for one a leaf below needs; the caller
# decides, because only it knows which node was named. <id> pins the node
# the plan saw ("-" for an ancestor, which its owner alone gates): an
# anchor stays yours, so the helper takes it only while it is.
seal_anchor() {
  local f="$1" flagword="$2" role="$3" id="${4:--}"
  snap_paths "$f"
  local is_file=0
  [ -f "$f" ] && is_file=1

  local owner_now group_now mode_now
  owner_now="$(stat -f '%Su' "$f")"
  group_now="$(stat -f '%Sg' "$f")"
  mode_now="$(stat -f '%OLp' "$f")"

  local state="" prev_flag="" live=0
  if record_live "$META"; then
    live=1
    state="$(meta_field "$META" state)"
    prev_flag="$(meta_field "$META" flag)"
  fi

  # Dirs have no content diff, so a swap during the window is invisible
  # except by identity -- check it. (Files are covered by the witness the
  # plan gate was answered on, and atomic-save legitimately changes a
  # file's inode.) This is the one live question left in an applying seal.
  if [ "$live" -eq 1 ] && [ "$is_file" -eq 0 ]; then
    check_reseal_identity "$f" "$META" || {
      echo "${E_YEL}aborted; node not re-sealed${E_OFF}" >&2; return 2
    }
  fi

  if [ "$state" = "locked" ] && [ "$prev_flag" != "$flagword" ]; then
    # Tier-internal escalation (sappnd <-> schg) is a normal relock: clear
    # the previous system flag before applying the new one. The plan named
    # the change as "reflag anchor" and the gate approved it.
    node_op lock "$f" unseal --path "$f" --id "${id/./:}" --owner "$inv" \
      --count 1 --flag "$prev_flag" || return 1
  fi

  if [ "$is_file" -eq 1 ] && { [ "$live" -eq 0 ] || [ ! -f "$SNAP" ]; }; then
    run atomic_replace "$f" "$SNAP" "${lock_user}:${lock_user}" 600 "$inv" "$id" || return 1
  fi

  node_op lock "$f" seal --path "$f" --id "${id/./:}" --owner "$inv" \
    --count 1 --flag "$flagword" || return 1
  if [ "$OPT_DRY" -eq 0 ]; then
    write_meta "$META" \
      "owner=$owner_now" \
      "group=$group_now" \
      "mode=$mode_now" \
      "lockmode=$mode_now" \
      "tier=anchor" \
      "flag=$flagword" \
      "flagsym=$(flags_of "$f")" \
      "id=$(node_id "$f")" \
      "recursive=0" \
      "role=$role" \
      "state=locked" || return 1
  fi
  ok_row "locked (anchor $flagword)" "$f"
  log_action lock "$f" ok
}

# release_node <path>: clear the flag, restore ownership for content tier,
# refresh the snapshot. Meta flips to state=unlocked.
release_node() {
  local f="$1"
  snap_paths "$f"
  if ! record_live "$META"; then
    # "not in pool" is true and unhelpful on its own: what usually blocks
    # this path is an ancestor, not the leaf. Say which one.
    say_err "skipped, not in pool" "$f"
    chain_diagnosis "$f" \
      "sudo locked unlock --chain $(shq "$f")" "releases the chain above it" \
      "sudo locked rm $(shq "$f")" "removes it through a bounded window" >&2
    log_action unlock "$f" skip-no-meta
    return 0
  fi

  local tier flag recursive owner group mode
  tier="$(meta_field "$META" tier)"
  flag="$(meta_field "$META" flag)"
  recursive="$(meta_field "$META" recursive)"
  owner="$(meta_field "$META" owner)"
  group="$(meta_field "$META" group)"
  mode="$(meta_field "$META" mode)"

  local state
  state="$(meta_field "$META" state)"
  if [ "$state" = "unlocked" ]; then
    say_out "already unlocked" "$f"
    log_action unlock "$f" skip-already-unlocked
    return 0
  fi

  # A symlink node is released as the link it is: no snapshot to refresh
  # (it never had one) and no mode to put back (chmod would follow through
  # to the target). fclear passes -h, so the flag comes off the link.
  local is_link=0
  [ -L "$f" ] && is_link=1

  # The snapshot first, read while the node is still sealed and so still
  # the recorded one; then the helper clears the flag and puts the owner
  # and mode back, node by node on each node's descriptor, taking only the
  # recorded node and only what the lock account owns (node_op). A node
  # already back with its owner is let through too, so an unlock cut short
  # can be run again -- but only when that owner is you: root hands back
  # nothing that is not already yours or sealed for you. The snapshot read
  # takes the same owners, so a node that drifted back to you (flag cleared,
  # owner reset) can still be unlocked to repair it.
  local rid owners="$lock_user"
  rid="$(helper_id_for "$f")"
  [ "$owner" = "$inv" ] && owners="$lock_user,$inv"
  case "$tier" in
    content)
      local -a how=(--path "$f" --id "$rid" --owner "$owners"
        --chown "${owner}:${group}" --flag "$flag")
      if [ "$recursive" = "1" ]; then
        local count
        run snapshot_tree "$f" "$SNAPDIR" "$owners" "$rid" || return 1
        count="$(node_count "$f")" || return 1
        node_op unlock "$f" unseal "${how[@]}" --mode "$mode" \
          --count "$count" --recursive || return 1
      elif [ "$is_link" -eq 1 ]; then
        node_op unlock "$f" unseal "${how[@]}" --count 1 || return 1
      else
        run atomic_replace "$f" "$SNAP" "${lock_user}:${lock_user}" 600 "$owners" "$rid" || return 1
        node_op unlock "$f" unseal "${how[@]}" --mode "$mode" --count 1 || return 1
      fi
      ;;
    anchor)
      # Anchor files keep the snapshot flow so the relock diff-witness has
      # a baseline; ownership is untouched either way, and an anchor is
      # always yours.
      if [ -f "$f" ]; then
        run atomic_replace "$f" "$SNAP" "${lock_user}:${lock_user}" 600 "$inv" "$rid" || return 1
      fi
      node_op unlock "$f" unseal --path "$f" --id "$rid" --owner "$inv" \
        --count 1 --flag "$flag" || return 1
      ;;
    placement)
      # The flag alone, through the helper like every other tier: the
      # recorded node, while the lock account owns it.
      node_op unlock "$f" unseal --path "$f" --id "$rid" --owner "$lock_user" \
        --count 1 --flag "$flag" || return 1
      # Placement keeps lock-account ownership and its ACL entry through
      # the unlock, deliberately: that IS the seal's structure, not drift.
      # The owner must stay the lock account because `uappnd` is a user
      # flag its owner could clear, and the entry is the door the user
      # comes back in by -- add rights only, so with the flag off the user
      # still cannot rename or remove what is in there (a window is for
      # root's own operations). The flag is the whole of what an unlock
      # lifts; the recorded owner/group/mode are the pre-adoption identity,
      # kept for a release.
      ;;
    *)
      err_val "the record has unknown tier '$tier'" "$f"
      return 1
      ;;
  esac

  if [ "$OPT_DRY" -eq 0 ]; then
    write_meta "$META" \
      "owner=$owner" \
      "group=$group" \
      "mode=$mode" \
      "lockmode=$(meta_field "$META" lockmode)" \
      "tier=$tier" \
      "flag=$flag" \
      "flagsym=$(flags_of "$f")" \
      "id=$(node_id "$f")" \
      "recursive=$recursive" \
      "role=$(meta_field "$META" role)" \
      "$(acl_kv "$META")" \
      "$(mismatch_kv "$META")" \
      "state=unlocked" || return 1
  fi
  ok_row "unlocked ($tier)" "$f"
  if [ "$tier" = "content" ] && [ "$recursive" != "1" ] && [ "$is_link" -eq 0 ]; then
    say_out "  snapshot" "$SNAP"
  fi

  # Atomic-save hint: if the parent still carries an append/immutable flag,
  # editors that save via rename will fail until --chain releases it. The
  # parent is the row's path less its last name, so the note names it by
  # kind; the command line, whose path is a value, ends its line.
  local pflags ef
  pflags="$(flags_of "$(dirname "$f")")"
  case ",$pflags," in
    *,uappnd,*|*,sappnd,*|*,uchg,*|*,schg,*)
      esc_into ef "$(shq "$f")" "$C_RV" "$C_CYN"
      echo "  ${C_YEL}note:${C_OFF} its parent is flagged ($pflags), so atomic-save editors"
      echo "        (write-then-rename) will fail. In-place edits work, or use:"
      echo "        ${C_CYN}sudo locked unlock --chain $ef${C_OFF}"
      ;;
  esac
  log_action unlock "$f" ok
}

# release_chain_node <dir>: un-provision a chain directory nothing needs any
# more (plan_releases decided that). This is NOT an unlock: an unlock keeps
# lock-account ownership and the ACL entry because the seal is coming back,
# and here it is not, so a placement node goes all the way home -- flag
# off, the seal's own ACL entry off (and only that one: ~/Library carries
# Apple's), then owner, group and mode restored from the pre-adoption
# identity the record captured. An anchor never changed ownership, so only
# its flag comes off. The record retires via=unneeded, so the audit trail
# says which decision released it.
#
# A record left state=unlocked is the same release with no flag to clear:
# unlock deliberately kept the lock account and the entry, so the identity
# restore below is exactly what that node is still owed.
release_chain_node() { # <dir>
  local d="$1" owner group mode flag state tier acl
  snap_paths "$d"
  record_live "$META" || return 0
  tier="$(meta_field "$META" tier)"
  owner="$(meta_field "$META" owner)"
  group="$(meta_field "$META" group)"
  mode="$(meta_field "$META" mode)"
  flag="$(meta_field "$META" flag)"
  state="$(meta_field "$META" state)"
  acl="$(meta_field "$META" acl)"
  if [ "$OPT_DRY" -eq 1 ]; then
    say_out "dry run: release" "$d"
    return 0
  fi
  # Through the helper, on the directory's own descriptor, like every other
  # change to a node in your space: the recorded node only, and only while
  # the lock account owns it (or you already do again, so a release cut
  # short can run again). The flag comes off first, since it blocks the
  # rest; then owner, group and mode; then the entry, once the owner bits
  # are your way in again.
  local rid
  rid="$(helper_id_for "$d")"
  if [ "$tier" = "placement" ]; then
    local owners="$lock_user" who
    [ "$owner" = "$inv" ] && owners="$lock_user,$inv"
    local -a how=(--path "$d" --id "$rid" --owner "$owners" --count 1
      --flag "$flag" --chown "${owner}:${group}" --mode "$mode")
    # Exactly the recorded entry comes off: an allow naming that account,
    # with those rights and no inherit flag. plan_node refused to seal a
    # directory where the user already had one, so that entry is the
    # seal's. Anything else naming the user is not locked's to guess at:
    # it stays (the helper says so on an acl-absent line), and the release
    # says so too.
    if [ -n "$acl" ]; then
      who="${acl#user:}"
      how+=(--acl-remove "${who%% *}:${acl##* }")
    fi
    node_op release "$d" unseal "${how[@]}" || return 1
    if [ -z "$acl" ] || [ -n "$(helper_line_value acl-absent)" ]; then
      if acl_names_user "$d" "$owner"; then
        say_out "  ${C_YEL}note:${C_OFF} an ACL entry for $owner is not the one recorded; left in place" "$d"
      fi
    fi
  elif [ "$state" = "locked" ]; then
    # An anchor stays yours, so the helper takes it only while it is.
    node_op release "$d" unseal --path "$d" --id "$rid" --owner "$inv" \
      --count 1 --flag "$flag" || return 1
  fi
  retire_record "$d" unneeded quiet || return 1
  if [ "$tier" = "placement" ]; then
    ok_row released "$d" "back to $mode ${owner}:${group}"
  else
    ok_row "released ($flag cleared)" "$d"
  fi
  log_action release "$d" ok
}

# ---- mediated window -------------------------------------------------------

# Absolute path with the PARENT canonicalized and the leaf name left as
# typed. rm, trash and mv act on a directory ENTRY: resolving the leaf
# through a symlink would name the target instead of the link, and remove
# the wrong thing. The parent still gets readlink -f, so the entry is
# named relative to a real directory.
abs_leaf() { # <path>
  local p="$1" d b
  d="$(dirname "$p")"
  b="$(basename "$p")"
  case "$b" in
    .|..|/)
      say_err "${E_RED}${E_B}✗ refusing:${E_OFF} names a directory, not an entry inside one" "$p"
      return 1
      ;;
  esac
  # The helper's stdout grammar is tab-separated lines, so it refuses a
  # name carrying a tab or a newline rather than let a filename forge one.
  # Say that here instead of surfacing a bare usage error from inside it.
  case "$b" in
    *$'\t'*|*$'\n'*)
      say_err "${E_RED}${E_B}✗ refusing:${E_OFF} the entry name contains a tab or newline" "$p"
      echo "  the window helper refuses those; rename it first" >&2
      return 1
      ;;
  esac
  # Parents are opened O_NOFOLLOW, so a symlinked parent dir is refused
  # outright -- readlink -f here is what makes the call land on a real
  # directory, and it is also what pins the entry to one parent inode.
  d="$(readlink -f "$d")" || { say_err "skipped, cannot resolve" "$(dirname "$p")"; return 1; }
  if [ "$d" = "/" ]; then
    printf '%s\n' "/$b"
  else
    printf '%s\n' "$d/$b"
  fi
}

# The node a lock or unlock verb acts on.
#
# A SYMLINK argument names the link itself, never its target: the link node
# is the one a same-UID process can repoint, so resolving through it would
# seal the target and leave the actual redirection wide open -- and then
# report "already locked" for a link nothing protects. abs_leaf is exactly
# the right shape for that (parent canonicalized, the entry's own name
# kept), and it already refuses a name the window helper's grammar cannot
# carry. Anything else is canonicalized whole, as before.
leaf_path() { # <path>
  if [ -L "$1" ]; then
    abs_leaf "$1"
  else
    readlink -f "$1" || { say_err "skipped, cannot resolve" "$1"; return 1; }
  fi
}

# The record separates the identity's two halves with "."; the helper's
# argv grammar uses ":", and accepts either on input while always EMITTING
# the colon form in its own output. Translate here anyway, so what goes
# over the wire matches the grammar the helper documents and the ids in its
# error prose read the same as ours.
# The --*-id options are all mandatory: "-" is how a call says it has no
# expectation, and omitting one is a usage error, not a default.
helper_id_for() { # <path>
  local p="$1" id="" live="" sn=0
  snap_paths "$p"
  if [ -f "$META" ]; then
    id="$(meta_field "$META" id)"
  fi
  # TODO(toctou): this read and the helper's openat are separated by a
  # process spawn. The residual is a stale refusal, never a wrong target:
  # the helper compares what it opened against this value and exits 2
  # rather than acting on a mismatch.
  if [ -z "$id" ] || [ "$(id_form "$id")" = "dev" ]; then
    live="$(node_id "$p" 2>/dev/null)" || live=""
  fi
  if [ -z "$id" ]; then
    id="$live"
  elif [ -n "$live" ]; then
    # A pre-0.6.0 record names a dev the kernel may have reassigned at the
    # last mount, and the helper compares exactly. Same inode means the
    # same node, so send what the helper will actually see; a different
    # inode sends the record unchanged and earns the refusal it deserves.
    same_node "$id" "$live" || sn=$?
    if [ "$sn" -eq 2 ]; then
      id="$live"
    fi
  fi
  if [ -z "$id" ]; then
    printf '%s' '-'
    return 0
  fi
  printf '%s' "${id/./:}"
}

# The window backstop. The helper holds the parent by fd and restores its
# flag word on every exit path of its own; what it cannot cover is being
# killed mid-window, or failing the restore itself (its exit 5). So the
# flag word is captured HERE before the call, and re-applied here if the
# parent comes back wearing anything else -- including for a parent locked
# never sealed, whose word no meta records.
WINDOW_PATHS=()
WINDOW_FLAGS=()
WINDOW_ALARM=0

# window_add <path> <flagword>: register one restore target. The flag word
# is passed in rather than read here, because mv has to capture a node's
# flags at its OLD path and restore them at whichever path it ended up at.
window_add() {
  local p="$1" fl="$2" j
  [ -n "$p" ] || return 0
  j=0
  while [ "$j" -lt "${#WINDOW_PATHS[@]}" ]; do
    if [ "${WINDOW_PATHS[$j]}" = "$p" ]; then
      return 0
    fi
    j=$((j + 1))
  done
  WINDOW_PATHS+=("$p")
  WINDOW_FLAGS+=("$fl")
}

window_begin() { # <parent>...
  WINDOW_PATHS=()
  WINDOW_FLAGS=()
  WINDOW_ALARM=0
  local p
  for p in "$@"; do
    [ -n "$p" ] || continue
    window_add "$p" "$(flags_of "$p")"
  done
  # INT/TERM re-seal and then leave; the EXIT trap fires after that too,
  # finds the flags already right, and stays quiet.
  trap 'reseal_after_window; exit 3' INT TERM
  trap 'reseal_after_window' EXIT
}

reseal_after_window() {
  local i n want cur
  i=0
  while [ "$i" -lt "${#WINDOW_PATHS[@]}" ]; do
    n="${WINDOW_PATHS[$i]}"
    want="${WINDOW_FLAGS[$i]}"
    i=$((i + 1))
    # An unflagged node had no window to leave open.
    [ -n "$want" ] || continue
    # -L as well as -e: a registered node can be a symlink, including a
    # dangling one, and that is still a node whose own flags must go back.
    [ -e "$n" ] || [ -L "$n" ] || continue
    cur="$(flags_of "$n" 2>/dev/null)" || cur=""
    [ "$cur" = "$want" ] && continue
    WINDOW_ALARM=1
    # An alarm can fire anywhere, so it owns one leading blank line. The
    # node is a path, so it never sits inside the alarm's marker: the line
    # under it names it, last.
    echo >&2
    echo "${E_RED}${E_B}!!! a node came back with flags '${cur:-none}', expected '$want' !!!${E_OFF}" >&2
    # -h always: on a symlink it flags the link rather than whatever it
    # points at, and on anything else it changes nothing.
    if chflags -h -- "$want" "$n" 2>/dev/null; then
      say_err "    re-sealed by the backstop ($want)" "$n"
      log_action reseal "$n" reseal-backstop
    else
      local en
      esc_into en "$(shq "$n")" "$E_RV"
      echo "    could not re-seal it. Restore by hand:" >&2
      echo "    sudo chflags -h $want $en" >&2
      log_action reseal "$n" reseal-failed
    fi
  done
}

window_end() {
  reseal_after_window
  trap - EXIT INT TERM
  WINDOW_PATHS=()
  WINDOW_FLAGS=()
}

# helper_call <argv>...: run the window helper, capturing its stdout.
# Always returns 0 -- the outcome is HELPER_RC, which helper_outcome reads.
# stderr is passed straight through: the helper writes one prose line.
HELPER_OUT=""
HELPER_RC=0
HELPER_ANOMALY=0
helper_call() {
  HELPER_OUT=""
  HELPER_RC=0
  if [ "$OPT_DRY" -eq 1 ]; then
    dry_line "$LOCKED_HELPER" "$@"
    return 0
  fi
  # Re-verified per call, never cached: see verify_helper.
  if ! verify_helper; then
    HELPER_RC=3   # nothing ran, so nothing changed
    return 0
  fi
  HELPER_OUT="$("$LOCKED_HELPER" "$@")" || HELPER_RC=$?
  return 0
}

# First value of a tab-separated stdout line the helper tagged with $1.
helper_line_value() { # <key>
  printf '%s\n' "$HELPER_OUT" | awk -F'\t' -v k="$1" '$1==k{print $2; exit}'
}

# Translate HELPER_RC into operator-facing output. Returns 0 when the
# operation HAPPENED and the records must follow it, 1 when it did not.
# Sets HELPER_ANOMALY=1 for exit 6, where it happened but the parent's
# entry diff had leftovers the caller must surface as a partial failure.
helper_outcome() { # <verb> <path>
  local verb="$1" f="$2"
  HELPER_ANOMALY=0
  case "$HELPER_RC" in
    0)
      return 0
      ;;
    2)
      local ef
      esc_into ef "$(shq "$f")" "$E_RV" "$E_CYN"
      say_err "${E_RED}${E_B}✗ refused:${E_OFF} the node the helper opened is not the one recorded" "$f"
      echo "  nothing was changed. Check it, then re-run: ${E_CYN}sudo locked status $ef${E_OFF}" >&2
      log_action "$verb" "$f" refuse-identity
      return 1
      ;;
    3)
      say_err "${E_RED}${E_B}✗ failed:${E_OFF} the operation did not happen" "$f"
      log_action "$verb" "$f" fail
      return 1
      ;;
    4)
      echo "${E_RED}${E_B}✗ error:${E_OFF} the window helper refused the request as malformed, or is" >&2
      say_err "         not running as root" "$LOCKED_HELPER"
      log_action "$verb" "$f" fail-helper
      return 1
      ;;
    5)
      # The helper could not put the flag word back. window_end has already
      # run by the time this prints, so the backstop's own lines are above
      # and say whether re-sealing from the captured word worked. The paths
      # stand on lines of their own under the alarm, never inside it.
      echo >&2
      echo "${E_RED}${E_B}!!! the helper could not restore the flags it lifted !!!${E_OFF}" >&2
      say_err "    target" "$f"
      say_err "    window left open on" "$(helper_line_value window-open)"
      echo "    locked's backstop has already re-applied the flag word it" >&2
      echo "    captured before the call; anything it could not fix is above." >&2
      echo "    The record is deliberately NOT updated -- whether the operation" >&2
      echo "    itself completed cannot be told from here:" >&2
      echo "    sudo locked verify" >&2
      log_action "$verb" "$f" alarm-window-open
      return 1
      ;;
    6)
      HELPER_ANOMALY=1
      echo >&2
      echo "${E_RED}${E_B}!!! entries other than the target changed inside the window !!!${E_OFF}" >&2
      say_err "    target" "$f"
      # The name field arrives backslash-escaped by the helper, precisely so
      # a hostile filename cannot forge one of these lines. Printed as it
      # came: un-escaping here would hand that forgery back.
      printf '%s\n' "$HELPER_OUT" \
        | awk -F'\t' '$1=="anomaly"{printf "    %s  %s  (%s)\n", $2, $3, $4}' >&2
      echo "    The operation itself completed and the records follow it." >&2
      echo "    Nothing here can undo a race; it can only refuse to hide one." >&2
      log_action "$verb" "$f" anomaly
      return 0
      ;;
    *)
      echo "${E_RED}${E_B}✗ error:${E_OFF} the window helper exited $HELPER_RC, which locked does not" >&2
      say_err "         know how to read; treating the target as unchanged" "$f"
      log_action "$verb" "$f" fail-unknown
      return 1
      ;;
  esac
}

# ---- record layer ----------------------------------------------------------

# Retire: the node is gone for good. `via` carries the provenance the plan
# insists on keeping apart -- rm and trash-finalized are observations by
# the tool, assertion is a human's claim about a fact found afterwards.
# The meta and its snapshots stay as the audit trail.
retire_record() { # <path> <via> [quiet]
  local f="$1" via="$2" quiet="${3:-}"
  snap_paths "$f"
  [ -f "$META" ] || return 0
  if [ "$OPT_DRY" -eq 1 ]; then
    say_out "dry run: retire record (via=$via)" "$f"
    return 0
  fi
  rewrite_meta_state "$META" retired "via=$via" "by=$inv" "at=$(now_utc)" || return 1
  # quiet: the caller's own result line already says what happened to the
  # node, and the record following it is bookkeeping, not news.
  [ "$quiet" = "quiet" ] || say_out "  record retired" "$f"
}

# Suspend: trashing is reversible, so retiring here would let a Put Back
# quietly restore a previously sealed node UNSEALED. The record keeps the
# bin location instead and verify watches both ends of it.
suspend_record() { # <path> <bin>
  local f="$1" bin="$2"
  snap_paths "$f"
  [ -f "$META" ] || return 0
  if [ "$OPT_DRY" -eq 1 ]; then
    say_out "dry run: suspend record" "$f"
    return 0
  fi
  rewrite_meta_state "$META" suspended "by=$inv" "at=$(now_utc)" "bin=$bin" || return 1
  say_out "  record suspended" "$f"
  [ -z "$bin" ] || say_out "    bin" "$bin"
  return 0
}

# Re-key: the record's path lives only in its encoded filename (see the
# field list in write_meta), so a move is a rename of the pool files and
# nothing else. Identity, tier, flags and state all still describe the same
# inode. Refuses rather than merging into an existing key.
rekey_record() { # <oldpath> <newpath>
  local old="$1" new="$2" oldenc newenc suffix src dst
  oldenc="$(encode "$old")"
  newenc="$(encode "$new")"
  [ "$oldenc" != "$newenc" ] || return 0
  for suffix in meta snap snapdir attic; do
    if [ -e "$USER_POOL/$newenc.$suffix" ]; then
      err_val "a record already exists for the new path; refusing to merge into it" "$new"
      return 1
    fi
  done
  if [ "$OPT_DRY" -eq 1 ]; then
    move_lines "dry run: re-key record" "$old" "$new"
    return 0
  fi
  for suffix in meta snap snapdir attic; do
    src="$USER_POOL/$oldenc.$suffix"
    dst="$USER_POOL/$newenc.$suffix"
    if [ -e "$src" ]; then
      mv -f -- "$src" "$dst" || return 1
    fi
  done
  # The new key hangs under the old one, `→` in the gutter.
  move_lines "  record re-keyed" "$old" "$new"
}

# ---- subtree scan ----------------------------------------------------------

# Decoded paths in <pooldir> that are <target> or lie under it. The case
# patterns quote $target, so it is matched LITERALLY even if it holds glob
# characters, and the "/" in the second pattern is the trailing-slash guard
# that keeps /foo/barbaz out of a scan of /foo/bar.
pool_records_under() { # <pooldir> <target>
  local dir="${1%/}" target="$2" meta dpath
  for meta in "$dir"/*.meta; do
    dpath="$(decode "$(basename "$meta" .meta)")"
    case "$dpath" in
      "$target"|"$target"/*) printf '%s\n' "$dpath" ;;
    esac
  done
}

# The gate every placement verb passes BEFORE a window opens: nothing is
# released until the full set of affected records is known and accepted.
# Records of ANOTHER user refuse outright -- locked does not retire someone
# else's record on their behalf. Own records below the named node need
# --recursive, so the blast radius is seen before the decision instead of
# discovered after it.
#
# Sets SUBTREE_NODES to every own-pool path at or under the target, deepest
# first. Returns 1 on refusal.
SUBTREE_NODES=()
subtree_gate() { # <verb> <target>
  local verb="$1" target="$2" udir uname own other descendants="" p foreign=0
  SUBTREE_NODES=()

  for udir in "$LOCKED_STATE_ROOT"/*/; do
    uname="$(basename "$udir")"
    case "$uname" in .*) continue ;; esac
    [ "$uname" = "$inv" ] && continue
    other="$(pool_records_under "${udir}pool" "$target")"
    [ -n "$other" ] || continue
    if [ "$foreign" -eq 0 ]; then
      say_err "${E_RED}${E_B}✗ refusing $verb:${E_OFF} it holds locked records that are not yours" "$target"
      foreign=1
    fi
    echo "  pool of $uname:" >&2
    while IFS= read -r p; do
      [ -z "$p" ] || path_lines "    " "$p" >&2
    done <<EOF
$other
EOF
  done
  if [ "$foreign" -eq 1 ]; then
    echo >&2
    echo "${E_YEL}note:${E_OFF} locked will not rewrite another user's record on their behalf," >&2
    echo "      and --recursive does not widen that. They release theirs first." >&2
    log_action "$verb" "$target" refuse-foreign-records
    return 1
  fi

  own="$(pool_records_under "$USER_POOL" "$target" | sort -r)"
  [ -n "$own" ] || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    SUBTREE_NODES+=("$p")
    [ "$p" = "$target" ] && continue
    descendants="$descendants$p"$'\n'
  done <<EOF
$own
EOF

  # The named node's own record is the ordinary case; records BELOW it are
  # the ones a plain `rm` would silently orphan.
  [ -n "$descendants" ] || return 0
  if [ "$OPT_RECURSIVE" -eq 1 ]; then
    return 0
  fi
  {
    set_pal
    local et
    esc_into et "$target" "$P_RV"
    echo "${P_RED}${P_B}✗ refusing $verb:${P_OFF} locked records live under it: $et"
    echo
    echo "${P_B}records under it:${P_OFF}"
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      status_row "$p" brief || true
    done <<EOF
$descendants
EOF
    echo
    echo "${P_YEL}note:${P_OFF} acting on it takes those paths with it, so their records"
    echo "      change too."
    cmd_rows "      " \
      "sudo locked $verb --recursive $(shq "$target")" "proceeds and updates them"
  } >&2
  log_action "$verb" "$target" refuse-subtree
  return 1
}

# Apply the per-node record side-effect to everything the gate collected.
# <bin> is the top-level bin location and only used by trash: a child of a
# trashed directory sits at that location plus its path relative to the
# node that was trashed.
apply_subtree_effect() { # <verb> <target> [<bin>]
  local verb="$1" target="$2" bin="${3:-}" i n rel rc=0
  i=0
  while [ "$i" -lt "${#SUBTREE_NODES[@]}" ]; do
    n="${SUBTREE_NODES[$i]}"
    i=$((i + 1))
    case "$verb" in
      rm)
        retire_record "$n" rm || rc=1
        ;;
      trash)
        rel="${n#"$target"}"
        suspend_record "$n" "${bin}${rel}" || rc=1
        ;;
    esac
  done
  return "$rc"
}

# mv and rekey share this: every collected record moves by prefix rewrite.
rekey_subtree() { # <oldtarget> <newtarget>
  local old="$1" new="$2" i n rel rc=0
  i=0
  while [ "$i" -lt "${#SUBTREE_NODES[@]}" ]; do
    n="${SUBTREE_NODES[$i]}"
    i=$((i + 1))
    rel="${n#"$old"}"
    rekey_record "$n" "${new}${rel}" || rc=1
  done
  return "$rc"
}

# ---- chain diagnosis -------------------------------------------------------

# The nearest ancestor whose flags stop an entry under it from being
# removed or renamed. Reports what is OBSERVED; whether locked set the
# flag is a separate question, asked of the record by explain_blocker.
# Sets BLOCK_PATH and BLOCK_FLAG; returns 1 when nothing blocks.
BLOCK_PATH=""
BLOCK_FLAG=""
blocking_ancestor() { # <path>
  local p fl
  BLOCK_PATH=""
  BLOCK_FLAG=""
  p="$(dirname "$1")"
  while :; do
    fl="$(flags_of "$p" 2>/dev/null)" || fl=""
    case ",$fl," in
      *,sappnd,*) BLOCK_PATH="$p"; BLOCK_FLAG=sappnd; return 0 ;;
      *,schg,*)   BLOCK_PATH="$p"; BLOCK_FLAG=schg;   return 0 ;;
      *,uappnd,*) BLOCK_PATH="$p"; BLOCK_FLAG=uappnd; return 0 ;;
      *,uchg,*)   BLOCK_PATH="$p"; BLOCK_FLAG=uchg;   return 0 ;;
    esac
    [ "$p" = "/" ] && return 1
    p="$(dirname "$p")"
  done
}

# Role-color one command string (terminal-output command-line sub-grammar):
# `sudo` bold, the program token bold cyan (a dir part, were one ever
# shown, plain cyan around a bold basename), option flags bold blue --
# marked LEXICALLY, the token starts with `-` -- paths cyan, everything else
# plain, a placeholder included: one capitalized word (NEW), since a shell
# reads < and > as redirects and a pasted <new> would not run as shown.
# The string is split into shell words the way the shell will read it
# when pasted: on spaces outside single quotes, a backslash keeping the
# next byte in its word, so a path shq quoted is one word and is never
# expanded as a glob. Each word is escaped
# (esc_into). Into CMD_DISP, never through a command substitution, so a
# word that cannot be rendered ends locked rather than a subshell. Uses
# the P_* palette: callers run set_pal first.
CMD_DISP=""
cmd_disp() { # <command-string>
  local out="" sep="" tok="" st prog_pending=1 s="$1" c i n inq=0
  local -a toks=()
  # Bytes, so a multibyte character passes through one byte at a time and
  # is put back together in its word.
  local LC_ALL=C
  n="${#s}"
  i=0
  while [ "$i" -lt "$n" ]; do
    c="${s:$i:1}"
    i=$((i + 1))
    if [ "$inq" -eq 1 ]; then
      tok="$tok$c"
      [ "$c" != "'" ] || inq=0
      continue
    fi
    case "$c" in
      "'") inq=1; tok="$tok$c" ;;
      '\') tok="$tok$c${s:$i:1}"; i=$((i + 1)) ;;
      ' ')
        [ -z "$tok" ] || toks+=("$tok")
        tok=""
        ;;
      *) tok="$tok$c" ;;
    esac
  done
  [ -z "$tok" ] || toks+=("$tok")
  for tok in ${toks[@]+"${toks[@]}"}; do
    case "$tok" in
      sudo)  st="$P_B" ;;
      -*)    st="$P_BLU" ;;
      */*)   st="$P_CYN" ;;
      *)
        st=""
        if [ "$prog_pending" -eq 1 ]; then
          st="$P_B$P_CYN"
          prog_pending=0
        fi
        ;;
    esac
    esc_into tok "$tok" "$P_RV" "$st"
    out="$out$sep$st$tok${st:+$P_OFF}"
    sep=' '
  done
  CMD_DISP="$out"
}

# Aligned command/description rows: the gutter is the longest command plus
# two spaces, the same docopt convention the usage text follows. Paths make
# these commands variable-length, so the width is computed, not guessed --
# and when the widest row would not fit 80 columns the description drops to
# its own continuation line instead of running off the screen. That is also
# docopt: a pattern too long to align takes its description below it.
# Width math runs on the PLAIN string before color is wrapped around it
# (escape bytes would count against %-*s); descriptions render dim -- they
# are explanation, not command. Args alternate <command> <description>;
# bash 3.2 has no stride loop, so the positional list is walked by index.
cmd_rows() { # <indent> [<command> <description>]...
  local indent="$1" w=0 dw=0 i j c d ce
  set_pal
  shift
  # Widths come off the escaped command, which is what the row shows.
  i=1
  while [ "$i" -le "$#" ]; do
    j=$((i + 1))
    esc_into ce "${!i}"
    d="${!j}"
    if [ "${#ce}" -gt "$w" ]; then w="${#ce}"; fi
    if [ "${#d}" -gt "$dw" ]; then dw="${#d}"; fi
    i=$((i + 2))
  done
  local wrap=0
  if [ $(( ${#indent} + w + 2 + dw )) -gt 80 ]; then wrap=1; fi
  i=1
  while [ "$i" -le "$#" ]; do
    j=$((i + 1))
    c="${!i}"
    d="${!j}"
    esc_into ce "$c"
    cmd_disp "$c"
    if [ "$wrap" -eq 1 ]; then
      printf '%s%s\n%s    %s%s%s\n' "$indent" "$CMD_DISP" \
        "$indent" "$P_DIM" "$d" "$P_OFF"
    else
      printf '%s%s%*s%s%s%s\n' "$indent" "$CMD_DISP" \
        $(( w - ${#ce} + 2 )) '' "$P_DIM" "$d" "$P_OFF"
    fi
    i=$((i + 2))
  done
}

# Name the constraint and the remedy for it. Which remedy depends on WHO
# set the flag: a sealed pool node is locked's to move, so the mediated
# verb applies; a flag locked never recorded is the operator's own chflags,
# and offering a locked verb there emits a command that cannot work.
# $3.. are command/description pairs. Clobbers the snap_paths globals.
explain_blocker() { # <node> <flag> [<command> <description>]...
  local n="$1" fl="$2"
  shift 2
  set_pal
  local en
  esc_into en "$n" "$P_RV"
  echo "${P_YEL}note:${P_OFF} this directory is flagged $fl, so entries under it cannot"
  echo "      be removed or renamed while it is sealed: $en"
  snap_paths "$n"
  if [ -f "$META" ] && [ "$(meta_field "$META" state)" = "locked" ]; then
    if [ "$#" -gt 0 ]; then
      cmd_rows "      " "$@"
    fi
  else
    echo "      locked has no record of that flag -- it was set outside the"
    echo "      pool, so no locked verb releases it."
    cmd_rows "      " "sudo chflags no$fl $(shq "$n")" "releases it (re-apply it yourself after)"
  fi
}

# The motivating case: a named path is not a pool node, and the answer
# "not in pool" is accurate and useless because the constraint is one
# level up. Print the chain in the status layout, then the constraint.
# $2.. are command/description pairs to offer.
chain_diagnosis() { # <path> [<command> <description>]...
  local f="$1"
  shift
  blocking_ancestor "$f" || return 0
  echo
  print_chain "$f" brief
  echo
  explain_blocker "$BLOCK_PATH" "$BLOCK_FLAG" "$@"
}

# ---- actions ---------------------------------------------------------------

do_lock_one() {
  local f
  f="$(leaf_path "$1")" || return 1
  local is_link=0
  [ -L "$f" ] && is_link=1
  # A link takes none of these checks: -e and -f follow it, so they answer
  # about the TARGET, and the target is not the node being sealed. What the
  # link points AT is not checked at all -- a dangling link is a node whose
  # target is absent right now (a volume not mounted, a file its first run
  # creates), and it is sealed as a link node like any other. Whether that
  # is worth sealing is the operator's call, so the witness says the target
  # is missing and the gate decides.
  if [ "$is_link" -eq 0 ]; then
    [ -e "$f" ] || { say_err "skipped, does not exist" "$f"; log_action lock "$f" skip-noent; return 1; }
    if [ ! -f "$f" ] && [ ! -d "$f" ]; then
      say_err "skipped, not a regular file or directory" "$f"
      return 1
    fi
  fi

  local under_ssh=0
  case "$f" in
    "$user_home/.ssh"|"$user_home/.ssh/"*) under_ssh=1 ;;
  esac

  # The tier follows the path: anchor for ~ itself and everything under
  # ~/.ssh (sshd and the ssh client identity-check those, so their owner
  # must never change), content for everything else. There is no option: a
  # chain directory is never named -- it is derived from the leaves below it
  # (see plan_releases) -- and nothing else is a choice worth offering.
  #
  # A symlink takes the content tier wherever it is, ~/.ssh included. Every
  # one of those identity checks resolves the path, so it judges the target
  # and never the link, and content is the tier that seals a node as itself,
  # which is the whole point of naming a link here.
  local leaf_tier=content
  if [ "$is_link" -eq 0 ] && { [ "$f" = "$user_home" ] || [ "$under_ssh" -eq 1 ]; }; then
    leaf_tier=anchor
  fi

  # A chain directory is sealed for the leaves under it. Protecting it as
  # content would freeze everything inside it, which is a different seal
  # altogether, so say so rather than guess.
  snap_paths "$f"
  local rec_role=""
  if record_live "$META"; then
    rec_role="$(meta_field "$META" role)"
    if [ "$(meta_field "$META" tier)" = "placement" ]; then
      err_val "sealed as a chain directory for the files under it" "$f"
      echo "         Protecting it as content would freeze everything inside it. Protect" >&2
      echo "         the files you mean instead; this seal goes when nothing needs it." >&2
      log_action lock "$f" refuse-chain-dir
      return 1
    fi
  fi

  # Anchor-flag default: sappnd, except regular files under ~/.ssh freeze
  # hard (schg) -- an append-only ssh config or authorized_keys is still an
  # injection surface. Explicit --flag overrides (the TOFU known_hosts file
  # WANTS sappnd).
  local leaf_flag="$OPT_FLAG"
  if [ "$leaf_tier" = "anchor" ] && [ "$OPT_FLAG_SET" -eq 0 ] && [ -f "$f" ]; then
    leaf_flag=schg
  fi

  # Derive the chain before touching anything; refuse on a bad stop node.
  local chain
  chain="$(chain_for "$f")" || return 1

  # ---- plan ----------------------------------------------------------------
  #
  # Collected leaf first, then ancestors nearest-first: that is the order
  # the seals run in below, and the display reverses it. Any refusal here
  # ends the ceremony with nothing touched.
  local -a plan_paths plan_tiers plan_flags plan_actions plan_ids
  plan_paths=(); plan_tiers=(); plan_flags=(); plan_actions=(); plan_ids=()
  local act
  # The leaf is pinned by identity before it is planned: the witness reads
  # this node and the seal acts on this node, by descriptor, so a node
  # swapped in after the plan is refused rather than sealed.
  local leaf_id
  leaf_id="$(node_id "$f")" || return 1
  act="$(plan_node "$f" "$leaf_tier" "$leaf_flag")" || return 1
  # An anchor that is already sealed as somebody's chain node becomes yours
  # by name: nothing on disk changes, but the record's role does, and from
  # then on no release plan may take it.
  if [ "$act" = "already locked" ] && [ "$rec_role" = "chain" ]; then
    act="protect"
  fi
  plan_paths+=("$f")
  plan_tiers+=("$leaf_tier")
  plan_flags+=("$leaf_flag")
  plan_actions+=("$act")
  plan_ids+=("$leaf_id")

  # The chain feeds fd 3, not stdin: this loop spawns the window helper (for
  # node identity) once per ancestor, every child inherits this process's
  # stdin, and a plain `done <<EOF` would leave chain text sitting in front
  # of the gate that follows.
  #
  # A placement ancestor is pinned by identity too, like the leaf: its seal
  # hands it to the lock account, and the folders above it are still yours
  # until the chain reaches them, so the node the plan saw is the only one
  # the seal takes.
  local a t nid
  while IFS= read -r a <&3; do
    [ -n "$a" ] || continue
    [ "$a" = "$f" ] && continue
    t="$(tier_for_ancestor "$a")"
    nid=-
    if [ "$t" = "placement" ]; then
      nid="$(node_id "$a")" || return 1
    fi
    act="$(plan_node "$a" "$t" sappnd)" || return 1
    plan_paths+=("$a")
    plan_tiers+=("$t")
    plan_flags+=(sappnd)
    plan_actions+=("$act")
    plan_ids+=("$nid")
  done 3<<EOF
$chain
EOF

  # Everything nothing needs once this leaf is protected: a directory that
  # used to be sealed for a leaf that is gone, or the leaf's own parent
  # from before the chain left it out.
  plan_releases "" "$f"

  local n i w=7 seals=0 protects=0 releases
  releases="${#RELEASE_PATHS[@]}"
  n="${#plan_paths[@]}"
  i=0
  while [ "$i" -lt "$n" ]; do
    case "${plan_actions[$i]}" in
      "already locked") ;;
      protect) protects=$((protects + 1)) ;;
      *) seals=$((seals + 1)) ;;
    esac
    if [ "$(dispw "${plan_actions[$i]}")" -gt "$w" ]; then
      w="$(dispw "${plan_actions[$i]}")"
    fi
    i=$((i + 1))
  done

  # A chain that is already whole asks nothing: there is no change to
  # consent to, and a gate over an empty set trains the eye to say yes.
  if [ $((seals + protects + releases)) -eq 0 ]; then
    local ef
    esc_into ef "$f" "$C_RV"
    echo "already locked: $ef"
    log_action lock "$f" skip-already-locked
    return 0
  fi

  # The witness first (what the leaf holds now against what it held when it
  # was released), then the plan, then the one question.
  case "${plan_actions[0]}" in
    "already locked"|protect) ;;
    *) lock_witness "$f" "$leaf_tier" "$leaf_id" || return 1 ;;
  esac

  # Root-most first: a tree reads top-down, and the node that governs
  # everything under it is the one to read first. The plan shares the
  # prompt's stream, so redirecting stdout can never separate the gate from
  # the list it is about. Already-locked rows are dim -- they are context,
  # not offer. Releases follow the chain in the same column, each with the
  # reason a reader needs in the qualifier column: a directory leaving the
  # pool is the one row that is not self-explanatory.
  local qw
  qw="$(release_qwidth)"
  echo "${E_B}plan (tier $leaf_tier):${E_OFF}" >&2
  i=$((n - 1))
  while [ "$i" -ge 0 ]; do
    case "${plan_actions[$i]}" in
      "already locked")
        plan_row "  " "$w" "${plan_actions[$i]}" "$qw" "" "${plan_paths[$i]}" dim
        ;;
      protect)
        plan_row "  " "$w" protect "$qw" "" "${plan_paths[$i]}"
        note_row "$(plan_col "  " "$w" "$qw")" "already sealed; now protected by name"
        ;;
      *)
        plan_row "  " "$w" "${plan_actions[$i]}" "$qw" "" "${plan_paths[$i]}"
        ;;
    esac
    i=$((i - 1))
  done
  release_rows "  " "$w" "$qw"
  echo >&2
  # Caveats, not refusals: said under the plan they are about, before the
  # question, and only for a leaf this plan actually seals. An anchor folder
  # has none (it seals no node below it, and for ~ the scan would walk the
  # whole home folder); plan_notes says so itself.
  case "${plan_actions[0]}" in
    "already locked"|protect) ;;
    *)
      local first=1
      snap_paths "$f"
      record_live "$META" && first=0
      plan_notes "$f" "$first" "$leaf_tier"
      ;;
  esac

  if [ "$OPT_DRY" -eq 1 ]; then
    echo "dry run: nothing changed" >&2
    log_action lock "$f" dry-run
    return 0
  fi

  # The question holds no value and is one verb and its noun: the path
  # stands on the row above it, and the counts are the consequence line.
  local q
  if [ "$seals" -gt 0 ]; then
    q="seal this path as listed?"
  else
    q="apply the plan for this path?"
  fi
  asking && value_rows "" path subject "$f" >&2
  confirm "$q" "$(change_sentence "$seals" "$protects" "$releases")" || {
    # The decline is the decision this run made, so it goes in the log
    # beside the seals that were taken -- and it is the whole record of
    # the run, since not one node was touched.
    log_action lock "$f" abort
    echo "${E_YEL}aborted; nothing changed${E_OFF}" >&2
    return 2
  }

  # ---- apply ---------------------------------------------------------------
  #
  # Releases first: a node leaving the pool is never one this plan seals
  # (the needed set holds every node of this chain), so the order is free,
  # and done first no seal below can trip over a flag about to go. Then the
  # leaf, then ancestors nearest-first (the plan's own order), and no
  # further questions: the gate above answered for all of them.
  apply_releases || return 1
  local role
  i=0
  while [ "$i" -lt "$n" ]; do
    case "${plan_actions[$i]}" in
      "already locked") ;;
      protect)
        snap_paths "${plan_paths[$i]}"
        rewrite_meta_role "$META" leaf || return 1
        ok_row protected "${plan_paths[$i]}" "already sealed; now yours by name"
        log_action lock "${plan_paths[$i]}" protect
        ;;
      *)
        case "${plan_tiers[$i]}" in
          content)   seal_content "${plan_paths[$i]}" "$leaf_id" || return $? ;;
          placement) seal_placement "${plan_paths[$i]}" "${plan_ids[$i]}" || return $? ;;
          anchor)
            # The named node is a leaf. An ancestor keeps a leaf role it
            # already has -- a node you named stays yours when some other
            # chain runs through it -- and is a chain node otherwise.
            role=chain
            if [ "$i" -eq 0 ]; then
              role=leaf
            else
              snap_paths "${plan_paths[$i]}"
              if record_live "$META" && [ "$(meta_field "$META" role)" = "leaf" ]; then
                role=leaf
              fi
            fi
            # Only the leaf was pinned at plan time; an ancestor anchor is
            # gated by its owner alone.
            local aid=-
            [ "$i" -eq 0 ] && aid="$leaf_id"
            seal_anchor "${plan_paths[$i]}" "${plan_flags[$i]}" "$role" "$aid" || return $?
            ;;
        esac
        ;;
    esac
    i=$((i + 1))
  done
}

# change_sentence <seals> <protects> <releases>: what a yes to the plan
# does, as the consequence line above its question -- "This seals 2 nodes
# and releases 1 directory." Only the kinds with a nonzero count, in that
# order.
change_sentence() {
  local parts=() out="" i n
  [ "$1" -eq 0 ] || parts+=("seals $1 $(plural "$1" node nodes)")
  [ "$2" -eq 0 ] || parts+=("protects $2 $(plural "$2" node nodes) by name")
  [ "$3" -eq 0 ] || parts+=("releases $3 $(plural "$3" directory directories)")
  n="${#parts[@]}"
  [ "$n" -gt 0 ] || return 0
  i=0
  while [ "$i" -lt "$n" ]; do
    if [ "$i" -eq 0 ]; then
      out="${parts[$i]}"
    elif [ "$i" -eq $((n - 1)) ]; then
      out="$out and ${parts[$i]}"
    else
      out="$out, ${parts[$i]}"
    fi
    i=$((i + 1))
  done
  printf 'This %s.' "$out"
}

plural() { # <n> <one> <many>
  if [ "$1" -eq 1 ]; then printf '%s' "$2"; else printf '%s' "$3"; fi
}

do_unlock_one() {
  local f
  # leaf_path, not readlink -f: a sealed symlink is a record of its own, and
  # resolving through it here would look for the target's record and report
  # the link as "not in pool".
  f="$(leaf_path "$1")" || return 1
  release_node "$f" || return $?
  if [ "$OPT_CHAIN" -eq 1 ]; then
    local chain a
    chain="$(chain_for "$f")" || return 1
    # A skipped leaf parent may still hold a placement record -- it is a
    # higher ancestor of some other sealed leaf. Its uappnd is exactly what
    # a rename into this directory trips over, which is the whole reason
    # --chain exists, so it is released here too. A parent with no record
    # falls through the meta test below; an anchor parent is already in the
    # chain and must not be listed twice.
    if chain_skips_parent "$f"; then
      chain="$(dirname "$f")
$chain"
    fi
    # Chain on fd 3, stdin left alone, for the reason given in do_lock_one.
    while IFS= read -r a <&3; do
      [ -n "$a" ] || continue
      snap_paths "$a"
      [ -f "$META" ] || continue
      release_node "$a" || return $?
    done 3<<EOF
$chain
EOF
    local ef
    esc_into ef "$(shq "$f")" "$C_RV" "$C_CYN"
    echo "chain released; relock with: ${C_CYN}sudo locked lock $ef${C_OFF}"
  fi
}

# ---- unprotect --------------------------------------------------------------
#
# The permanent counterpart of lock. unlock is the edit window: it keeps the
# record, the snapshot and the chain, because the seal is coming back.
# unprotect ends the protection: the leaf goes back to the identity it had
# before it was locked, its record retires via=unprotect, and every chain
# directory no other protected file needs is released in the same plan and
# under the same one question.

# identity_text <metafile>: "644 jooize:staff" for the result and plan rows:
# the mode is a field of known width, the owner and group are names, which
# end the line.
identity_text() {
  printf '%s %s:%s' "$(meta_field "$1" mode)" "$(meta_field "$1" owner)" \
    "$(meta_field "$1" group)"
}

do_unprotect_one() {
  local f
  # leaf_path, so a protected symlink is one node here too.
  f="$(leaf_path "$1")" || return 1
  snap_paths "$f"
  if ! record_live "$META"; then
    say_err "skipped, not protected" "$f"
    log_action unprotect "$f" skip-no-record
    return 1
  fi
  local role state tier back
  role="$(meta_field "$META" role)"
  state="$(meta_field "$META" state)"
  tier="$(meta_field "$META" tier)"
  if [ "$role" != "leaf" ]; then
    say_err "skipped, sealed as part of a chain, not protected by name" "$f"
    echo "  it is released by the first plan in which no protected file needs it" >&2
    log_action unprotect "$f" skip-chain-node
    return 1
  fi
  if [ "$state" = "suspended" ]; then
    say_err "skipped, in the trash (record suspended); nothing here to unprotect" "$f"
    log_action unprotect "$f" skip-suspended
    return 1
  fi

  plan_releases "$f" ""

  # What the leaf goes back to, in the words the result line will use.
  case "$tier" in
    anchor) back="$(meta_field "$META" flag) cleared" ;;
    *)
      if [ -L "$f" ]; then
        back="back to $(meta_field "$META" owner):$(meta_field "$META" group)"
      else
        back="back to $(identity_text "$META")"
      fi
      ;;
  esac

  local w=9 qw
  qw="$(release_qwidth)"
  echo "${E_B}plan:${E_OFF}" >&2
  plan_row "  " "$w" unprotect "$qw" "" "$f"
  note_row "$(plan_col "  " "$w" "$qw")" "$back"
  release_rows "  " "$w" "$qw"
  echo >&2

  if [ "$OPT_DRY" -eq 1 ]; then
    echo "dry run: nothing changed" >&2
    log_action unprotect "$f" dry-run
    return 0
  fi

  # The question holds no value and is one verb and its noun: the path
  # stands on the row above it, the releases are the consequence line.
  local c="" nr="${#RELEASE_PATHS[@]}"
  if [ "$nr" -gt 0 ]; then
    c="This also releases $nr $(plural "$nr" directory directories)."
  fi
  asking && value_rows "" path subject "$f" >&2
  confirm "stop protecting this path?" "$c" || {
    log_action unprotect "$f" abort
    echo "${E_YEL}aborted; protection unchanged${E_OFF}" >&2
    return 2
  }

  unprotect_leaf "$f" "$back" || return 1
  apply_releases || return 1
}

# unprotect_leaf <path> <result text>: flag off (unless an unlock already
# took it), recorded identity back, record retired. An unlocked content
# leaf is already the invoker's again -- unlock restored owner and mode --
# so only the record is left to close.
unprotect_leaf() {
  local f="$1" back="$2" tier flag recursive owner group mode state
  snap_paths "$f"
  tier="$(meta_field "$META" tier)"
  flag="$(meta_field "$META" flag)"
  recursive="$(meta_field "$META" recursive)"
  owner="$(meta_field "$META" owner)"
  group="$(meta_field "$META" group)"
  mode="$(meta_field "$META" mode)"
  state="$(meta_field "$META" state)"
  if [ "$state" = "locked" ]; then
    # Through the helper, as release_node does it: the recorded node only,
    # each node gated by its owner on its own descriptor.
    local rid owners="$lock_user"
    rid="$(helper_id_for "$f")"
    [ "$owner" = "$inv" ] && owners="$lock_user,$inv"
    case "$tier" in
      content)
        local -a how=(--path "$f" --id "$rid" --owner "$owners"
          --chown "${owner}:${group}" --flag "$flag")
        if [ "$recursive" = "1" ]; then
          local count
          count="$(node_count "$f")" || return 1
          node_op unprotect "$f" unseal "${how[@]}" --mode "$mode" \
            --count "$count" --recursive || return 1
        elif [ -L "$f" ]; then
          # No mode on a link: a link's own mode gates nothing.
          node_op unprotect "$f" unseal "${how[@]}" --count 1 || return 1
        else
          node_op unprotect "$f" unseal "${how[@]}" --mode "$mode" --count 1 || return 1
        fi
        ;;
      anchor)
        node_op unprotect "$f" unseal --path "$f" --id "$rid" --owner "$inv" \
          --count 1 --flag "$flag" || return 1
        ;;
      *)
        err_val "the record has tier '$tier'; only a leaf can be unprotected" "$f"
        return 1
        ;;
    esac
  fi
  retire_record "$f" unprotect quiet || return 1
  ok_row unprotected "$f" "$back"
  log_action unprotect "$f" ok
}

# The staging file both edit paths freeze their candidate into: a fresh
# name in the lock account's mode-700 dir, out of the invoker's reach.
stage_new() {
  local stage_dir="$USER_POOL/.staging"
  install -d -m 700 -o "$lock_user" -g "$lock_user" "$stage_dir" || return 1
  mktemp "${stage_dir}/edit.XXXXXX"
}

# sealed_folder_for <path> <is-new>: a file with no record of its own may
# sit inside a folder sealed as content, whose one record covers the whole
# tree. Finds the nearest such folder above <path> and sets EDIT_FOLDER.
# Returns 1 with the reason on stderr when there is none, when the folder
# is unlocked or is not the node its record names, or when any node from
# <path> up to it is not sealed the way the record says -- an edit must
# never be the step that seals a node nobody checked. Returns 3 when no
# live folder record covers <path>, so the caller keeps its own message.
EDIT_FOLDER=""
sealed_folder_for() { # <path> <is-new>
  local f="$1" is_new="$2" d cur sn=0
  EDIT_FOLDER=""
  d="$(dirname "$f")"
  while :; do
    snap_paths "$d"
    if record_live "$META" &&
       [ "$(meta_field "$META" tier)" = "content" ] &&
       [ "$(meta_field "$META" recursive)" = "1" ]; then
      break
    fi
    [ "$d" = "/" ] && return 3
    d="$(dirname "$d")"
  done
  # Each refusal names the file last on its own line, and the folder (and
  # the node) on rows under it: two paths never share a line.
  if [ "$(meta_field "$META" state)" != "locked" ]; then
    say_err "skipped, its folder is unlocked" "$f"
    value_rows "  " folder id "$d" >&2
    cmd_rows "  " "sudo locked lock $(shq "$d")" "seals it again once you have edited the file directly" >&2
    return 1
  fi
  cur="$(node_id "$d")" || {
    say_err "skipped, cannot read the identity of its folder" "$f"
    value_rows "  " folder id "$d" >&2
    return 1
  }
  same_node "$(meta_field "$META" id)" "$cur" || sn=$?
  if [ "$sn" -ne 0 ]; then
    say_err "skipped, its folder is not the node its record names" "$f"
    value_rows "  " folder id "$d" >&2
    cmd_rows "  " "sudo locked status $(shq "$d")" "shows what the record says" >&2
    return 1
  fi
  # Every node from the file up to the folder: lock-owned and frozen, as
  # verify expects of a sealed tree. The path was resolved, so none of
  # them is a link; a missing file checks from its parent.
  local n="$f"
  [ "$is_new" -eq 1 ] && n="$(dirname "$f")"
  local bad
  while :; do
    bad=0
    [ -L "$n" ] && bad=1
    [ "$(stat -f '%Su' "$n")" = "$lock_user" ] || bad=1
    if [ "$n" = "$f" ]; then
      [ -f "$n" ] || bad=1
    else
      [ -d "$n" ] || bad=1
    fi
    if [ "$bad" -eq 1 ]; then
      say_err "skipped, a node is not sealed as its folder's record says" "$f"
      value_rows "  " node id "$n" folder id "$d" >&2
      cmd_rows "  " "sudo locked status $(shq "$d")" "shows what the record says" >&2
      return 1
    fi
    case ",$(flags_of "$n")," in
      *,uchg,*) ;;
      *)
        say_err "skipped, a node is not frozen (uchg) as its folder's record says" "$f"
        value_rows "  " node id "$n" folder id "$d" >&2
        cmd_rows "  " "sudo locked status $(shq "$d")" "shows what the record says" >&2
        return 1
        ;;
    esac
    [ "$n" = "$d" ] && break
    n="$(dirname "$n")"
  done
  EDIT_FOLDER="$d"
}

# check_install <path> <stage> <owner> <mode> <flag> <dir flags before>:
# run once an edit has installed and resealed <path>. The file must hold
# exactly the approved bytes (still in <stage>, out of the invoker's
# reach), with the owner, mode and flag the edit set, and its directory
# must carry the flags it had before the install. Only root or a bug could
# make any of these differ, since nothing running as the invoker can write
# there. Prints what differs as a comma list (type, content, owner, mode,
# flags, folder-flags) and returns 1 when anything does.
check_install() {
  local f="$1" stage="$2" owner="$3" mode="$4" flag="$5" dflags="$6" bad=""
  if [ -L "$f" ] || [ ! -f "$f" ]; then
    printf 'type'
    return 1
  fi
  cmp -s -- "$stage" "$f" || bad="$bad,content"
  [ "$(stat -f '%Su' "$f")" = "$owner" ] || bad="$bad,owner"
  [ "$(stat -f '%OLp' "$f")" = "$mode" ] || bad="$bad,mode"
  case ",$(flags_of "$f")," in
    *,"$flag",*) ;;
    *) bad="$bad,flags" ;;
  esac
  [ "$(flags_of "$(dirname "$f")")" = "$dflags" ] || bad="$bad,folder-flags"
  [ -z "$bad" ] && return 0
  printf '%s' "${bad#,}"
  return 1
}

# mismatch_line <path> <what differed>: the record line for a failed
# check_install, or nothing when it passed.
mismatch_line() {
  if [ -n "$2" ]; then
    printf 'mismatch=%s %s %s' "$(now_utc)" "$2" "$(verify_escape "$1")"
  fi
}

# note_folder_install <metafile> <path> <what differed>: puts the outcome
# of check_install on the folder record that covers <path>. A failure adds
# a line; a clean install drops any earlier line for the same file, which
# now holds bytes you approved. Nothing else in the record changes.
note_folder_install() {
  local meta="$1" f="$2" what="$3" keep
  keep="$(mismatch_kv "$meta" "$f")"
  if [ -z "$what" ] && [ "$keep" = "$(mismatch_kv "$meta")" ]; then
    return 0
  fi
  write_meta "$meta" \
    "owner=$(meta_field "$meta" owner)" \
    "group=$(meta_field "$meta" group)" \
    "mode=$(meta_field "$meta" mode)" \
    "lockmode=$(meta_field "$meta" lockmode)" \
    "tier=$(meta_field "$meta" tier)" \
    "flag=$(meta_field "$meta" flag)" \
    "flagsym=$(meta_field "$meta" flagsym)" \
    "id=$(meta_field "$meta" id)" \
    "recursive=$(meta_field "$meta" recursive)" \
    "role=$(meta_field "$meta" role)" \
    "$(acl_kv "$meta")" \
    "$keep" \
    "$(mismatch_line "$f" "$what")" \
    "state=$(meta_field "$meta" state)" || return 1
}

# report_mismatch <path> <what differed> <record path>: the loud half of a
# failed check_install. The record already carries the line; a verify run
# now puts it in the status file, so a statusline shows it at once rather
# than at the next timer run. Its output is not repeated here: the lines
# above say what drifted, and `locked verify` prints the rest.
report_mismatch() {
  local f="$1" what="$2" rec="$3"
  err_val "installed, but it is not what you approved ($what)" "$f"
  say_err "  recorded as drift until you edit the file again, or unlock and relock this record" "$rec"
  log_action edit "$f" "mismatch-${what//,/-}"
  local OPT_QUIET=1
  do_verify >/dev/null 2>&1 || true
}

# drop_editdir <dir>: remove an edit folder once it is the invoker's, as
# the invoker (see do_edit_one). 9>&-: rm must not hold the run lock.
drop_editdir() {
  sudo -u "$inv" -- /bin/rm -rf -- "$1" 9>&- || true
}

# sudoedit-style edit: the locked file never spends time unlocked. The
# editor runs AS THE INVOKER on a user-owned temp copy; the candidate is
# then pulled into lock-account staging (out of user reach) BEFORE the
# diff is shown, so what you approve is exactly what installs -- a
# tampered copy shows up in the diff. --from replaces the editor with a
# copy the invoker prepared in advance, frozen the same way and at the
# same point in the flow. Either candidate is READ AS THE INVOKER, so a
# symlink left in its place resolves with the invoker's privileges and
# never with root's -- otherwise a same-UID process could route a
# root-only file's bytes into staging and, once approved, into a file the
# invoker can read. atomic_replace lifts append flags on the parent, so
# no chain release is needed.
do_edit_one() {
  local f="$1" link=""
  # A symlink is followed, as an editor follows it: what gets edited is the
  # file it points at, resolved once here. From then on everything works on
  # that file -- its record, and the node pinned by id below -- so a link
  # re-pointed mid-edit changes nothing, and a target that is not sealed in
  # your pool is refused like any other file. The link is shown beside the
  # file above the diff and the question, so the file you approve is never
  # one you did not see named. A dangling link names a file to create, which
  # only a sealed folder can take (below).
  if [ -L "$f" ]; then
    local ld
    ld="$(readlink -f "$(dirname -- "$f")")" || { say_err "skipped, cannot resolve" "$1"; return 1; }
    link="${ld%/}/$(basename -- "$f")"
    f="$(readlink -f "$f")" || { say_err "skipped, cannot resolve the file the link points at" "$1"; return 1; }
  fi
  # A file that does not exist yet has nothing to resolve: its folder is
  # resolved and the name kept. Only a sealed folder can take one (below).
  local is_new=0 base
  if [ -e "$f" ]; then
    f="$(readlink -f "$f")" || { say_err "skipped, cannot resolve" "$1"; return 1; }
    [ -f "$f" ] || { say_err "skipped, edit supports regular files only" "$f"; return 1; }
  else
    base="$(basename -- "$f")"
    case "$base" in
      .|..|'') say_err "skipped, not a file name" "$f"; return 1 ;;
    esac
    f="$(readlink -f "$(dirname -- "$f")")" || { say_err "skipped, cannot resolve" "$1"; return 1; }
    f="${f%/}/$base"
    is_new=1
  fi

  # The file's own record, or else the record of the sealed folder it sits
  # in. A folder sealed as content has one record for its whole tree, and
  # an edit inside it follows that record: lock account, uchg, the file's
  # own mode (a new file takes the folder's without execute bits). No
  # record is written for the file, and there is no per-file snapshot, so
  # revert does not apply; the folder's snapshot is renewed at its unlock.
  local tier state flag mode owner group folder="" frc=0
  snap_paths "$f"
  if [ ! -f "$META" ]; then
    sealed_folder_for "$f" "$is_new" || frc=$?
    if [ "$frc" -eq 3 ]; then
      say_err "skipped, not in pool (edit works on locked files, or files in a locked folder; use lock to adopt)" "$f"
      return 1
    fi
    [ "$frc" -eq 0 ] || { log_action edit "$f" refuse-folder; return 1; }
    folder="$EDIT_FOLDER"
    snap_paths "$folder"
    tier=content
    state=locked
    flag="$(meta_field "$META" flag)"
    owner="$(meta_field "$META" owner)"
    group="$(meta_field "$META" group)"
    if [ "$is_new" -eq 1 ]; then
      mode="$(printf '%o' $(( 0$(meta_field "$META" lockmode) & 0666 )))"
    else
      mode="$(stat -f '%OLp' "$f")"
    fi
  else
    [ "$is_new" -eq 0 ] && [ -f "$f" ] || { say_err "skipped, edit supports regular files only" "$f"; return 1; }
    tier="$(meta_field "$META" tier)"
    state="$(meta_field "$META" state)"
    flag="$(meta_field "$META" flag)"
    mode="$(meta_field "$META" mode)"
    owner="$(meta_field "$META" owner)"
    group="$(meta_field "$META" group)"
    case "$tier" in
      content|anchor) ;;
      *) say_err "skipped, edit supports content/anchor files, not tier '$tier'" "$f"; return 1 ;;
    esac
    if [ "$state" != "locked" ]; then
      say_err "skipped, currently unlocked" "$f"
      cmd_rows "  " "sudo locked lock $(shq "$f")" "seals it again once you have edited it directly" >&2
      return 1
    fi
  fi

  # Whose the sealed file is, and which node it is: every read of it below
  # and every change to its flag goes through the helper gated on both. A
  # file in a sealed folder has no record of its own; sealed_folder_for
  # just checked it is the lock account's and frozen, so its live identity
  # is the one to pin.
  local sealed_owner="$lock_user" fid="-"
  [ "$tier" = "anchor" ] && sealed_owner="$inv"
  if [ "$is_new" -eq 0 ]; then
    if [ -n "$folder" ]; then
      fid="$(node_id "$f")" || return 1
    else
      fid="$(helper_id_for "$f")"
    fi
    fid="${fid/./:}"
  fi

  # Two ways to produce the candidate. Both end with it frozen in $stage,
  # and everything from there down -- the no-change check, the diff, the
  # install -- reads ONLY $stage; neither the editor's copy nor the --from
  # proposal is looked at again.
  # The diff's two sides are named by role and by the subject path, because
  # the staged candidate lives at a private temp path that tells the reader
  # nothing. The label carries exactly the bytes the header showed before --
  # the path -- so nothing new is disclosed, and the diff painter still
  # recognizes the headers by position.
  # A new file's current side is empty: /dev/null, named as the new file.
  local stage label lhs rhs old="$f"
  [ "$is_new" -eq 1 ] && old=/dev/null
  if [ -n "$OPT_FROM" ]; then
    # Freeze FIRST. The proposal sits in the invoker's own space, where
    # anything running as the invoker can swap it at any moment; taking it
    # out of reach before a single byte is displayed is what makes the
    # diff a promise instead of a snapshot of one past moment.
    label='diff current → proposed'
    lhs="current: $f" rhs="proposed: $OPT_FROM"
    [ "$is_new" -eq 1 ] && lhs="new file: $f"
    stage="$(stage_new)" || return 1
    # The root-side redirect is the point, not an oversight (SC2024): the
    # WRITE has to land in lock-account staging; only the READ drops to
    # the invoker, so a planted symlink resolves with their privileges.
    # shellcheck disable=SC2024
    sudo -u "$inv" -- /bin/cat -- "$OPT_FROM" >"$stage" || {
      rm -f -- "$stage"
      say_err "--from: cannot read as $inv" "$OPT_FROM"
      log_action edit "$f" refuse-unreadable-proposal
      return 1
    }
  else
    label='diff current → edited'
    lhs="current: $f" rhs="edited: $f"
    [ "$is_new" -eq 1 ] && lhs="new file: $f"
    # User-owned working copy in a private temp dir; empty for a new file.
    local editdir copy
    editdir="$(mktemp -d /tmp/locked-edit.XXXXXX)" || return 1
    copy="$editdir/$(basename "$f")"
    if [ "$is_new" -eq 1 ]; then
      : >"$copy" || { rm -rf -- "$editdir"; return 1; }
    else
      # Root reads the sealed file into a copy you are given, so it reads
      # it through the owner gate, pinned to the sealed node, into staging
      # first; the working copy is then a plain cp of that, as before.
      local held
      held="$(stage_copy "$f" "$sealed_owner" "$fid")" \
        || { rm -rf -- "$editdir"; return 1; }
      cp -- "$held" "$copy" || { rm -f -- "$held"; rm -rf -- "$editdir"; return 1; }
      rm -f -- "$held"
    fi
    # From the chown on, the folder is yours, and anything running as you
    # can change what is in it or put another folder at its name. So it is
    # removed as you: root never deletes in a tree another account can
    # change, and a swap only ever costs you what you could delete
    # yourself. chown -R takes the folder first, so even a chown cut short
    # leaves it yours to remove; if it did not get that far, the root-owned
    # 700 folder stays in /tmp rather than root deleting by name.
    chown -R "$inv" "$editdir" || { drop_editdir "$editdir"; return 1; }
    chmod 700 "$editdir" || { drop_editdir "$editdir"; return 1; }
    chmod 600 "$copy" || { drop_editdir "$editdir"; return 1; }

    local editor
    editor="${OPT_EDITOR:-${SUDO_EDITOR:-${VISUAL:-${EDITOR:-vi}}}}"
    # 9>&-: the editor must not inherit the run lock (see run_lock_take).
    if ! sudo -u "$inv" -- "$editor" "$copy" 9>&-; then
      say_err "editor exited nonzero; nothing installed" "$f"
      drop_editdir "$editdir"
      return 1
    fi

    # Pull the candidate out of user reach BEFORE showing the diff.
    stage="$(stage_new)" || { drop_editdir "$editdir"; return 1; }
    # Root-side redirect, invoker-side read -- see the --from branch.
    # shellcheck disable=SC2024
    sudo -u "$inv" -- /bin/cat -- "$copy" >"$stage" || {
      rm -f -- "$stage"
      drop_editdir "$editdir"
      say_err "edit: cannot read the edited copy as $inv" "$copy"
      log_action edit "$f" refuse-unreadable-copy
      return 1
    }
    drop_editdir "$editdir"
  fi

  # Decided on the frozen bytes, not on the candidate: the no-change check
  # and the install now agree by construction. An empty new file would
  # show an empty diff, so it is named as empty instead (below).
  # A file with a recorded mismatch is the exception: installing the same
  # bytes again is how you accept what it holds, so it goes on to the
  # question instead of stopping here.
  local unchanged=0
  if [ "$is_new" -eq 0 ] && cmp -s -- "$stage" "$f"; then
    if [ "$(mismatch_kv "$META")" = "$(mismatch_kv "$META" "$f")" ]; then
      rm -f -- "$stage"
      say_out "no changes" "$f"
      log_action edit "$f" skip-unchanged
      return 0
    fi
    unchanged=1
  fi

  # The candidate was read with cat, so it holds content and nothing else.
  # Keeping a sealed file's extended attributes and ACLs is part of what
  # locked is for, so they come from $f -- a re-application onto a
  # candidate that has none of its own, never a merge, and nothing the
  # candidate might have carried is trusted. A new file has none to keep.
  if [ "$is_new" -eq 0 ]; then
    "$LOCKED_HELPER" xattrs-from --src "$f" --src-id "$fid" \
      --owner "$sealed_owner" --as "$inv" --dest "$stage" || {
      rm -f -- "$stage"
      say_err "edit: cannot carry the file's extended attributes onto the candidate" "$f"
      log_action edit "$f" refuse-xattrs
      return 1
    }
  fi

  # An empty new file has no diff to show, so the block says so, and so
  # does the question: an empty file is approved knowingly, never unseen.
  local empty=0
  [ "$is_new" -eq 1 ] && [ ! -s "$stage" ] && empty=1
  # With no diff to show, the rule stands over a note of locked's own and
  # the question's file: row comes right after it; a shown diff gets a
  # file: row of its own, as the question's rows are a diff away from it.
  if [ "$empty" -eq 1 ]; then
    diff_header "$label"
    echo "(new file, empty)"
  elif [ "$unchanged" -eq 1 ]; then
    diff_header "$label"
    echo "(no change; a mismatch is recorded for this file, see: sudo locked verify)"
  else
    show_diff "$label" file "$f" "$old" "$stage" "$lhs" "$rhs" "via link" "$link" \
      || { rm -f -- "$stage"; return 1; }
  fi
  echo
  # The question holds no value: the file, and for a new one its sealed
  # folder, stand on the rows above it, labeled by the nouns the question
  # names them with. What a yes also does is the consequence line.
  local ask c=""
  ask="install and reseal this file?"
  [ "$is_new" -eq 1 ] && ask="create and seal this file in this folder?"
  [ "$empty" -eq 1 ] && ask="create and seal this empty file in this folder?"
  if [ "$unchanged" -eq 1 ]; then
    ask="accept what this file holds now?"
    c="This installs it again and clears the mismatch."
  fi
  if asking; then
    local -a rows=(file subject "$f")
    [ -z "$link" ] || rows+=("via link" id "$link")
    [ "$is_new" -eq 0 ] || rows+=(folder id "$folder")
    value_rows "" "${rows[@]}" >&2
  fi
  confirm "$ask" "$c" || {
    echo "${E_YEL}aborted; file unchanged${E_OFF}" >&2
    rm -f -- "$stage"
    return 2
  }

  # In a sealed folder the file follows the folder's record: frozen with
  # the folder's flag, owned by the lock account, no record of its own.
  # atomic_replace lifts the folder directory's uchg for the rename.
  # Either way the install ends with check_install against the approved
  # bytes, which stay in $stage until then.
  local dflags what=""
  dflags="$(flags_of "$(dirname "$f")")"
  if [ -n "$folder" ]; then
    if [ "$is_new" -eq 0 ]; then
      fclear "$flag" "$f" || { rm -f -- "$stage"; return 1; }
    fi
    # Inside a sealed folder no process of yours can reach the name: the
    # folder is the lock account's and frozen, and atomic_replace lifts its
    # flag only while it is closed to you. So the flags here go by path.
    run atomic_replace "$stage" "$f" "${lock_user}:${lock_user}" "$mode" root || {
      rm -f -- "$stage"
      # The old file is still there: freeze it again before failing.
      [ "$is_new" -eq 1 ] || fset "$flag" "$f" || true
      return 1
    }
    fset "$flag" "$f" || { rm -f -- "$stage"; return 1; }
    what="$(check_install "$f" "$stage" "$lock_user" "$mode" "$flag" "$dflags")" || true
    rm -f -- "$stage"
    note_folder_install "$META" "$f" "$what" || return 1
    if [ -n "$what" ]; then
      report_mismatch "$f" "$what" "$folder"
      return 1
    fi
    if [ "$is_new" -eq 1 ]; then
      ok_row "created and sealed" "$f"
    else
      ok_row "edited and resealed" "$f"
    fi
    log_action edit "$f" ok
    return 0
  fi

  # Snapshot := pre-edit content, so revert undoes exactly this edit.
  run atomic_replace "$f" "$SNAP" "${lock_user}:${lock_user}" 600 "$sealed_owner" "$fid" || { rm -f -- "$stage"; return 1; }

  # The file's own parent is yours and unsealed, so once its flag is off
  # the name can be swapped: the flag comes off the sealed node by its
  # identity, and goes back on the installed inode by ITS identity (AR_ID),
  # so a name planted in between is refused rather than flagged.
  local install_owner="${lock_user}:${lock_user}"
  [ "$tier" = "anchor" ] && install_owner="${owner}:${group}"
  node_op edit "$f" unseal --path "$f" --id "$fid" --owner "$sealed_owner" \
    --count 1 --flag "$flag" || { rm -f -- "$stage"; return 1; }
  run atomic_replace "$stage" "$f" "$install_owner" "$mode" root || { rm -f -- "$stage"; return 1; }
  node_op edit "$f" seal --path "$f" --id "${AR_ID/./:}" \
    --owner "${install_owner%%:*}" --count 1 --flag "$flag" || { rm -f -- "$stage"; return 1; }
  what="$(check_install "$f" "$stage" "${install_owner%%:*}" "$mode" "$flag" "$dflags")" || true
  rm -f -- "$stage"
  # The record follows the installed node either way, so verify reports
  # the mismatch itself rather than a replaced identity on top of it.
  write_meta "$META" \
    "owner=$owner" \
    "group=$group" \
    "mode=$mode" \
    "lockmode=$(meta_field "$META" lockmode)" \
    "tier=$tier" \
    "flag=$flag" \
    "flagsym=$(flags_of "$f")" \
    "id=$(node_id "$f")" \
    "recursive=0" \
    "role=$(meta_field "$META" role)" \
    "$(mismatch_kv "$META" "$f")" \
    "$(mismatch_line "$f" "$what")" \
    "state=locked" || return 1
  if [ -n "$what" ]; then
    report_mismatch "$f" "$what" "$f"
    return 1
  fi
  ok_row "edited and resealed" "$f"
  log_action edit "$f" ok
}

do_revert_one() {
  local f
  # leaf_path, so a symlink is one node everywhere (see do_lock_one). A
  # link has no snapshot of its own -- its content is the path it names --
  # so it falls into the "nothing to revert from" answer below, which is
  # the true one. Resolving instead would revert the file it points at,
  # which the caller did not name.
  f="$(leaf_path "$1")" || return 1
  snap_paths "$f"
  if [ ! -L "$f" ] && [ -d "$f" ]; then
    say_err "skipped, revert supports files only (unlock, restore by hand, lock)" "$f"
    return 1
  fi
  if [ ! -f "$SNAP" ]; then
    say_err "skipped, no snapshot to revert from" "$f"
    log_action revert "$f" skip-no-snap
    return 0
  fi
  # Read once, through the helper's owner gate, and pinned while the file
  # is sealed: the comparison and the attic both come from that copy. The
  # file's own parent is yours and unsealed, so its name is only as good as
  # its flag; a hard link planted there to a root-only file is still root's
  # and is refused, never compared or kept.
  local was_locked=0 tier="" flag="" mode=600 owner="" group=""
  if [ -f "$META" ]; then
    tier="$(meta_field "$META" tier)"
    flag="$(meta_field "$META" flag)"
    mode="$(meta_field "$META" mode)"
    owner="$(meta_field "$META" owner)"
    group="$(meta_field "$META" group)"
    [ "$(meta_field "$META" state)" = "locked" ] && was_locked=1
  fi
  local cur_owner="$inv" cid="-" cur
  if [ "$was_locked" -eq 1 ]; then
    [ "$tier" = "anchor" ] || cur_owner="$lock_user"
    cid="$(helper_id_for "$f")"
  fi
  cur="$(stage_copy "$f" "$cur_owner" "$cid")" || return 1
  # Guard against double-revert: if file already matches snapshot, the
  # current attic IS the legitimate discarded edit; preserve it.
  if cmp -s "$cur" "$SNAP"; then
    rm -f -- "$cur"
    say_err "skipped, file already matches snapshot (preserving existing .attic)" "$f"
    log_action revert "$f" skip-already-reverted
    return 0
  fi

  # Locked-state ownership depends on tier: content files belong to the
  # lock account, anchor files stay the user's (ssh owner checks).
  local restore_owner="${lock_user}:${lock_user}"
  [ "$tier" = "anchor" ] && restore_owner="${owner}:${group}"

  if [ "$was_locked" -eq 1 ]; then
    node_op revert "$f" unseal --path "$f" --id "$cid" --owner "$cur_owner" \
      --count 1 --flag "$flag" || { rm -f -- "$cur"; return 1; }
  fi
  run atomic_replace "$cur" "$ATTIC" "${lock_user}:${lock_user}" 600 root || { rm -f -- "$cur"; return 1; }
  rm -f -- "$cur"
  if [ "$was_locked" -eq 1 ]; then
    run atomic_replace "$SNAP" "$f" "$restore_owner" "$mode" "$lock_user" || return 1
    # The flag goes back on the inode just installed, by its identity.
    node_op revert "$f" seal --path "$f" --id "${AR_ID/./:}" \
      --owner "${restore_owner%%:*}" --count 1 --flag "$flag" || return 1
    if [ "$OPT_DRY" -eq 0 ]; then
      write_meta "$META" \
        "owner=$owner" \
        "group=$group" \
        "mode=$mode" \
        "lockmode=$(meta_field "$META" lockmode)" \
        "tier=$tier" \
        "flag=$flag" \
        "flagsym=$(flags_of "$f")" \
        "id=$(node_id "$f")" \
        "recursive=0" \
        "role=$(meta_field "$META" role)" \
        "state=locked" || return 1
    fi
  else
    run atomic_replace "$SNAP" "$f" "${owner:-$inv}:${group:-staff}" "$mode" "$lock_user" || return 1
  fi
  ok_row "reverted from snapshot" "$f"
  say_out "  discarded content saved to" "$ATTIC"
  log_action revert "$f" ok
}

# ---- mediated placement verbs ----------------------------------------------
#
# The three below are one syscall each, performed by the helper inside a
# window it holds by fd. They work whether or not the named path is a pool
# node: the motivating case is a plain file under a sealed parent, where
# there is no record at all and only the syscall is needed.

do_rm_one() {
  local f
  f="$(abs_leaf "$1")" || return 1
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    say_err "skipped, does not exist" "$f"
    log_action rm "$f" skip-noent
    return 1
  fi

  # The gate runs FIRST: when records live under a non-empty directory,
  # the refusal that matters is the one listing them, not the bare
  # "directory is not empty" -- otherwise the operator reaches for
  # --recursive having never seen the blast radius.
  subtree_gate rm "$f" || return 1

  # A directory with entries needs --recursive. The helper double-checks,
  # but refusing here means the window never opens at all.
  if [ -d "$f" ] && [ ! -L "$f" ] && [ "$OPT_RECURSIVE" -eq 0 ]; then
    if [ -n "$(ls -A -- "$f" 2>/dev/null)" ]; then
      say_err "skipped, directory is not empty" "$f"
      cmd_rows "  " \
        "sudo locked rm --recursive $(shq "$f")" "removes it and everything under it" >&2
      log_action rm "$f" skip-nonempty
      return 1
    fi
  fi

  # The kind of node is the question's noun and its row's label.
  local what="file"
  if [ -L "$f" ]; then
    what="symlink"
  elif [ -d "$f" ]; then
    what="directory"
  fi
  # Removing a protected file can leave chain directories nothing needs any
  # more. They are released under this same question, after the removal
  # has happened -- never ones inside the removed path, which go with it.
  local rm_leaves="" p i
  for p in ${SUBTREE_NODES[@]+"${SUBTREE_NODES[@]}"}; do
    snap_paths "$p"
    record_live "$META" || continue
    [ "$(meta_field "$META" role)" = "leaf" ] || continue
    rm_leaves="$rm_leaves$p"$'\n'
  done
  RELEASE_PATHS=()
  RELEASE_HOLDERS=()
  if [ -n "$rm_leaves" ]; then
    plan_releases "$rm_leaves" ""
    local -a keep_p keep_r
    keep_p=(); keep_r=()
    i=0
    while [ "$i" -lt "${#RELEASE_PATHS[@]}" ]; do
      case "${RELEASE_PATHS[$i]}" in
        "$f"|"$f"/*) ;;
        *) keep_p+=("${RELEASE_PATHS[$i]}"); keep_r+=("${RELEASE_HOLDERS[$i]}") ;;
      esac
      i=$((i + 1))
    done
    RELEASE_PATHS=(${keep_p[@]+"${keep_p[@]}"})
    RELEASE_HOLDERS=(${keep_r[@]+"${keep_r[@]}"})
  fi
  # The question holds no value and is one verb and its noun: the path
  # stands on the row above it, labeled with the kind of node the question
  # names, and what a yes also does is the consequence line.
  local c="This removes it permanently" nr="${#RELEASE_PATHS[@]}"
  if [ "$what" = "directory" ] && [ "$OPT_RECURSIVE" -eq 1 ]; then
    c="This removes it and everything under it permanently"
  fi
  if [ "$nr" -gt 0 ]; then
    echo "${E_B}removing it also releases:${E_OFF}" >&2
    release_rows "  " 7 "$(release_qwidth)"
    echo >&2
    c="$c, and releases $nr $(plural "$nr" directory directories)"
  fi
  asking && value_rows "" "$what" subject "$f" >&2
  confirm "remove this $what?" "$c." || {
    echo "${E_YEL}aborted; $what unchanged${E_OFF}" >&2; return 2
  }

  local parent args=()
  parent="$(dirname "$f")"
  args=(rm --parent "$parent" --parent-id "$(helper_id_for "$parent")" \
           --name "$(basename "$f")" --target-id "$(helper_id_for "$f")")
  if [ "$OPT_RECURSIVE" -eq 1 ]; then
    args+=(--recursive)
  fi

  window_begin "$parent"
  helper_call "${args[@]}"
  window_end
  helper_outcome rm "$f" || return 1

  local rc=0
  ok_row removed "$f"
  apply_subtree_effect rm "$f" || rc=1
  apply_releases || rc=1
  if [ "$HELPER_ANOMALY" -eq 1 ]; then
    rc=3
  else
    log_action rm "$f" ok
  fi
  return "$rc"
}

# Whether <user> would have write AND search on <dir> by ordinary UNIX
# permissions. The trash child runs as the invoker, so the rename out of
# the parent needs the invoker's own rights on it; clearing the parent's
# BSD flag does not grant any. Owner match wins, then group membership,
# then other -- the same order the kernel applies. Both bits must be on:
# write to unlink the entry, search to reach it (3 and 7 are the two octal
# digits carrying w|x). stat is lstat here, so a symlink is judged on the
# link's own mode and fails closed; callers hand over an already
# canonicalized parent, so that case does not arise in practice.
user_can_write_dir() { # <user> <dir>
  local u="$1" d="$2" owner group mode bits
  owner="$(stat -f '%Su' "$d")" || return 1
  group="$(stat -f '%Sg' "$d")" || return 1
  # Pad, then keep the last three digits: a setgid or sticky bit prepends
  # a fourth (2775, 1777) that would shift every index below.
  mode="$(printf '%03d' "$(stat -f '%OLp' "$d")")"
  mode="${mode#"${mode%???}"}"
  if [ "$owner" = "$u" ]; then
    bits="${mode:0:1}"
  elif id -Gn "$u" 2>/dev/null | tr ' ' '\n' | grep -qxF -- "$group"; then
    bits="${mode:1:1}"
  else
    bits="${mode:2:1}"
  fi
  case "$bits" in
    3|7) return 0 ;;
    *)   return 1 ;;
  esac
}

do_trash_one() {
  local f
  f="$(abs_leaf "$1")" || return 1
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    say_err "skipped, does not exist" "$f"
    log_action trash "$f" skip-noent
    return 1
  fi
  # The trash is a per-user destination. With no invoking user there is no
  # bin to put anything in, and root's own would be the wrong answer.
  if [ -z "$inv" ]; then
    echo "${E_RED}${E_B}✗ refusing trash:${E_OFF} no invoking user, so there is no bin to trash into" >&2
    echo "  use rm if the node really should be removed outright" >&2
    return 1
  fi
  local uid gid
  uid="$(id -u "$inv")"
  gid="$(id -g "$inv")"
  if [ "$uid" = "0" ]; then
    echo "${E_RED}${E_B}✗ refusing trash:${E_OFF} the invoker is root, whose bin is not where you" >&2
    echo "  meant this to go. Run it as yourself, or use rm." >&2
    return 1
  fi
  # No non-empty-directory rule here: the trash service moves a whole tree
  # in one operation, so --recursive governs records only.

  local parent
  parent="$(dirname "$f")"
  # Pre-check, before any window opens: a content-tier parent is
  # lock-account-owned 700, so the dropped-privilege child could not
  # perform the rename and the helper would fail from inside the window.
  # A placement-tier parent refuses here too: its ACL entry gives the
  # invoker add rights only, never delete_child, so the move out of it is
  # the invoker's to be denied. rm and mv run as root and are unaffected.
  # The mode bits are the whole answer this reads, which holds for
  # placement because the entry adds nothing that removes an entry.
  if ! user_can_write_dir "$inv" "$parent"; then
    say_err "${E_RED}${E_B}✗ refusing trash:${E_OFF} $inv cannot write the directory it is in" "$parent"
    echo "  The trash service runs as you, not as root, so the move out of" >&2
    echo "  that directory needs your own rights on it -- releasing the flag" >&2
    echo "  does not grant them." >&2
    cmd_rows "  " "sudo locked rm $(shq "$f")" "removes it outright instead" >&2
    log_action trash "$f" refuse-parent-perm
    return 1
  fi

  subtree_gate trash "$f" || return 1

  local args=()
  args=(trash --parent "$parent" --parent-id "$(helper_id_for "$parent")" \
              --name "$(basename "$f")" --target-id "$(helper_id_for "$f")" \
              --uid "$uid" --gid "$gid" --home "$user_home")

  window_begin "$parent"
  helper_call "${args[@]}"
  window_end
  helper_outcome trash "$f" || return 1

  local bin rc=0
  bin="$(helper_line_value binurl)"
  ok_row trashed "$f"
  if [ -n "$bin" ]; then
    say_out "  bin" "$bin"
  elif [ "$OPT_DRY" -eq 0 ]; then
    # Without the destination the suspension cannot be finalized later,
    # and Put Back would resurrect an unsealed node with nothing watching.
    echo >&2
    echo "${E_RED}${E_B}!!! the helper reported no bin location !!!${E_OFF}" >&2
    echo "    The record is suspended without one, so verify cannot finalize" >&2
    echo "    it. Find where it went and re-key or tombstone the record." >&2
    rc=3
  fi
  apply_subtree_effect trash "$f" "$bin" || rc=1
  if [ "$HELPER_ANOMALY" -eq 1 ]; then
    rc=3
  elif [ "$rc" -eq 0 ]; then
    log_action trash "$f" ok
  fi
  return "$rc"
}

do_mv() { # <old> <new>
  local old new
  old="$(abs_leaf "$1")" || return 1
  new="$(abs_leaf "$2")" || return 1
  if [ ! -e "$old" ] && [ ! -L "$old" ]; then
    say_err "skipped, does not exist" "$old"
    log_action mv "$old" skip-noent
    return 1
  fi
  if [ -e "$new" ] || [ -L "$new" ]; then
    say_err "${E_RED}${E_B}✗ refusing:${E_OFF} the new path already exists; locked mv never clobbers" "$new"
    log_action mv "$old" refuse-exists
    return 1
  fi
  local oldparent newparent
  oldparent="$(dirname "$old")"
  newparent="$(dirname "$new")"
  if [ ! -d "$newparent" ]; then
    say_err "${E_RED}${E_B}✗ refusing:${E_OFF} not a directory" "$newparent"
    return 1
  fi
  # Rename cannot cross filesystems, and a copy+delete would drop the BSD
  # flags and xattrs this tool exists to keep. Say so here rather than
  # letting an EXDEV from inside the window explain it later.
  if [ "$(stat -f '%d' "$oldparent")" != "$(stat -f '%d' "$newparent")" ]; then
    echo "${E_RED}${E_B}✗ refusing:${E_OFF} the two paths are on different filesystems" >&2
    value_rows "  " old id "$old" new id "$new" >&2
    echo "  a copy would drop flags and xattrs, so locked will not do it" >&2
    log_action mv "$old" refuse-xdev
    return 1
  fi

  subtree_gate mv "$old" || return 1

  local args=()
  args=(mv --parent "$oldparent" --parent-id "$(helper_id_for "$oldparent")" \
           --name "$(basename "$old")" --target-id "$(helper_id_for "$old")" \
           --dest-parent "$newparent" \
           --dest-parent-id "$(helper_id_for "$newparent")" \
           --dest-name "$(basename "$new")")

  window_begin "$oldparent" "$newparent"
  # mv is the one verb that lifts flags on the MOVED node too, and restores
  # them through the same fd afterwards. If that restore is what fails, the
  # node is at $new; if the rename never happened, it is still at $old.
  # Register both against the one flag word captured now: whichever path
  # does not exist afterwards is skipped, so exactly the right one is
  # checked without the backstop having to know which way it went.
  local target_flags
  target_flags="$(flags_of "$old")"
  window_add "$old" "$target_flags"
  window_add "$new" "$target_flags"
  helper_call "${args[@]}"
  window_end
  helper_outcome mv "$old" || return 1

  local rc=0
  ok_move moved "$old" "$new"
  # A rename keeps the inode, so no recorded field changes -- only the key.
  rekey_subtree "$old" "$new" || rc=1
  if [ "$HELPER_ANOMALY" -eq 1 ]; then
    rc=3
  elif [ "$rc" -eq 0 ]; then
    log_action mv "$old" ok
  fi

  # A protected file that moved needs the chain of its new place, and the
  # chain of its old place may be needed by nothing now. That is exactly a
  # lock plan for it at the new path, so each moved leaf gets one, with its
  # own question (--yes answers them). The move has happened either way: a
  # declined plan leaves the file sealed where it is, and says how to finish.
  if [ "$rc" -ne 1 ] && [ "$OPT_DRY" -eq 0 ]; then
    local i n moved lrc
    i=0
    while [ "$i" -lt "${#SUBTREE_NODES[@]}" ]; do
      n="${SUBTREE_NODES[$i]}"
      i=$((i + 1))
      moved="${new}${n#"$old"}"
      snap_paths "$moved"
      record_live "$META" || continue
      [ "$(meta_field "$META" role)" = "leaf" ] || continue
      echo
      lrc=0
      do_lock_one "$moved" || lrc=$?
      if [ "$lrc" -ne 0 ]; then
        say_err "${E_YEL}note:${E_OFF} sealed, but the chain at its new place is not settled" "$moved"
        cmd_rows "      " "sudo locked lock $(shq "$moved")" "seals the new chain and releases the old one" >&2
      fi
    done
  fi
  return "$rc"
}

# Record-only repair, for a node something else already moved. The identity
# check is the whole point: re-keying onto a node the record does not
# describe would hand a stranger's file a snapshot and a flag history.
do_rekey() { # <old> <new>
  local old new want cur
  old="$(abs_leaf "$1")" || return 1
  new="$(abs_leaf "$2")" || return 1
  snap_paths "$old"
  if [ ! -f "$META" ]; then
    say_err "skipped, not in pool (nothing to re-key)" "$old"
    return 1
  fi
  want="$(meta_field "$META" id)"
  if [ ! -e "$new" ] && [ ! -L "$new" ]; then
    say_err "${E_RED}${E_B}✗ refusing:${E_OFF} does not exist" "$new"
    cmd_rows "  " "sudo locked tombstone $(shq "$old")" "records it as gone instead" >&2
    return 1
  fi
  cur="$(node_id "$new")" || return 1
  local sn=0
  same_node "$want" "$cur" || sn=$?
  # sn 2 is a pre-0.6.0 record naming this very node; the next root status
  # rewrites its id field, and refusing the repair over a spelling would be
  # the reboot bug all over again.
  if [ "$sn" -eq 1 ]; then
    say_err "${E_RED}${E_B}✗ refusing:${E_OFF} the node here is not the one that record describes" "$new"
    value_rows "  " record id "$old" "recorded id" plain "$want" "id here" plain "$cur" >&2
    echo "  Re-keying would attach its snapshot and flag history to a different file." >&2
    cmd_rows "  " "sudo locked tombstone $(shq "$old")" "if the recorded node is really gone" >&2
    log_action rekey "$old" refuse-identity
    return 1
  fi

  subtree_gate rekey "$old" || return 1
  rekey_subtree "$old" "$new" || return 1
  log_action rekey "$old" ok
}

# Human assertion: a fact discovered after the event. Kept apart from the
# tool's own observation (via=rm) on purpose -- the audit trail has to say
# which of the two it was.
do_tombstone_one() {
  local f state
  f="$(abs_leaf "$1")" || return 1
  if [ -e "$f" ] || [ -L "$f" ]; then
    say_err "skipped, present on disk; use rm or trash, or unlock if you want it back" "$f"
    log_action tombstone "$f" skip-present
    return 1
  fi
  snap_paths "$f"
  if [ ! -f "$META" ]; then
    say_err "skipped, not in pool (nothing to tombstone)" "$f"
    log_action tombstone "$f" skip-no-meta
    return 1
  fi
  state="$(meta_field "$META" state)"
  if [ "$state" = "retired" ]; then
    local ef
    esc_into ef "$f" "$C_RV"
    echo "already retired (via $(meta_field "$META" via)): $ef"
    return 0
  fi
  # The question holds no value: the path, where it was trashed to and the
  # name the assertion is recorded under stand on the rows above it.
  local bin=""
  if [ "$state" = "suspended" ]; then
    bin="$(meta_field "$META" bin)"
    echo "${C_YEL}note:${C_OFF} this path is suspended (in the trash). Tombstoning asserts"
    echo "      it is gone for good, so verify stops watching for a Put Back."
  fi
  if ! asking; then
    :
  elif [ -n "$bin" ]; then
    value_rows "" path subject "$f" "trashed to" id "$bin" \
      "asserted by" plain "$inv" >&2
  else
    value_rows "" path subject "$f" "asserted by" plain "$inv" >&2
  fi
  confirm "record this path as gone?" "This retires its record." || {
    echo "${E_YEL}aborted; record unchanged${E_OFF}" >&2; return 2
  }
  retire_record "$f" assertion || return 1
  ok_row tombstoned "$f"
  log_action tombstone "$f" ok
}

# "What, if anything, stops this path from being modified?" -- a question
# independent of the pool, so it answers for foreign flags too, and runs
# without sudo on whatever the invoker can stat.
#
# One row per node, root-first (terminal-output Rows): the marker, then
# the node's owner and group, its flags and what the pool says of it, each
# a column padded to the widest of this walk, and the path last:
#
#   why: /Users/me/.zshrc
#       ~  root:wheel         sunlnk  no record       /
#       !  me:staff           sappnd  anchor locked   /Users/me
#       !  _me-lock:_me-lock  uchg    content locked  /Users/me/.zshrc
#
# The marker answers one question: does this node constrain what is under
# it? ! blocks removal and rename (yellow: attention), ~ carries some other
# flag, - carries none (dim: absence). The flags column is the fact the
# display answers, so it prints plain; owner and record are context, dim.
# An empty column on every row is left out.
do_why_one() {
  local f
  f="$(abs_leaf "$1")" || return 1

  local nodes=() n
  n="$f"
  while :; do
    nodes=("$n" ${nodes[@]+"${nodes[@]}"})
    [ "$n" = "/" ] && break
    n="$(dirname "$n")"
  done

  set_pal
  local -a marks=() owners=() flagss=() records=()
  local fl owner record i ow=0 fw=0 rw=0
  for n in "${nodes[@]}"; do
    if [ ! -e "$n" ] && [ ! -L "$n" ]; then
      marks+=("$P_DIM-$P_OFF") owners+=("") flagss+=("") records+=("does not exist")
      [ "$rw" -ge 14 ] || rw=14
      continue
    fi
    fl="$(flags_of "$n" 2>/dev/null)" || fl=""
    case ",$fl," in
      *,sappnd,*|*,schg,*|*,uappnd,*|*,uchg,*) marks+=("$P_YEL!$P_OFF") ;;
      ,,) marks+=("$P_DIM-$P_OFF") ;;
      *) marks+=("$P_YEL~$P_OFF") ;;
    esac
    owner="$(stat -f '%Su:%Sg' "$n" 2>/dev/null)" || owner="unreadable"
    record=""
    snap_paths "$n"
    if [ -f "$META" ]; then
      record="$(meta_field "$META" tier) $(meta_field "$META" state)"
    elif [ -n "$fl" ]; then
      record="no record"
    fi
    owners+=("$owner") flagss+=("$fl") records+=("$record")
    [ "${#owner}" -le "$ow" ] || ow="${#owner}"
    [ "${#fl}" -le "$fw" ] || fw="${#fl}"
    [ "${#record}" -le "$rw" ] || rw="${#record}"
  done

  local ef
  esc_into ef "$f" "$P_RV"
  echo "${P_B}why:${P_OFF} $ef"
  i=0
  for n in "${nodes[@]}"; do
    esc_into ef "$n" "$P_RV"
    {
      printf '    %s  ' "${marks[$i]}"
      [ "$ow" -eq 0 ] || printf '%s%-*s%s  ' "$P_DIM" "$ow" "${owners[$i]}" "$P_OFF"
      [ "$fw" -eq 0 ] || printf '%-*s  ' "$fw" "${flagss[$i]}"
      [ "$rw" -eq 0 ] || printf '%s%-*s%s  ' "$P_DIM" "$rw" "${records[$i]}" "$P_OFF"
      printf '%s\n' "$ef"
    }
    i=$((i + 1))
  done

  # Two constraints, reported separately because their remedies differ: an
  # immutable node cannot be changed at all, and a sealed parent will not
  # let the entry be removed or renamed. The path ends the note's last line.
  local blocked=0 self_fl self_block=""
  self_fl="$(flags_of "$f" 2>/dev/null)" || self_fl=""
  case ",$self_fl," in
    *,schg,*) self_block=schg ;;
    *,uchg,*) self_block=uchg ;;
  esac
  if [ -n "$self_block" ]; then
    blocked=1
    echo
    esc_into ef "$f" "$P_RV"
    snap_paths "$f"
    if [ -f "$META" ] && [ "$(meta_field "$META" state)" = "locked" ]; then
      echo "${P_YEL}note:${P_OFF} this path is immutable ($self_block), so its contents cannot"
      echo "      change while it is sealed: $ef"
      cmd_rows "      " \
        "sudo locked edit $(shq "$f")" "edits it without ever leaving it unlocked" \
        "sudo locked unlock $(shq "$f")" "releases it until the next lock"
    else
      echo "${P_YEL}note:${P_OFF} this path is immutable ($self_block), and locked has no record of"
      echo "      that flag; it was set outside the pool: $ef"
      cmd_rows "      " \
        "sudo chflags no$self_block $(shq "$f")" "releases it (re-apply it yourself after)"
    fi
  fi
  if blocking_ancestor "$f"; then
    blocked=1
    echo
    if { [ -e "$f" ] || [ -L "$f" ]; } && user_can_write_dir "$inv" "$(dirname "$f")"; then
      explain_blocker "$BLOCK_PATH" "$BLOCK_FLAG" \
        "sudo locked rm $(shq "$f")" "removes it through a bounded window" \
        "sudo locked trash $(shq "$f")" "moves it to your trash instead" \
        "sudo locked mv $(shq "$f") NEW" "renames it through the same window"
    elif [ -e "$f" ] || [ -L "$f" ]; then
      # The trash service moves the entry as you, and this parent does not
      # let you remove what is in it (a placement seal's entry adds only),
      # so do_trash_one would refuse the command. rm and mv run as root.
      explain_blocker "$BLOCK_PATH" "$BLOCK_FLAG" \
        "sudo locked rm $(shq "$f")" "removes it through a bounded window" \
        "sudo locked mv $(shq "$f") NEW" "renames it through the same window"
    else
      # There is nothing there to remove or rename, so offering the verbs
      # that do those would only produce commands that refuse.
      explain_blocker "$BLOCK_PATH" "$BLOCK_FLAG"
    fi
  fi
  if [ "$blocked" -eq 0 ]; then
    echo
    # Precisely what was measured, and no more: this walk reads file flags,
    # so ordinary permissions are still free to say no.
    echo "${P_YEL}note:${P_OFF} no file flag on this chain stops this path from being"
    echo "      changed, renamed or removed. Ordinary permissions still"
    echo "      apply -- the owners are listed above."
  fi
}

# One node, one row, in the layout every listing in this script shares
# (terminal-output Rows): four spaces, a verdict glyph and its word, the
# tier and the recorded flag -- each a column of fixed words, padded to
# the widest word of its set, blank where the row has none -- and the path
# last. What a row says beyond its words goes on a dim line under it,
# starting in the path's column:
#
#   ✓  sealed       content    uchg    /Users/me/.zshrc
#   !  unlocked     content            /Users/me/.config/zsh
#   ~  retired      content            /Users/me/old
#                                      via rm at 2026-10-01T12:00:00Z
#   -  not in pool                     /Users/me
#
# Markers (terminal-output verdict set): ✓ green sealed and clean, ✗ red
# drifted, ! yellow deliberately unlocked (protection is OFF -- the row to
# notice), ~ yellow recorded but no longer enforced (retired, suspended),
# - dim not in pool, or a leaf parent the chain does not need. `brief`
# collapses drift detail to a pointer, for the pool listing. Sets
# STATUS_ROW_POOL so a caller can tell "clean" from "no record". Returns 1
# on drift. Clobbers the snap_paths globals.
readonly STATUS_WORD_W=11 STATUS_TIER_W=9 STATUS_FLAG_W=6
readonly STATUS_COL=$(( 4 + 1 + 2 + STATUS_WORD_W + 2 + STATUS_TIER_W + 2 + STATUS_FLAG_W + 2 ))

# status_line <style> <glyph> <word> <tier> <flag> <path>: one row on
# stdout, P_* palette (callers run set_pal). The glyph and its word wear
# <style>; tier and flag are dim context; the path is plain and last.
status_line() {
  local ep
  esc_into ep "$6" "$P_RV"
  printf '    %s%s  %-*s%s  %s%-*s  %-*s%s  %s\n' "$1" "$2" "$STATUS_WORD_W" "$3" "$P_OFF" \
    "$P_DIM" "$STATUS_TIER_W" "$4" "$STATUS_FLAG_W" "$5" "$P_OFF" "$ep"
}

# status_note <text> [<value>]: a dim line under a row, in the path's
# column; a value (a path) follows the text after a colon, escaped, last.
status_note() {
  local ev=""
  if [ "$#" -ge 2 ]; then
    esc_into ev "$2" "$P_RV" "$P_DIM"
    ev=": $ev"
  fi
  printf '%*s%s%s%s%s\n' "$STATUS_COL" '' "$P_DIM" "$1" "$ev" "$P_OFF"
}

STATUS_ROW_POOL=0
status_row() { # <path> [brief]
  local n="$1" brief="${2:-}" tier state flag
  STATUS_ROW_POOL=0
  set_pal
  snap_paths "$n"
  if [ ! -f "$META" ]; then
    status_line "$P_DIM" - "not in pool" "" "" "$n"
    return 0
  fi
  STATUS_ROW_POOL=1
  tier="$(meta_field "$META" tier)"
  state="$(meta_field "$META" state)"
  flag="$(meta_field "$META" flag)"
  case "$state" in
    unlocked)
      status_line "$P_YEL" '!' unlocked "$tier" "" "$n"
      return 0
      ;;
    retired)
      status_line "$P_YEL" '~' retired "$tier" "" "$n"
      status_note "via $(meta_field "$META" via) at $(meta_field "$META" at)"
      return 0
      ;;
    suspended)
      status_line "$P_YEL" '~' suspended "$tier" "" "$n"
      status_note "since $(meta_field "$META" at)"
      status_note bin "$(meta_field "$META" bin)"
      return 0
      ;;
  esac
  # Clean, but not always silent: verify_node reports a record it repaired
  # (an identity upgraded, a suspension finalized) on its way to saying
  # nothing is wrong. Discarding that output would hide the one thing the
  # row cannot show -- and, unprivileged, the note asking for the sudo run
  # that does the repair.
  local vout pad
  printf -v pad '%*s' "$STATUS_COL" ''
  if vout="$(verify_node "$n" "$META" "$lock_user" 2>/dev/null)"; then
    status_line "$P_GRN" '✓' sealed "$tier" "$flag" "$n"
    if [ -n "$vout" ]; then
      printf '%s\n' "$vout" | verify_rows "$pad"
    fi
    return 0
  fi
  status_line "$P_RED" '✗' drifted "$tier" "$flag" "$n"
  if [ "$brief" = "brief" ]; then
    local en
    esc_into en "$(shq "$n")" "$P_RV" "$P_DIM"
    status_note "details: sudo locked status $en"
  else
    verify_node "$n" "$META" "$lock_user" | verify_rows "$pad" || true
  fi
  return 1
}

# The `chain for` block: ancestors root-first, then the leaf's parent, then
# the leaf, one status_row each. Sets CHAIN_ANY=1 when any node on it holds
# a record. Returns 1 if any node drifted.
CHAIN_ANY=0
print_chain() { # <path> [brief]
  local f="$1" brief="${2:-}" chain nodes=() a rc=0 parent ef
  CHAIN_ANY=0
  set_pal
  esc_into ef "$f" "$P_RV"
  echo "${P_B}chain for:${P_OFF} $ef"
  if chain="$(chain_for "$f" 2>/dev/null)"; then
    :
  else
    esc_into ef "$(shq "$f")" "$P_RV" "$P_CYN"
    echo "  ${P_RED}✗${P_OFF} the chain stop node is not root-owned; see: ${P_CYN}sudo locked lock $ef${P_OFF}"
    if chain_skips_parent "$f"; then
      chain="$(dirname "$(dirname "$f")")"
    else
      chain="$(dirname "$f")"
    fi
  fi
  # Root-first for readability.
  while IFS= read -r a; do
    [ -n "$a" ] && nodes=("$a" ${nodes[@]+"${nodes[@]}"})
  done <<EOF
$chain
EOF
  if [ "${#nodes[@]}" -gt 0 ]; then
    for a in "${nodes[@]}"; do
      status_row "$a" "$brief" || rc=1
      if [ "$STATUS_ROW_POOL" -eq 1 ]; then
        CHAIN_ANY=1
      fi
    done
  fi
  # A leaf parent left out of the chain (the rule is argued at
  # chain_skips_parent) is still the node a reader looks for first, so it
  # prints as context: dim, with the reason on the line under it, and never
  # a "!" -- there is nothing on it to be out of order. A parent that holds
  # a LIVE record is a pool node like any other -- another leaf's chain
  # runs through it, or nothing needs it and the next plan releases it --
  # so it gets the ordinary row, drift and all. A retired record is history
  # and reads as none. An anchor parent is in the chain above and has
  # already printed.
  parent="$(dirname "$f")"
  if [ "$parent" != "$f" ] && chain_skips_parent "$f"; then
    snap_paths "$parent"
    if record_live "$META"; then
      status_row "$parent" "$brief" || rc=1
      if [ "$STATUS_ROW_POOL" -eq 1 ]; then
        CHAIN_ANY=1
      fi
    else
      status_line "$P_DIM" - "not needed" "" "" "$parent"
      status_note "its parent keeps it in place" "$(dirname "$parent")"
    fi
  fi
  status_row "$f" "$brief" || rc=1
  if [ "$STATUS_ROW_POOL" -eq 1 ]; then
    CHAIN_ANY=1
  fi
  return "$rc"
}

do_status_one() {
  local f="$1" resolved
  # leaf_path, so a symlink is one node everywhere: lock records the link
  # itself, and resolving here would report the target's chain and call
  # the link "not in pool".
  #
  # It fails on a path that no longer exists -- which is exactly the
  # expected condition of a retired or suspended record. Fall back to the
  # path as typed (absolute only) so those records stay reachable by name;
  # records are keyed by the canonical path captured at lock time, so the
  # typed absolute path is the same key in the ordinary case. Its own
  # diagnostics are dropped with them: this is a reporting verb, and the
  # fallback below is the answer, not an error.
  if resolved="$(leaf_path "$f" 2>/dev/null)"; then
    f="$resolved"
  else
    case "$f" in
      /*) ;;
      *) say_err "cannot resolve" "$1"; return 1 ;;
    esac
  fi
  snap_paths "$f"
  local leaf_meta="$META" rc=0
  print_chain "$f" || rc=1
  [ "$CHAIN_ANY" -eq 1 ] || say_out "  not in pool; no record at" "$leaf_meta"
  return "$rc"
}

# Without root, verify_node's recursive stray-scan silently sees nothing
# inside a tree whose captured modes deny the caller read, so a drifted
# recursive dir can render clean. Say so once rather than letting the
# checkmark overclaim; root output stays untouched.
status_unpriv_note() {
  [ "$EUID" -eq 0 ] && return 0
  echo "${E_YEL}note:${E_OFF} without sudo, recursive trees get leaf checks only; sudo locked status is authoritative" >&2
}

# status with no path: list every node in the invoking user's pool, so the
# whole locked surface is visible at a glance, then what the last verify
# run found. Reporting only -- unlike verify it never writes the status
# file and drift does not change the exit code, so looking never turns
# into an enforcement action.
do_status_pool() {
  local listing meta n
  # Sorted by DECODED path, so the listing reads in filesystem order rather
  # than in the encoding's order (%2F sorts nothing like /).
  listing="$(
    for meta in "$USER_POOL"/*.meta; do
      printf '%s\n' "$(decode "$(basename "$meta" .meta)")"
    done | sort
  )"
  set_pal
  if [ -z "$listing" ]; then
    echo "pool for $inv is empty"
    echo
    verify_summary "$USER_DIR"
    return 0
  fi
  echo "${P_B}pool for $inv:${P_OFF}"
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    # Looking is never an enforcement action: drift shows in the row but
    # does not change the exit code here.
    status_row "$n" brief || true
  done <<EOF
$listing
EOF
  # Chain directories nothing needs any more -- a protected file went to
  # the trash and never came back, or a record was tombstoned. Only a
  # gated verb releases, so the listing says which one and stops there.
  plan_releases "" "" 2>/dev/null
  if [ "${#RELEASE_PATHS[@]}" -gt 0 ]; then
    echo
    echo "${P_YEL}note:${P_OFF} no protected file needs these any more:"
    local i=$((${#RELEASE_PATHS[@]} - 1))
    while [ "$i" -ge 0 ]; do
      path_lines "      " "${RELEASE_PATHS[$i]}"
      i=$((i - 1))
    done
    echo "      The next sudo locked lock, unprotect or rm releases them."
  fi
  echo
  verify_summary "$USER_DIR"
  return 0
}

# ---- verify status -----------------------------------------------------------
#
# Each verify run leaves one file per user, <state root>/<user>/verify, for
# anything that wants the result without root: status below, a statusline,
# a login check. locked names no consumer; a reader knows this path.
#
#   at=2026-09-15T20:15:00Z    when the run started (UTC)
#   interval=900               seconds between timer runs; older than a few
#                              intervals means the timer has stopped
#   records=26                 pool records the run walked
#   drifted=2                  of those, how many drifted
#   drift=/Users/you/...       one line per drifted path, at most
#                              VERIFY_PATHS_MAX; drifted= is the count
#
# One file, replaced whole by a rename, so a reader always gets a single
# run's answer and never half of one. Only root writes it: the file and the
# dir it sits in are root's, and the lock group -- the user -- can read
# both and change neither. Paths come from the user's own file names, so
# every byte outside printable ASCII, and the backslash itself, is written
# as \xHH: each line is printable ASCII, and no file name can end a line
# early and add a key of its own.
VERIFY_PATHS_MAX=20

verify_escape() { # <path>: printable ASCII, \xHH for every other byte
  # Bytes, not characters: without -C perl reads its argument as octets, so
  # a multi-byte character becomes one \xHH per byte (env -i: no
  # PERL_UNICODE or PERL5OPT can add a -C).
  env -i /usr/bin/perl -e '$_ = $ARGV[0]; s/([^\x20-\x5b\x5d-\x7e])/sprintf("\\x%02x", ord($1))/ge; print' -- "$1"
}

write_verify_status() { # <userdir> <lock group> <at> <records> [drifted path...]
  local dir="$1" group="$2" at="$3" records="$4"
  shift 4
  local tmp p n=0
  tmp="$(mktemp "$dir/.verify.XXXXXX")" || return 1
  {
    printf 'at=%s\n' "$at"
    printf 'interval=%s\n' "$LOCKED_VERIFY_INTERVAL"
    printf 'records=%s\n' "$records"
    printf 'drifted=%s\n' "$#"
    for p in "$@"; do
      n=$((n + 1))
      [ "$n" -le "$VERIFY_PATHS_MAX" ] || break
      printf 'drift=%s\n' "$(verify_escape "$p")"
    done
  } >"$tmp" || { rm -f -- "$tmp"; return 1; }
  chown "root:$group" "$tmp" || { rm -f -- "$tmp"; return 1; }
  chmod 640 "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$dir/verify" || { rm -f -- "$tmp"; return 1; }
}

fmt_age() { # <seconds>: how long ago, in the largest whole unit
  local s="$1"
  if [ "$s" -lt 60 ]; then echo "just now"
  elif [ "$s" -lt 3600 ]; then echo "$((s / 60)) min ago"
  elif [ "$s" -lt 172800 ]; then echo "$((s / 3600)) h ago"
  else echo "$((s / 86400)) days ago"
  fi
}

# One block for status: what the last verify run found, from the file above.
# A run older than three intervals is stale -- the timer has stopped or the
# machine has not been awake to run it -- and says so, because a clean
# answer from yesterday is not a clean answer now. The status file is a
# path, so it ends whichever line names it; the drifted paths come back as
# the bytes verify_escape wrote and are shown as any other path is.
verify_summary() { # <userdir>
  local f="$1/verify" line at="" interval="" drifted="" epoch now age when ef
  local paths=()
  set_pal
  esc_into ef "$f" "$P_RV"
  if [ ! -e "$f" ]; then
    echo "${P_B}last verify:${P_OFF} ${P_DIM}-${P_OFF}  none recorded"
    echo "      ${P_DIM}the timer writes it at: $ef${P_OFF}"
    return 0
  fi
  if [ -L "$f" ] || [ ! -f "$f" ] || [ ! -r "$f" ]; then
    echo "${P_B}last verify:${P_OFF} ${P_RED}✗${P_OFF}  cannot read: $ef"
    return 0
  fi
  while IFS= read -r line; do
    case "$line" in
      at=*)       at="${line#at=}" ;;
      interval=*) interval="${line#interval=}" ;;
      drifted=*)  drifted="${line#drifted=}" ;;
      drift=*)    paths+=("${line#drift=}") ;;
    esac
  done <"$f"
  case "$interval" in ''|*[!0-9]*) interval="" ;; esac
  case "$drifted" in ''|*[!0-9]*) drifted="" ;; esac
  if [ -z "$interval" ] || [ -z "$drifted" ]; then
    echo "${P_B}last verify:${P_OFF} ${P_RED}✗${P_OFF}  malformed: $ef"
    return 0
  fi
  epoch="$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$at" +%s 2>/dev/null)" || {
    echo "${P_B}last verify:${P_OFF} ${P_RED}✗${P_OFF}  malformed: $ef"
    return 0
  }
  now="$(date +%s)"
  age=$((now - epoch))
  [ "$age" -ge 0 ] || age=0
  if [ "$age" -lt 72000 ]; then
    when="$(date -r "$epoch" +%H:%M)"
  else
    when="$(date -r "$epoch" '+%Y-%m-%d %H:%M')"
  fi
  if [ "$drifted" -eq 0 ]; then
    echo "${P_B}last verify:${P_OFF} ${P_GRN}✓${P_OFF}  clean ${P_DIM}($when, $(fmt_age "$age"))${P_OFF}"
  else
    echo "${P_B}last verify:${P_OFF} ${P_RED}✗${P_OFF}  $drifted drifted ${P_DIM}($when, $(fmt_age "$age"))${P_OFF}"
    for line in ${paths[@]+"${paths[@]}"}; do
      path_lines "      " "$(verify_unescape "$line")"
    done
    [ "$drifted" -le "${#paths[@]}" ] || echo "      and $((drifted - ${#paths[@]})) more"
    echo "      details: ${P_CYN}sudo locked verify${P_OFF}"
  fi
  if [ "$age" -gt $((3 * interval)) ]; then
    echo "${P_YEL}note:${P_OFF} that run is stale; the timer runs every ${interval}s"
  fi
  return 0
}

do_verify() {
  local total_drift=0 status_failed=0 udir uname ulock records at
  local meta fpath out
  local drifted=()
  # One start time for every user's status: the moment the answer is as of.
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  for udir in "$LOCKED_STATE_ROOT"/*/; do
    udir="${udir%/}"
    uname="$(basename "$udir")"
    case "$uname" in .*) continue ;; esac
    ulock="${LOCKED_LOCK_ACCOUNT:-$(lock_account_for "$uname")}"
    records=0
    drifted=()
    for meta in "$udir"/pool/*.meta; do
      records=$((records + 1))
      fpath="$(decode "$(basename "$meta" .meta)")"
      if out="$(verify_node "$fpath" "$meta" "$ulock")"; then
        [ "$OPT_QUIET" -eq 1 ] || [ -z "$out" ] || printf '%s\n' "$out" | verify_rows "  " "$fpath"
      else
        printf '%s\n' "$out" | verify_rows "  " "$fpath"
        drifted+=("$fpath")
      fi
    done
    if ! write_verify_status "$udir" "$ulock" "$at" "$records" ${drifted[@]+"${drifted[@]}"}; then
      err_val "could not write the verify status" "$udir/verify"
      status_failed=1
    fi
    total_drift=$((total_drift + ${#drifted[@]}))
  done
  if [ "$total_drift" -gt 0 ]; then
    echo "${E_RED}${E_B}✗ verify: $total_drift node(s) drifted${E_OFF}" >&2
    log_action verify "" "drift-$total_drift"
    return 5
  fi
  if [ "$status_failed" -eq 1 ]; then
    log_action verify "" status-write-failed
    return 1
  fi
  [ "$OPT_QUIET" -eq 1 ] || echo "${C_GRN}verify: all locked nodes clean${C_OFF}"
  log_action verify "" ok
  return 0
}

# ---- dispatch --------------------------------------------------------------

require_paths() {
  if [ "${#PATHS[@]}" -eq 0 ]; then
    echo "no paths given" >&2
    usage >&2
    exit 1
  fi
}

case "$action" in
  lock|unprotect|unlock|revert|status|edit|rm|trash|tombstone|why)
    if [ "$action" = "edit" ] && [ "$OPT_DRY" -eq 1 ]; then
      echo "edit does not support --dry-run (the diff+confirm IS the preview)" >&2
      exit 1
    fi
    # status is the one action that means something without paths: list the
    # pool. Every other action -- and status WITH paths -- still requires them.
    if [ "$action" = "status" ] && [ "${#PATHS[@]}" -eq 0 ]; then
      do_status_pool
      status_unpriv_note
      exit 0
    fi
    require_paths
    total="${#PATHS[@]}"
    idx=0
    failures=0
    declined=0
    for f in "${PATHS[@]}"; do
      idx=$((idx + 1))
      # Batch orientation (terminal-output): a [n/N] counter per item, and
      # the composer -- this loop -- owns the one blank line between items.
      # The reporting verbs keep their own per-item headers uncounted.
      if [ "$total" -gt 1 ]; then
        [ "$idx" -gt 1 ] && echo
        case "$action" in
          status|why) ;;
          *)
            esc_into ef "$f" "$C_RV"
            printf '%s[%d/%d]%s %s\n' "$C_DIM" "$idx" "$total" "$C_OFF" "$ef"
            ;;
        esac
      fi
      rc=0
      case "$action" in
        lock)      do_lock_one "$f"      || rc=$? ;;
        unprotect) do_unprotect_one "$f" || rc=$? ;;
        unlock)    do_unlock_one "$f"    || rc=$? ;;
        revert)    do_revert_one "$f"    || rc=$? ;;
        edit)      do_edit_one "$f"      || rc=$? ;;
        status)    do_status_one "$f"    || rc=$? ;;
        why)       do_why_one "$f"       || rc=$? ;;
        rm)        do_rm_one "$f"        || rc=$? ;;
        trash)     do_trash_one "$f"     || rc=$? ;;
        tombstone) do_tombstone_one "$f" || rc=$? ;;
      esac
      if [ "$action" = "status" ] || [ "$action" = "why" ]; then
        [ "$rc" -ne 0 ] && failures=$((failures + 1))
        continue
      fi
      if [ "$rc" -eq 2 ]; then
        # A decline affects only its own item (terminal-output): the rest
        # of a batch still gets its decisions. A single-path invocation
        # keeps the plain abort exit.
        [ "$total" -eq 1 ] && exit 2
        declined=$((declined + 1))
      elif [ "$rc" -ne 0 ]; then
        failures=$((failures + 1))
        # rc 3 from a placement verb means the operation DID happen and the
        # records followed it, but the parent's entry diff had leftovers.
        # It still counts as a failure, so the overall exit is 3 -- it just
        # does not get the "error processing" line, which would be false.
        case "$action" in
          rm|trash) [ "$rc" -eq 3 ] || say_err "error processing (continuing)" "$f" ;;
          *)        say_err "error processing (continuing)" "$f" ;;
        esac
      fi
    done
    [ "$action" = "status" ] && status_unpriv_note
    # One summary tail per batch: what happened, what was declined, what
    # failed. Declines are a normal outcome, not an error.
    if [ "$total" -gt 1 ] && [ "$action" != "status" ] && [ "$action" != "why" ]; then
      case "$action" in
        # A lock item can end with only releases, or with nothing to do,
        # so "locked" would overclaim; each item's own lines say what.
        lock)      batch_noun=done ;;
        unprotect) batch_noun=unprotected ;;
        unlock)    batch_noun=unlocked ;;
        revert)    batch_noun=reverted ;;
        edit)      batch_noun=edited ;;
        rm)        batch_noun=removed ;;
        trash)     batch_noun=trashed ;;
        tombstone) batch_noun=tombstoned ;;
      esac
      echo
      echo "$((total - declined - failures)) $batch_noun, $declined declined, $failures failed"
    fi
    if [ "$failures" -gt 0 ]; then
      [ "$action" = "status" ] && exit 5
      exit 3
    fi
    if [ "$declined" -gt 0 ]; then
      exit 2
    fi
    ;;
  mv|rekey)
    # Two paths, positionally, and no batching: a move has an <old> and a
    # <new>, and a loop over pairs would make a typo unreadable.
    if [ "${#PATHS[@]}" -ne 2 ]; then
      echo "$action needs exactly two paths: <old> <new>" >&2
      usage >&2
      exit 1
    fi
    if [ "$action" = "mv" ]; then
      do_mv "${PATHS[0]}" "${PATHS[1]}" || { rc=$?; [ "$rc" -eq 2 ] && exit 2; exit 3; }
    else
      do_rekey "${PATHS[0]}" "${PATHS[1]}" || exit 3
    fi
    ;;
  verify)
    do_verify
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
