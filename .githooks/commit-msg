#!/bin/sh
# GENERATED by claude-init -- edits are overwritten on re-init.
#
# commit-msg -- two checks, both loud.
#   1. the SUBJECT (line 1) must be plain ASCII. The body is left alone
#      (em/en-dash are fine there). Override: git commit --no-verify.
#   2. no GitHub REFERENCE anywhere in the message: #123, owner/repo#123, GH-123,
#      an issue/pull/discussion URL, or an @mention. Once pushed, GitHub writes a
#      permanent "referenced this issue" entry on the far thread (or notifies the
#      mentioned user) that links to this commit as it is; nothing done afterwards
#      -- not a follow-up commit, not a force push -- removes it. Override, when
#      the reference is the point: COMMIT_ALLOW_GITHUB_REFS=1 git commit ...
#      (keeps check 1; --no-verify would drop both).
# Portable POSIX sh/awk/grep -- same behaviour on macOS and in the Linux lanes.
set -eu
subject="$(awk 'NF && $0 !~ /^[[:space:]]*#/ { print; exit }' "$1")"
if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
  {
    echo "commit-msg: subject line contains a non-ASCII character."
    echo "  subject: $subject"
    echo "  Commit subjects must be plain ASCII (portable across git log, email, tooling)."
    echo "  Message kept in .git/COMMIT_EDITMSG -- fix the subject and commit again,"
    echo "  or override deliberately with: git commit --no-verify"
  } >&2
  exit 1
fi
# Everything above the scissors line is message (comment lines included: under
# -m/-F git keeps a line that starts with '#', so '#123' at line start is live).
refs="$(awk '/^# -+ >8 -+$/ { exit } { print }' "$1" | LC_ALL=C grep -nE \
  -e '(^|[^A-Za-z0-9_])#[0-9]+' \
  -e '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' \
  -e '(^|[^A-Za-z0-9_])GH-[0-9]+' \
  -e 'github\.com/[^/[:space:]]+/[^/[:space:]]+/(issues|pull|discussions)/[0-9]+' \
  -e '(^|[[:space:]("'"'"'<])@[A-Za-z0-9][A-Za-z0-9-]*' \
  || true)"
if [ -n "$refs" ] && [ "${COMMIT_ALLOW_GITHUB_REFS:-}" = 1 ]; then
  echo "commit-msg: GitHub reference allowed (COMMIT_ALLOW_GITHUB_REFS=1):" >&2
  printf '%s\n' "$refs" | sed 's/^\([0-9]*\):/  line \1: /' >&2
elif [ -n "$refs" ]; then
  {
    echo "commit-msg: the message references a GitHub thread or user."
    printf '%s\n' "$refs" | sed 's/^\([0-9]*\):/  line \1: /'
    echo "  Pushed to GitHub, this leaves a permanent entry on that thread (or a"
    echo "  notification to that user) linking to this commit exactly as it is."
    echo "  No later commit or force push removes it."
    echo "  Message kept in .git/COMMIT_EDITMSG -- reword (spell the number out,"
    echo "  drop the @, or describe instead of linking) and commit again."
    echo "  If the reference IS the point: COMMIT_ALLOW_GITHUB_REFS=1 git commit ..."
  } >&2
  exit 1
fi
