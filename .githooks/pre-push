#!/bin/sh
# GENERATED by claude-init -- edits are overwritten on re-init.
#
# pre-push -- refuse a push that carries a GitHub REFERENCE in any commit or
#   annotated tag message it sends: #123, owner/repo#123, GH-123, an
#   issue/pull/discussion URL, or an @mention. The commit-msg hook stops these as
#   they are written; this hook stops the ones that arrive another way (a
#   rewritten history, a cherry-pick, an old branch). Pushed to GitHub, each
#   referencing commit writes its own permanent entry on the far thread, so a
#   rewrite that keeps the message adds a second one.
#   Scanned: commits reachable from each pushed ref that the remote does not
#   have -- not its old tip, not any remote-tracking ref of this remote -- and
#   the message of each annotated tag pushed. A stale remote-tracking ref that
#   still names commits the remote lost lets those pass unscanned.
#   Override, when the reference is the point:
#     COMMIT_ALLOW_GITHUB_REFS=1 git push ...
# Portable POSIX sh/awk/grep -- same behaviour on macOS and in the Linux lanes.
set -eu

remote="$1"
zero="0000000000000000000000000000000000000000"
report=""

# scan <label> <message> -- appends "  <label>" plus its hits to report. Takes
# the message as an argument: a function at the end of a pipeline runs in a
# subshell, and its report would be lost.
scan() {
  hits="$(printf '%s\n' "$2" | LC_ALL=C grep -nE \
  -e '(^|[^A-Za-z0-9_])#[0-9]+' \
  -e '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' \
  -e '(^|[^A-Za-z0-9_])GH-[0-9]+' \
  -e 'github\.com/[^/[:space:]]+/[^/[:space:]]+/(issues|pull|discussions)/[0-9]+' \
  -e '(^|[[:space:]("'"'"'<])@[A-Za-z0-9][A-Za-z0-9-]*' \
  || true)"
  [ -n "$hits" ] || return 0
  report="${report}  $1
$(printf '%s\n' "$hits" | sed 's/^\([0-9]*\):/    line \1: /')
"
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue          # a deletion sends no messages
  [ "$local_oid" = "$remote_oid" ] && continue    # nothing new on this ref
  if [ "$(git cat-file -t "$local_oid")" = tag ]; then
    scan "tag ${local_ref#refs/tags/}" "$(git cat-file tag "$local_oid" \
      | sed -e '1,/^$/d' -e '/^-----BEGIN [A-Z ]*SIGNATURE-----$/,$d')"
  fi
  set -- "$local_oid" --not --remotes="$remote"
  if [ "$remote_oid" != "$zero" ] && git cat-file -e "$remote_oid" 2>/dev/null; then
    set -- "$@" "$remote_oid"
  fi
  for c in $(git rev-list "$@"); do
    scan "$(git log -1 --format='%h %s' "$c")" \
      "$(git cat-file commit "$c" | sed '1,/^$/d')"
  done
done

[ -n "$report" ] || exit 0
if [ "${COMMIT_ALLOW_GITHUB_REFS:-}" = 1 ]; then
  echo "pre-push: GitHub reference allowed (COMMIT_ALLOW_GITHUB_REFS=1):" >&2
  printf '%s' "$report" >&2
  exit 0
fi
{
  echo "pre-push: the push carries a message that references a GitHub thread or user."
  printf '%s' "$report"
  echo "  Pushed to GitHub, each of these leaves a permanent entry on that thread (or"
  echo "  a notification to that user) linking to the commit exactly as it is."
  echo "  Nothing was pushed. Reword the message (spell the number out, drop the @,"
  echo "  or describe instead of linking) and push again."
  echo "  If the reference IS the point: COMMIT_ALLOW_GITHUB_REFS=1 git push ..."
} >&2
exit 1
