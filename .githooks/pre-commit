#!/bin/sh
# GENERATED by claude-init -- edits are overwritten on re-init.
#
# pre-commit -- scan the STAGED changes for secrets with gitleaks.
#   Refusing here is free: no commit object exists yet and the staged content is
#   left exactly as it was. Once a secret is committed and pushed it is in every
#   clone, and no later commit or force push takes it back.
#   Fail closed: if neither gitleaks nor nix can be found the commit is REFUSED
#   rather than skipped -- an unscanned commit that looks scanned is the failure
#   this hook exists to prevent.
#   Allowlisting: gitleaks reads .gitleaks.toml from the repo root by itself, so
#   a fixture that must carry a secret-shaped string is whitelisted there.
#   Override, when the finding really belongs in the commit:
#     COMMIT_ALLOW_SECRETS=1 git commit ...
#   The scan still runs and still prints its findings; the token drops only this
#   check, while --no-verify would drop every hook (the commit-msg guard too).
# Portable POSIX sh -- same behaviour on macOS and in the Linux lanes.
set -eu

cd "$(git rev-parse --show-toplevel)"

# gitleaks on PATH first; nix as the fallback runner. Neither -> refuse.
if command -v gitleaks >/dev/null 2>&1; then
  set -- gitleaks
elif command -v nix >/dev/null 2>&1; then
  set -- nix run nixpkgs#gitleaks --
else
  {
    echo "pre-commit: no gitleaks and no nix on PATH, so the staged changes"
    echo "  cannot be scanned for secrets. Refusing the commit."
    echo "  On this Mac gitleaks ships from nix-config (modules/git.nix);"
    echo "  deploy it with: pinned upgrade"
    echo "  Anywhere else: install gitleaks, or put nix on PATH and this hook"
    echo "  runs 'nix run nixpkgs#gitleaks' by itself."
  } >&2
  exit 1
fi

out="$(mktemp "${TMPDIR:-/tmp}/gitleaks-pre-commit.XXXXXX")"
trap 'rm -f "$out"' EXIT
rc=0
"$@" git --pre-commit --staged --redact --no-banner --no-color -v . \
  > "$out" 2>&1 || rc=$?

# 0 clean (stay quiet), 1 findings, anything else a broken scan.
if [ "$rc" = 0 ]; then
  exit 0
fi
if [ "$rc" != 1 ]; then
  {
    echo "pre-commit: gitleaks exited $rc, so the staged changes are UNSCANNED."
    echo "  Refusing the commit."
    sed 's/^./  &/' "$out"   # indent, but leave blank lines blank
    echo "  Fix the scanner (or the .gitleaks.toml it reads) and commit again."
    echo "  COMMIT_ALLOW_SECRETS=1 does not cover a broken scan."
  } >&2
  exit 1
fi
if [ "${COMMIT_ALLOW_SECRETS:-}" = 1 ]; then
  {
    echo "pre-commit: secret findings allowed (COMMIT_ALLOW_SECRETS=1):"
    sed 's/^./  &/' "$out"   # indent, but leave blank lines blank
  } >&2
  exit 0
fi
{
  echo "pre-commit: gitleaks found a secret in the staged changes."
  sed 's/^./  &/' "$out"   # indent, but leave blank lines blank
  echo "  Nothing was committed; the staged content is untouched."
  echo "  Remove the secret (rotate it if it was ever real), stage again,"
  echo "  and commit."
  echo "  A fixture that must carry a secret-shaped string: allowlist it in"
  echo "  .gitleaks.toml at the repo root."
  echo "  If the finding really belongs here: COMMIT_ALLOW_SECRETS=1 git commit ..."
} >&2
exit 1
